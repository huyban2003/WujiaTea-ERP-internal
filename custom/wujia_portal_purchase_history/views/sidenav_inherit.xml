<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- F5a — mục sidebar của màn do CHÍNH module sở hữu route khai; khung
         (wujia_portal_layout) chỉ giữ tiêu đề nhóm làm neo. Gỡ module này ⇒ mục biến mất. -->
    <template id="layout_sidenav_history"
              inherit_id="wujia_portal_layout.layout_sidenav"
              priority="30"
              name="Wujia Sidenav — Lịch sử đặt hàng">
        <xpath expr="//li[@id='nav_header_utils']" position="before">
            <li t-attf-class="nav-item #{_p.startswith('/portal/purchase-history') and 'active' or ''}" id="nav_item_history">
                <t t-call="wujia_portal_layout.wj_nav_item">
                    <t t-set="ni_href" t-value="'/portal/purchase-history'"/>
                    <t t-set="ni_icon" t-value="'feather icon-clock'"/>
                    <t t-set="ni_label">Lịch sử đặt hàng</t>
                </t>
            </li>
        </xpath>
    </template>

</odoo>
