#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/wizard/transfer_wizard.py
#, python-format
msgid "%(n)s Python/JavaScript strings wait for .po export."
msgstr "%(n)s chuỗi Python/JavaScript chờ xuất .po."

#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/models/i18n_value.py
#, python-format
msgid "%(n)s skipped (code strings need .po export + restart, or nothing edited)."
msgstr ""
"Bỏ qua %(n)s dòng (chuỗi trong code cần xuất .po + khởi động lại, hoặc chưa "
"sửa gì)."

#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/models/i18n_value.py
#, python-format
msgid "%(n)s translation(s) applied."
msgstr "Đã áp dụng %(n)s bản dịch."

#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/wizard/transfer_wizard.py
#, python-format
msgid ""
"%(rows)s rows: %(by_ref)s matched by reference, %(by_src)s by source text, "
"%(unmatched)s not found. %(updated)s translations changed, %(unchanged)s "
"already identical, %(kept)s existing ones kept."
msgstr ""
"%(rows)s dòng: %(by_ref)s khớp theo tham chiếu, %(by_src)s khớp theo câu "
"nguồn, %(unmatched)s không tìm thấy. %(updated)s bản dịch thay đổi, "
"%(unchanged)s đã giống sẵn, %(kept)s bản đã có được giữ nguyên."

#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/wizard/scan_wizard.py
#, python-format
msgid ""
"%(terms)s terms found (%(new_terms)s new, %(archived)s no longer found). "
"%(new_values)s translations added, %(updated_values)s refreshed from "
"modules. %(seconds)ss."
msgstr ""
"Tìm thấy %(terms)s chuỗi (%(new_terms)s mới, %(archived)s không còn). Thêm "
"%(new_values)s bản dịch, cập nhật %(updated_values)s bản theo module. "
"%(seconds)s giây."

#. module: wujia_i18n
msgid "Active"
msgstr "Kích hoạt (Active)"

#. module: wujia_i18n
msgid "Apply"
msgstr "Áp dụng"

#. module: wujia_i18n
msgid "Apply all waiting"
msgstr "Áp dụng tất cả bản chờ"

#. module: wujia_i18n
msgid ""
"Apply labels, menus and views immediately. Python/JavaScript strings need "
".po export + restart."
msgstr ""
"Áp ngay nhãn, menu và giao diện. Chuỗi Python/JavaScript cần xuất .po + khởi"
" động lại."

#. module: wujia_i18n
msgid "Apply now"
msgstr "Áp dụng ngay"

#. module: wujia_i18n
msgid ""
"Archived when the term is no longer found by a scan (source text changed or "
"removed)."
msgstr "Tự lưu trữ khi lần quét không còn thấy chuỗi (câu gốc đã đổi hoặc bị xoá)."

#. module: wujia_i18n
msgid ""
"By default, translations edited in this tool are kept when the file has a "
"different value."
msgstr ""
"Mặc định, bản dịch đã sửa trong công cụ này được giữ nguyên khi file có giá "
"trị khác."

#. module: wujia_i18n
msgid "CSV file"
msgstr "File CSV"

#. module: wujia_i18n
msgid "CSV glossary (key,option,VN,CN,TH)"
msgstr "Bảng thuật ngữ CSV (key,option,VN,CN,TH)"

#. module: wujia_i18n
msgid ""
"CSV with columns key,option,VN,CN,TH (the option column may be missing). "
"Rows are matched by reference, otherwise by source text. Identical "
"translations are skipped."
msgstr ""
"CSV gồm các cột key,option,VN,CN,TH (có thể thiếu cột option). Dòng được "
"khớp theo tham chiếu, không có thì theo câu nguồn. Bản dịch giống hệt được "
"bỏ qua."

#. module: wujia_i18n
msgid "Cancel"
msgstr "Hủy"

#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/models/i18n_transfer.py
#, python-format
msgid "Cannot read the CSV file: %s"
msgstr "Không đọc được file CSV: %s"

#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/wizard/transfer_wizard.py
msgid "Choose a CSV file."
msgstr "Hãy chọn một file CSV."

#. module: wujia_i18n
#. odoo-python
#: code:addons/wujia_i18n/wizard/scan_wizard.py
#: code:addons/wujia_i18n/wizard/transfer_wizard.py
msgid "Choose at least one module and one language."
msgstr "Chọn ít nhất một module và một ngôn ngữ."

#. module: wujia_i18n
msgid ""
"Code string: the edit takes effect after exporting the .po file and "
"restarting the server."
msgstr ""
"Chuỗi trong code: bản sửa có hiệu lực sau khi xuất file .po và khởi động lại"
" server."

