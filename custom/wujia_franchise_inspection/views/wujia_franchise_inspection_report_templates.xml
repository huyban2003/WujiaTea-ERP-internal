<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template Printable PDF Report (Fully Internationalized) -->
    <template id="report_inspection_document">
        <t t-set="doc_store_name"
            t-value="docs[0].franchise_id.name if (docs and docs[0].franchise_id) else ''" />
        <t t-set="doc_plan_date"
            t-value="docs[0].planned_date.strftime('%d-%m-%Y') if (docs and docs[0].planned_date) else ''" />
        <t t-set="title"
            t-value="'Franchise Inspection Report [%s] [%s]' % (doc_store_name, doc_plan_date)" />
        <t t-call="web.html_container">
            <script type="text/javascript">
                (function() {
                    var title = "Franchise Inspection Report [<t t-esc="doc_store_name" />] [<t t-esc="doc_plan_date" />]";
                    document.title = title;
                    try {
                        if (window.parent &amp;&amp; window.parent.document) {
                            window.parent.document.title = title;
                        }
                    } catch(e) {}
                })();
            </script>
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
            <link
                href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,500;0,700;0,900;1,400;1,700&amp;family=Noto+Sans+Vietnamese:wght@400;500;600;700;800&amp;display=swap"
                rel="stylesheet" />
            <link rel="stylesheet"
                href="/wujia_franchise/static/src/css/inspection_report.css?v=1787990418" />
            <script type="text/javascript"
                src="/wujia_franchise/static/src/js/inspection_report.js?v=1787990418"></script>
            <t t-foreach="docs" t-as="doc">
                <t t-set="selected_lang"
                    t-value="(request and request.params and request.params.get('lang')) or doc.env.context.get('lang') or 'vi_VN'" />
                <t t-set="t" t-value="doc.get_report_translations(selected_lang)" />
                <script id="reportTransJson" type="application/json">
                    <t t-out="json.dumps({'vi_VN': doc.get_report_translations('vi_VN'), 'zh_CN': doc.get_report_translations('zh_CN'), 'th_TH': doc.get_report_translations('th_TH')})" />
                </script>
                <div class="report-article article">
                    <!-- Top Action Bar (hidden on print) -->
                    <div class="report-action-bar no-print" style="margin-bottom: 18px; padding: 10px 16px; background: #eff6ff; border-radius: 8px; border: 1px solid #bfdbfe; display: flex; justify-content: space-between; align-items: center; gap: 14px;">
                        <div style="flex: 1; min-width: 0;">
                            <div class="action-bar-title" style="color: #1e40af; font-size: 14px; font-weight: 700; display: flex; align-items: center; gap: 6px;">
                                <i class="fa fa-file-pdf"></i>
                                <span data-i18n="label:wujia.franchise.inspection_report:bar_title"><t t-out="t.get('label:wujia.franchise.inspection_report:bar_title', 'Preview Franchise Inspection Report')" /></span>
                            </div>
                            <div class="action-bar-sub" style="font-size: 11.5px; color: #475569; margin-top: 2px;">
                                <span data-i18n="label:wujia.franchise.inspection_report:bar_sub"><t t-out="t.get('label:wujia.franchise.inspection_report:bar_sub', 'Click print button below to save PDF file or print directly.')" /></span>
                            </div>
                        </div>
                        <div style="display: flex; align-items: center; gap: 8px; flex-shrink: 0;">
                            <div class="lang-selector-box" style="display: inline-flex; align-items: center; gap: 4px; background: #ffffff; padding: 0 6px 0 8px; border-radius: 6px; border: 1px solid #cbd5e1; box-shadow: 0 1px 2px rgba(0,0,0,0.05); height: 32px; box-sizing: border-box;">
                                <i class="fa fa-globe" style="color: #2563eb; font-size: 13px;"></i>
                                <span style="font-size: 12px; font-weight: 600; color: #475569; white-space: nowrap;" data-i18n="label:wujia.franchise.inspection_report:label_select_lang">
                                    <t t-out="t.get('label:wujia.franchise.inspection_report:label_select_lang', 'Ngôn ngữ in:')" />
                                </span>
                                <select id="selReportLang" style="border: none; background: transparent; font-size: 12px; font-weight: 600; color: #0f172a; cursor: pointer; outline: none; padding: 0; margin: 0;">
                                    <option value="vi_VN" t-att-selected="'selected' if ('vi' in (selected_lang or '').lower() or 'vn' in (selected_lang or '').lower()) else None">🇻🇳 Tiếng Việt</option>
                                    <option value="zh_CN" t-att-selected="'selected' if ('zh' in (selected_lang or '').lower() or 'cn' in (selected_lang or '').lower()) else None">🇨🇳 中文</option>
                                    <option value="th_TH" t-att-selected="'selected' if ('th' in (selected_lang or '').lower()) else None">🇹🇭 ภาษาไทย</option>
                                </select>
                            </div>
                            <button type="button" id="btnPrintReport" class="btn-print-action" style="height: 32px; padding: 0 14px; background: #2563eb; color: #ffffff; border: none; border-radius: 6px; font-weight: 700; cursor: pointer; font-size: 12.5px; display: inline-flex; align-items: center; gap: 6px; box-shadow: 0 1px 3px rgba(37,99,235,0.3); transition: background 0.2s ease; white-space: nowrap;">
                                <i class="fa fa-print"></i>
                                <span data-i18n="label:wujia.franchise.inspection_report:btn_print"><t t-out="t.get('label:wujia.franchise.inspection_report:btn_print', 'Print / Export PDF')" /></span>
                            </button>
                        </div>
                    </div>

                    <!-- Report Header -->
                    <div class="report-header">
                        <div>
                            <h1 class="report-title">
                                <span data-i18n="label:wujia.franchise.inspection_report:report_title"><t t-out="t.get('label:wujia.franchise.inspection_report:report_title', 'FRANCHISE STORE SUPERVISION INSPECTION REPORT')" /></span>
                            </h1>
                            <div class="store-name-sub">
                                <t t-esc="doc.franchise_id.name" /> (<t
                                    t-esc="doc.franchise_id.code or '---'" />) </div>
                        </div>
                        <div style="text-align: right;">
                            <div class="report-code-badge">
                                <t t-esc="doc.name" />
                            </div>
                            <div class="report-date-text">
                                <span data-i18n="label:wujia.franchise.inspection_report:label_planned_date"><t t-out="t.get('label:wujia.franchise.inspection_report:label_planned_date', 'Inspection Date:')" /></span>
                                <strong>
                                    <t t-esc="doc.planned_date"
                                        t-options='{"widget": "date", "format": "dd/MM/yyyy"}' />
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- General Info Grid -->
                    <table class="info-grid">
                        <tr>
                            <td class="label-cell">
                                <span data-i18n="label:wujia.franchise.inspection_report:label_store"><t t-out="t.get('label:wujia.franchise.inspection_report:label_store', 'Franchise Store:')" /></span>
                            </td>
                            <td>
                                <strong style="color: #0f172a;">
                                    <t t-esc="doc.franchise_id.name" />
                                </strong>
                            </td>
                            <td class="label-cell">
                                <span data-i18n="label:wujia.franchise.inspection_report:label_inspector"><t t-out="t.get('label:wujia.franchise.inspection_report:label_inspector', 'Inspector:')" /></span>
                            </td>
                            <td>
                                <t t-esc="doc.inspector_user_id.name" />
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell">
                                <span data-i18n="label:wujia.franchise.inspection_report:label_address"><t t-out="t.get('label:wujia.franchise.inspection_report:label_address', 'Address:')" /></span>
                            </td>
                            <td>
                                <t t-esc="doc.franchise_id.address or '---'" />
                            </td>
                            <td class="label-cell">
                                <span data-i18n="label:wujia.franchise.inspection_report:label_store_rep"><t t-out="t.get('label:wujia.franchise.inspection_report:label_store_rep', 'Store Representative:')" /></span>
                            </td>
                            <td>
                                <t
                                    t-esc="doc.confirmed_member_id.display_name if doc.confirmed_member_id else '---'" />
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell">
                                <span data-i18n="label:wujia.franchise.inspection_report:label_state"><t t-out="t.get('label:wujia.franchise.inspection_report:label_state', 'Status:')" /></span>
                            </td>
                            <td>
                                <span
                                    t-att-class="'badge-rep-pass' if doc.state == 'done' else 'badge-rep-fail'">
                                    <t t-if="doc.state == 'done'">
                                        <span data-i18n="label:wujia.franchise.inspection_report:state_done"><t t-out="t.get('label:wujia.franchise.inspection_report:state_done', 'Completed')" /></span>
                                    </t>
                                    <t t-elif="doc.state == 'need_remediation'">
                                        <span data-i18n="label:wujia.franchise.inspection_report:state_remediation"><t t-out="t.get('label:wujia.franchise.inspection_report:state_remediation', 'Need Remediation')" /></span>
                                    </t>
                                    <t t-elif="doc.state == 'in_progress'">
                                        <span data-i18n="label:wujia.franchise.inspection_report:state_in_progress"><t t-out="t.get('label:wujia.franchise.inspection_report:state_in_progress', 'In Progress')" /></span>
                                    </t>
                                    <t t-else="">
                                        <span data-i18n="label:wujia.franchise.inspection_report:state_draft"><t t-out="t.get('label:wujia.franchise.inspection_report:state_draft', 'Draft')" /></span>
                                    </t>
                                </span>
                            </td>
                            <td class="label-cell">
                                <span data-i18n="label:wujia.franchise.inspection_report:label_test_employee"><t t-out="t.get('label:wujia.franchise.inspection_report:label_test_employee', 'Tested Employee:')" /></span>
                            </td>
                            <td><t t-esc="doc.test_employee_name or '---'" /><t t-if="doc.tenure"> (<t t-esc="doc.tenure" />)</t></td>
                        </tr>
                    </table>

                    <!-- Summary Score Cards -->
                    <div class="score-container">
                        <div class="score-box">
                            <div class="s-label">
                                <span data-i18n="label:wujia.franchise.inspection_report:card_checklist_score"><t t-out="t.get('label:wujia.franchise.inspection_report:card_checklist_score', 'Checklist Score')" /></span>
                            </div>
                            <div class="s-val"><t t-esc="doc.checklist_score" /> / 95</div>
                        </div>
                        <div class="score-box">
                            <div class="s-label">
                                <span data-i18n="label:wujia.franchise.inspection_report:card_exam_score"><t t-out="t.get('label:wujia.franchise.inspection_report:card_exam_score', 'Staff Exam')" /></span>
                            </div>
                            <div class="s-val"><t t-esc="doc.exam_score" /> / 5</div>
                        </div>
                        <div class="score-box highlight-total">
                            <div class="s-label">
                                <span data-i18n="label:wujia.franchise.inspection_report:card_total_score"><t t-out="t.get('label:wujia.franchise.inspection_report:card_total_score', 'Total Passed Score')" /></span>
                            </div>
                            <div class="s-val"><t t-esc="doc.total_score" /> / 100</div>
                        </div>
                        <div class="score-box">
                            <div class="s-label">
                                <span data-i18n="label:wujia.franchise.inspection_report:card_grade"><t t-out="t.get('label:wujia.franchise.inspection_report:card_grade', 'Grade')" /></span>
                            </div>
                            <div class="s-val s-val-grade">
                                <t t-esc="doc.grade_id.name if doc.grade_id else '---'" />
                            </div>
                        </div>
                    </div>

                    <!-- Section I: Checklist Criteria -->
                    <h3 class="section-heading">
                        <span data-i18n="label:wujia.franchise.inspection_report:sec_checklist_title"><t t-out="t.get('label:wujia.franchise.inspection_report:sec_checklist_title', 'I. Checklist Criteria Evaluation Table')" /></span>
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 5%; text-align: center;" data-i18n="label:wujia.franchise.inspection_report:th_stt">
                                    <t t-out="t.get('label:wujia.franchise.inspection_report:th_stt', 'STT')" />
                                </th>
                                <th style="width: 50%;" data-i18n="label:wujia.franchise.inspection_report:th_content">
                                    <t t-out="t.get('label:wujia.franchise.inspection_report:th_content', 'Criterion Content')" />
                                </th>
                                <th style="width: 12%; text-align: center;" data-i18n="label:wujia.franchise.inspection_report:th_eval">
                                    <t t-out="t.get('label:wujia.franchise.inspection_report:th_eval', 'Evaluation')" />
                                </th>
                                <th style="width: 18%;" data-i18n="label:wujia.franchise.inspection_report:th_note">
                                    <t t-out="t.get('label:wujia.franchise.inspection_report:th_note', 'Violation Notes')" />
                                </th>
                                <th style="width: 15%; text-align: center;" data-i18n="label:wujia.franchise.inspection_report:th_evidence">
                                    <t t-out="t.get('label:wujia.franchise.inspection_report:th_evidence', 'Evidence Photo')" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="seq_idx" t-value="0" />
                            <t t-foreach="doc.line_ids" t-as="l">
                                <t t-if="l.display_type == 'section'">
                                    <tr class="sec-row">
                                        <td colspan="5" style="padding: 8px 12px;">
                                            <i class="fa fa-folder-open text-primary me-1"></i>
                                            <strong style="color: #0f172a;">
                                                <t t-esc="l.content_snapshot or l.name" />
                                            </strong>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-set="seq_idx" t-value="seq_idx + 1" />
                                    <tr
                                        t-attf-class="#{'important-rep-row' if (l.criterion_type_snapshot == 'critical' or (l.deduction_score_snapshot and l.deduction_score_snapshot &gt;= 5.0)) else ''}">
                                        <td style="text-align: center; font-weight: 600;">
                                            <t t-esc="seq_idx" />
                                        </td>
                                        <td>
                                            <t t-esc="l.content_snapshot" />
                                        </td>
                                        <td style="text-align: center; white-space: nowrap;">
                                            <t t-if="l.is_pass">
                                                <span class="badge-rep-pass">✓</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge-rep-fail">✗</span>
                                            </t>
                                        </td>
                                        <td style="font-size: 11px; color: #475569;">
                                            <t t-esc="l.note or '---'" />
                                        </td>
                                        <td style="text-align: center;">
                                            <t t-if="l.evidence_image">
                                                <img class="photo-thumb"
                                                    t-attf-src="/web/image/wujia.franchise.inspection.line/#{l.id}/evidence_image" />
                                            </t>
                                            <t t-else="">
                                                <span style="color: #cbd5e1; font-size: 11px;" data-i18n="label:wujia.franchise.inspection_report:label_no_photo">
                                                    <t t-out="t.get('label:wujia.franchise.inspection_report:label_no_photo', 'None')" />
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Section II: Staff Exam Questions -->
                    <t t-if="doc.exam_line_ids">
                        <h3 class="section-heading">
                            <span data-i18n="label:wujia.franchise.inspection_report:sec_exam_title"><t t-out="t.get('label:wujia.franchise.inspection_report:sec_exam_title', 'II. Staff Knowledge Examination Results')" /></span>
                            (<t t-esc="doc.test_employee_name or 'Staff'" />) </h3>
                        <table class="rep-table">
                            <thead>
                                <tr>
                                    <th style="width: 8%; text-align: center;" data-i18n="label:wujia.franchise.inspection_report:th_exam_code">
                                        <t t-out="t.get('label:wujia.franchise.inspection_report:th_exam_code', 'Code')" />
                                    </th>
                                    <th style="width: 42%;" data-i18n="label:wujia.franchise.inspection_report:th_exam_question">
                                        <t t-out="t.get('label:wujia.franchise.inspection_report:th_exam_question', 'Question')" />
                                    </th>
                                    <th style="width: 35%;" data-i18n="label:wujia.franchise.inspection_report:th_exam_answer">
                                        <t t-out="t.get('label:wujia.franchise.inspection_report:th_exam_answer', 'Employee Answer')" />
                                    </th>
                                    <th style="width: 15%; text-align: center;" data-i18n="label:wujia.franchise.inspection_report:th_exam_score">
                                        <t t-out="t.get('label:wujia.franchise.inspection_report:th_exam_score', 'Earned Points')" />
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.exam_line_ids" t-as="el">
                                    <tr>
                                        <td
                                            style="text-align: center; font-weight: 700; color: #2563eb;">
                                            <t t-esc="el.quest_code_snapshot" />
                                        </td>
                                        <td>
                                            <t t-esc="el.quest_content_snapshot" />
                                        </td>
                                        <td style="color: #334155;">
                                            <t t-esc="el.answer or '---'" />
                                        </td>
                                        <td
                                            style="text-align: center; font-weight: 700; white-space: nowrap;">
                                            <span
                                                t-att-style="'color: #15803d;' if el.is_correct else 'color: #b91c1c;'">
                                                <t t-if="el.is_correct">✓</t><t t-else="">✗</t> <t
                                                    t-esc="el.point" /> / <t
                                                    t-esc="el.quest_id.score if el.quest_id else 1.0" />
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Section III: Attendance &amp; Store Appearance -->
                    <h3 class="section-heading">
                        <span data-i18n="label:wujia.franchise.inspection_report:sec_attendance_title"><t t-out="t.get('label:wujia.franchise.inspection_report:sec_attendance_title', 'III. Employee Attendance &amp; Remediation Notes')" /></span>
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 50%;" data-i18n="label:wujia.franchise.inspection_report:th_issues_header">
                                    <t t-out="t.get('label:wujia.franchise.inspection_report:th_issues_header', 'Store Appearance Issues &amp; Key Remediations This Period')" />
                                </th>
                                <th style="width: 50%;">
                                    <span data-i18n="label:wujia.franchise.inspection_report:th_attendance_header"><t t-out="t.get('label:wujia.franchise.inspection_report:th_attendance_header', 'List of Employees Present at Inspection')" /></span>
                                    (<t t-esc="doc.present_count" /> <span data-i18n="label:wujia.franchise.inspection_report:word_person"><t t-out="t.get('label:wujia.franchise.inspection_report:word_person', 'people')" /></span>)
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="remediation-box">
                                    <div class="remediation-box-label">
                                        <span data-i18n="label:wujia.franchise.inspection_report:label_remediation_content"><t t-out="t.get('label:wujia.franchise.inspection_report:label_remediation_content', 'Remediation Content:')" /></span>
                                    </div>
                                    <div class="remediation-box-content">
                                        <t t-if="doc.store_appearance_issues">
                                            <t t-esc="doc.store_appearance_issues.strip()" />
                                        </t>
                                        <t t-else="">
                                            <span data-i18n="label:wujia.franchise.inspection_report:empty_issues"><t t-out="t.get('label:wujia.franchise.inspection_report:empty_issues', 'No key store appearance issues recorded.')" /></span>
                                        </t>
                                    </div>
                                </td>
                                <td class="attendance-list-cell">
                                    <t t-if="doc.attendance_line_ids">
                                        <ul class="attendance-ul">
                                            <t t-foreach="doc.attendance_line_ids" t-as="att">
                                                <li class="attendance-li">
                                                    <t t-if="att.is_present">
                                                        <strong style="color: #0f172a;">
                                                            <t t-esc="att.employee_name" />
                                                        </strong>
                                                        <span
                                                            style="color: #475569; font-size: 11px;">
                                                            (<t t-if="att.role == 'owner'">
                                                                <span data-i18n="label:wujia.franchise.inspection_report:role_owner"><t t-out="t.get('label:wujia.franchise.inspection_report:role_owner', 'Store Owner')" /></span>
                                                            </t><t
                                                                t-elif="att.role == 'manager'">
                                                                <span data-i18n="label:wujia.franchise.inspection_report:role_manager"><t t-out="t.get('label:wujia.franchise.inspection_report:role_manager', 'Manager')" /></span>
                                                            </t><t
                                                                t-else="">
                                                                <span data-i18n="label:wujia.franchise.inspection_report:role_staff"><t t-out="t.get('label:wujia.franchise.inspection_report:role_staff', 'Staff')" /></span>
                                                            </t>
                                                            ) </span>
                                                        <span
                                                            style="color: #15803d; font-size: 11px; font-weight: 600; margin-left: 4px;" data-i18n="label:wujia.franchise.inspection_report:badge_present">
                                                            <t t-out="t.get('label:wujia.franchise.inspection_report:badge_present', '[Present]')" />
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <s style="color: #94a3b8; font-weight: 500;">
                                                            <t t-esc="att.employee_name" />
                                                        </s>
                                                        <span
                                                            style="color: #94a3b8; font-size: 11px;">
                                                            (<t t-if="att.role == 'owner'">
                                                                <span data-i18n="label:wujia.franchise.inspection_report:role_owner"><t t-out="t.get('label:wujia.franchise.inspection_report:role_owner', 'Store Owner')" /></span>
                                                            </t><t
                                                                t-elif="att.role == 'manager'">
                                                                <span data-i18n="label:wujia.franchise.inspection_report:role_manager"><t t-out="t.get('label:wujia.franchise.inspection_report:role_manager', 'Manager')" /></span>
                                                            </t><t
                                                                t-else="">
                                                                <span data-i18n="label:wujia.franchise.inspection_report:role_staff"><t t-out="t.get('label:wujia.franchise.inspection_report:role_staff', 'Staff')" /></span>
                                                            </t>
                                                            ) </span>
                                                        <span
                                                            style="color: #ef4444; font-size: 11px; font-weight: 600; margin-left: 4px;" data-i18n="label:wujia.franchise.inspection_report:badge_absent">
                                                            <t t-out="t.get('label:wujia.franchise.inspection_report:badge_absent', '[Absent]')" />
                                                        </span>
                                                    </t>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #94a3b8; font-style: italic;" data-i18n="label:wujia.franchise.inspection_report:empty_attendance">
                                            <t t-out="t.get('label:wujia.franchise.inspection_report:empty_attendance', 'No attendance list recorded')" />
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Section IV: 3-Month Revenue Report -->
                    <h3 class="section-heading">
                        <span data-i18n="label:wujia.franchise.inspection_report:sec_revenue_title"><t t-out="t.get('label:wujia.franchise.inspection_report:sec_revenue_title', 'IV. 3 Months Detailed Revenue Report')" /></span>
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 16%; text-align: center; white-space: nowrap;" data-i18n="label:wujia.franchise.inspection_survey:th_month">
                                    <t t-out="t.get('label:wujia.franchise.inspection_survey:th_month', 'Tháng / Năm')" />
                                </th>
                                <th style="width: 18%; text-align: right; white-space: nowrap;" data-i18n="label:wujia.franchise.inspection_survey:th_revenue">
                                    <t t-out="t.get('label:wujia.franchise.inspection_survey:th_revenue', 'Doanh thu')" />
                                </th>
                                <th style="width: 18%; text-align: right; white-space: nowrap;" data-i18n="label:wujia.franchise.inspection_survey:th_revenue_avg">
                                    <t t-out="t.get('label:wujia.franchise.inspection_survey:th_revenue_avg', 'Doanh thu TB ngày')" />
                                </th>
                                <th style="width: 16%; text-align: right; white-space: nowrap;" data-i18n="label:wujia.franchise.inspection_survey:th_percent_goods">
                                    <t t-out="t.get('label:wujia.franchise.inspection_survey:th_percent_goods', 'Tỉ lệ hàng hóa (%)')" />
                                </th>
                                <th style="width: 18%; text-align: right; white-space: nowrap;" data-i18n="label:wujia.franchise.inspection_survey:th_total_app_sale">
                                    <t t-out="t.get('label:wujia.franchise.inspection_survey:th_total_app_sale', 'Tổng đơn hàng Mini App')" />
                                </th>
                                <th style="width: 14%; text-align: right; white-space: nowrap;" data-i18n="label:wujia.franchise.inspection_survey:th_percent_app_sale">
                                    <t t-out="t.get('label:wujia.franchise.inspection_survey:th_percent_app_sale', 'Tỷ lệ đặt app (%)')" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-if="doc.report_line_ids">
                                <t t-foreach="doc.report_line_ids" t-as="rl">
                                    <tr>
                                        <td
                                            style="text-align: center; font-weight: 700; color: #1e293b;">
                                            <t
                                                t-esc="rl.date_month.strftime('%m/%Y') if rl.date_month else '---'" />
                                        </td>
                                        <td style="text-align: right; font-weight: 600;">
                                            <t
                                                t-esc="'{:,.0f}'.format(rl.revenue) if rl.revenue else '0'" />
                                        </td>
                                        <td
                                            style="text-align: right; font-weight: 600; color: #475569;">
                                            <t
                                                t-esc="'{:,.0f}'.format(rl.revenue_avg) if rl.revenue_avg else '0'" />
                                        </td>
                                        <td style="text-align: right; font-weight: 600; color: #0284c7;">
                                            <t t-esc="rl.percent_goods" /> % </td>
                                        <td style="text-align: right; font-weight: 600;">
                                            <t
                                                t-esc="'{:,}'.format(rl.total_app_sale) if rl.total_app_sale else '0'" />
                                        </td>
                                        <td
                                            style="text-align: right; font-weight: 700; color: #2563eb;">
                                            <t t-esc="rl.percent_app_sale" /> % </td>
                                    </tr>
                                </t>
                            </t>
                            <t t-else="">
                                <tr>
                                    <td colspan="6" style="text-align: center; color: #94a3b8; font-style: italic; padding: 14px;" data-i18n="label:wujia.franchise.inspection_survey:empty_revenue">
                                        <t t-out="t.get('label:wujia.franchise.inspection_survey:empty_revenue', 'Chưa có dữ liệu thống kê doanh thu 3 tháng.')" />
                                    </td>
                                </tr>
                            </t>
                        </tbody>
                    </table>

                    <!-- Signatures Block (Never split across pages) -->
                    <div class="sig-block-wrap">
                        <table class="sig-grid">
                            <tr>
                                <td>
                                    <div class="sig-title">
                                        <span data-i18n="label:wujia.franchise.inspection_report:sig_store_rep_title"><t t-out="t.get('label:wujia.franchise.inspection_report:sig_store_rep_title', 'STORE REPRESENTATIVE CONFIRMATION')" /></span>
                                    </div>
                                    <div class="sig-subtitle">
                                        <span data-i18n="label:wujia.franchise.inspection_report:sig_sub_instruction"><t t-out="t.get('label:wujia.franchise.inspection_report:sig_sub_instruction', '(Signature &amp; Full Name)')" /></span>
                                    </div>
                                    <div class="sig-img-box">
                                        <t t-if="doc.signature_image">
                                            <span t-field="doc.signature_image"
                                                t-options='{"widget": "image", "style": "max-height: 70px; max-width: 220px; object-fit: contain;"}' />
                                        </t>
                                    </div>
                                    <div class="sig-name">
                                        <t
                                            t-esc="doc.confirmed_member_id.display_name if doc.confirmed_member_id else '....................................'" />
                                    </div>
                                </td>
                                <td>
                                    <div class="sig-title">
                                        <span data-i18n="label:wujia.franchise.inspection_report:sig_inspector_title"><t t-out="t.get('label:wujia.franchise.inspection_report:sig_inspector_title', 'INSPECTOR / SUPERVISOR')" /></span>
                                    </div>
                                    <div class="sig-subtitle">
                                        <span data-i18n="label:wujia.franchise.inspection_report:sig_sub_instruction"><t t-out="t.get('label:wujia.franchise.inspection_report:sig_sub_instruction', '(Signature &amp; Full Name)')" /></span>
                                    </div>
                                    <div class="sig-img-box">
                                        <t t-if="doc.inspector_signature_image">
                                            <span t-field="doc.inspector_signature_image"
                                                t-options='{"widget": "image", "style": "max-height: 70px; max-width: 220px; object-fit: contain;"}' />
                                        </t>
                                    </div>
                                    <div class="sig-name">
                                        <t
                                            t-esc="doc.inspector_user_id.name if doc.inspector_user_id else '....................................'" />
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Built-in Clean Printable Footer -->
                    <div class="report-print-footer">
                        <div>WujiaTea ERP — <t t-esc="doc.name" /> (<t t-esc="doc.franchise_id.name" />
                            )</div>
                        <div>Inspection Date: <t t-esc="doc.planned_date"
                                t-options='{"widget": "date", "format": "dd/MM/yyyy"}' /></div>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_franchise_inspection" model="ir.actions.report">
        <field name="name">Franchise Inspection Report</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">wujia_franchise.report_inspection_document</field>
        <field name="report_file">wujia_franchise.report_inspection_document</field>
        <field name="print_report_name">(object._get_report_base_filename())</field>
        <field name="binding_model_id" ref="model_wujia_franchise_inspection" />
        <field name="binding_type">report</field>
    </record>
</odoo>