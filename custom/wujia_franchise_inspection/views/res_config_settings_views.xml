<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_wujia_inspection" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.wujia.inspection</field>
        <field name="model">res.config.settings</field>
        <field name="priority" eval="70"/>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Franchise Inspection" string="Khảo Sát Cửa Hàng" name="wujia_franchise_inspection">
                    <block title="Lưu Trữ Video Khảo Sát (Google Drive)" id="wujia_inspection_google_drive_settings">
                        <setting id="wujia_inspection_google_drive_setting"
                            string="Kích hoạt Google Drive Video"
                            help="Tự động tải video minh chứng lên Google Drive (wujia media / [Mã cửa hàng] / ks[YYYYMMDD].mp4) để giảm tải và tiết kiệm dung lượng server.">
                            <field name="wujia_inspection_use_google_drive"/>

                            <div class="content-group mt-3" invisible="not wujia_inspection_use_google_drive">
                                <div class="alert alert-info py-2 mb-3">
                                    <i class="fa fa-info-circle me-1"/>
                                    <strong>Trạng thái: </strong>
                                    <field name="google_drive_status_message" class="d-inline fw-bold text-dark"/>
                                </div>

                                <div class="row mb-2">
                                    <label for="google_drive_credentials_file" string="Tải lên credentials.json:" class="col-lg-4 o_light_label fw-bold"/>
                                    <div class="col-lg-8">
                                        <field name="google_drive_credentials_filename" invisible="1"/>
                                        <field name="google_drive_credentials_file" filename="google_drive_credentials_filename" widget="binary"/>
                                        <div class="text-muted small">File cấu hình OAuth 2.0 Client tải từ Google Cloud Console.</div>
                                    </div>
                                </div>

                                <div class="row mb-2">
                                    <label for="google_drive_token_file" string="Tải lên token.json:" class="col-lg-4 o_light_label fw-bold"/>
                                    <div class="col-lg-8">
                                        <field name="google_drive_token_filename" invisible="1"/>
                                        <field name="google_drive_token_file" filename="google_drive_token_filename" widget="binary"/>
                                        <div class="text-muted small">File lưu trữ Access / Refresh Token đã được cấp quyền truy cập Drive.</div>
                                    </div>
                                </div>

                                <div class="mt-3">
                                    <button name="action_test_google_drive_connection"
                                        type="object"
                                        string="Kiểm Tra Kết Nối Google Drive"
                                        class="btn btn-outline-primary btn-sm"
                                        icon="fa-cloud-upload"/>
                                </div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_wujia_inspection_config_settings" model="ir.actions.act_window">
        <field name="name">Cài Đặt Khảo Sát &amp; Google Drive</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'wujia_franchise_inspection'}</field>
    </record>
</odoo>
