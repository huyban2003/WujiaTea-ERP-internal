<odoo>
	<data>
		<record id="view_wujia_fields_value_form" model="ir.ui.view">
			<field name="name">wujia.fields.value.form</field>
			<field name="model">wujia.fields.value</field>
			<field name="arch" type="xml">
				<form string="View Fields Value">
					<sheet>
						<group>
							<field name="res_id" invisible="1"/>
							<field name="model" invisible="1"/>
							<field name="model_id" invisible="1"/>
							<field name="field_ids" context="{'from_fields_value': True}" widget="many2many_tags"
							       domain="[('model_id', '=', model_id)]"
							       options="{'no_create_edit': True, 'no_quick_create': True}"/>
						</group>
						<field name="field_value_line_ids" class="o_wujia_fields_value_lines">
							<list style="table-layout: fixed; width: 100%;">
								<field name="sequence" string="#" style="width: 50px; text-align: center;"/>
								<field name="field_label" style="width: 30%;"/>
								<field name="field_name" style="width: 30%;"/>
								<field name="field_value" style="width: 36%;"/>
							</list>
							<form>
								<group>
									<group>
										<field name="sequence"/>
										<field name="field_label"/>
									</group>
									<group>
										<field name="field_name"/>
									</group>
								</group>
								<group>
									<field name="field_value"/>
								</group>
							</form>
						</field>
					</sheet>
					<footer/>
				</form>
			</field>
		</record>
		
		<record id="action_wujia_fields_value" model="ir.actions.act_window">
			<field name="name">wujia.fields.value.action</field>
			<field name="res_model">wujia.fields.value</field>
			<field name="view_mode">form</field>
		</record>
	
	</data>
</odoo>
