<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_remediation_main" name="Wujia Portal — Khắc phục">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="title">Khắc phục</t>

            <!-- ================= PC ≥992px ================= -->
            <div class="content-wrapper d-none d-lg-block wj-exam-pc wj-remediation-pc">
                <!-- Page Header -->
                <div class="wj-pc-page-header">
                    <div>
                        <h1 class="wj-pc-page-header__title">Khắc phục</h1>
                        <p class="wj-pc-page-header__crumb">Portal / Giám sát &amp; Đánh giá / Khắc phục</p>
                    </div>
                </div>

                <div class="content-body">
                    <!-- Bộ lọc nhanh -->
                    <form method="get" action="/portal/remediation" class="wj-pc-filterbar">
                        <h2 class="wj-pc-filterbar__title">Bộ lọc nhanh</h2>
                        <div class="wj-pc-filterbar__row">
                            <input type="hidden" name="tab" t-att-value="active_tab" />
                            <span class="wj-pc-filter-search">
                                <i class="feather icon-search" />
                                <input type="text" name="search" t-att-value="search_q"
                                    placeholder="Tìm mã phiếu, cửa hàng..."
                                    class="wj-pc-filter-control" />
                            </span>
                            <input type="date" lang="vi-VN" name="date_from" t-att-value="date_from"
                                class="wj-pc-filter-control wj-pc-fc--date" />
                            <input type="date" lang="vi-VN" name="date_to" t-att-value="date_to"
                                class="wj-pc-filter-control wj-pc-fc--date" />
                            <span class="wj-pc-filterbar__actions">
                                <a t-attf-href="/portal/remediation?tab=#{active_tab}"
                                    class="wj-pc-btn wj-pc-btn--secondary">Đặt lại</a>
                                <button type="submit" class="wj-pc-btn wj-pc-btn--primary">Tìm kiếm</button>
                            </span>
                        </div>
                    </form>

                    <!-- Main Card & Tabs -->
                    <div class="wj-pc-card">
                        <div class="wj-pc-card__head d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="wj-pc-card__title">Danh sách tiêu chí vi phạm</h2>
                                <p class="wj-pc-card__subtitle">Theo dõi và cập nhật báo cáo khắc phục từng tiêu chí khảo sát</p>
                            </div>
                            <!-- PC Tabs -->
                            <div class="d-flex gap-2">
                                <a t-attf-href="/portal/remediation?tab=pending&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                                    t-attf-class="wj-pc-btn #{'wj-pc-btn--primary' if active_tab == 'pending' else 'wj-pc-btn--secondary'}">
                                    <i class="feather icon-alert-circle me-1" />Chờ phản hồi (<t t-out="pending_count" />)
                                </a>
                                <a t-attf-href="/portal/remediation?tab=completed&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                                    t-attf-class="wj-pc-btn #{'wj-pc-btn--primary' if active_tab == 'completed' else 'wj-pc-btn--secondary'}">
                                    <i class="feather icon-check-circle me-1" />Đã phản hồi (<t t-out="completed_count" />)
                                </a>
                            </div>
                        </div>

                        <!-- Tab 1: Chờ phản hồi -->
                        <t t-if="active_tab == 'pending'">
                            <div t-if="not pending_items" class="wj-pc-empty">
                                <div class="wj-pc-empty__icon">
                                    <i class="feather icon-check-circle text-success" />
                                </div>
                                <p class="wj-pc-empty__title">Không có tiêu chí nào cần khắc phục</p>
                                <p class="wj-pc-empty__sub">Tất cả tiêu chuẩn đánh giá cửa hàng đều đạt yêu cầu.</p>
                            </div>

                            <div t-else="" class="p-3">
                                <t t-foreach="pending_items" t-as="item">
                                    <div class="border rounded p-3 mb-3 bg-white shadow-sm">
                                        <!-- Header row -->
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span t-if="item.get('code')" class="wj-pc-badge wj-pc-badge--sent">[<t t-out="item.get('code')" />]</span>
                                                <span class="font-weight-bold text-dark"><t t-out="item.get('category')" /></span>
                                                <span class="wj-pc-badge wj-pc-badge--pending"><i class="feather icon-file-text me-1"/><t t-out="item.get('inspection_code')" /></span>
                                                <span class="wj-pc-badge wj-pc-badge--pending"><i class="feather icon-map-pin me-1"/><t t-out="item.get('franchise_name')" /></span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span t-if="item.get('deduction')" class="wj-pc-badge wj-pc-badge--cancel">-<t t-out="item.get('deduction')" />đ</span>
                                                <span t-if="item.get('require_evidence')" class="wj-pc-badge wj-pc-badge--cancel">Bắt buộc ảnh</span>
                                                <span t-else="" class="wj-pc-badge wj-pc-badge--pending">Không bắt buộc ảnh</span>
                                                <span class="wj-pc-badge wj-pc-badge--transit"><i class="feather icon-clock me-1" />Hạn: <t t-out="item.get('due_date')" /></span>
                                            </div>
                                        </div>

                                        <!-- Nội dung vi phạm Callout Box -->
                                        <div class="p-3 rounded mb-3" style="background-color: var(--wj-pc-bg); border: 1px solid var(--wj-pc-border-soft); border-left: 4px solid var(--wj-pc-yellow);">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-alert-triangle mt-1" style="color: var(--wj-pc-yellow); font-size: 1.1rem;"/>
                                                <div class="w-100">
                                                    <span class="font-weight-bold text-uppercase d-block mb-1" style="font-size: 12px; color: var(--wj-pc-muted); letter-spacing: 0.5px;">Nội dung vi phạm</span>
                                                    <p class="mb-0 font-weight-medium" style="font-size: 14px; line-height: 1.5; color: var(--wj-pc-text);">
                                                        <t t-out="item.get('content') or 'Chưa có nội dung mô tả'" />
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Ghi chú từ Admin (nếu có) -->
                                        <div t-if="item.get('note')" class="p-3 rounded mb-3" style="background-color: var(--wj-pc-red-soft); border: 1px solid var(--wj-pc-border-soft); border-left: 4px solid var(--wj-pc-red);">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-message-square mt-1 text-danger" style="font-size: 1.1rem;"/>
                                                <div>
                                                    <span class="font-weight-bold text-uppercase text-danger d-block mb-1" style="font-size: 12px; letter-spacing: 0.5px;">Ghi chú từ Giám sát viên (Admin)</span>
                                                    <p class="mb-0 text-dark font-weight-medium" style="font-size: 14px;">
                                                        <t t-out="item.get('note')"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Form nhập liệu hiện đại -->
                                        <form action="/portal/remediation/submit_line" method="post" enctype="multipart/form-data" 
                                              class="p-3 rounded border bg-white" 
                                              style="border-color: var(--wj-pc-border-soft) !important;">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="line_id" t-att-value="item.get('id') or item.get('line_id')"/>
                                            
                                            <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom" style="border-color: var(--wj-pc-border-soft) !important;">
                                                <i class="feather icon-edit-3 text-primary"/>
                                                <span class="font-weight-bold text-dark text-uppercase" style="font-size: 13px; letter-spacing: 0.5px;">Cập nhật báo cáo khắc phục</span>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-7">
                                                    <label class="font-weight-bold text-dark mb-1 d-block" style="font-size: 13px;">Ghi chú của cửa hàng</label>
                                                    <textarea name="remediation_note" class="wj-pc-control" style="height: 82px; resize: vertical;" placeholder="Nhập ghi chú khắc phục của cửa hàng..."><t t-out="item.get('remediation_note')"/></textarea>
                                                </div>

                                                <div class="col-md-5">
                                                    <label class="font-weight-bold text-dark mb-1 d-block" style="font-size: 13px;">Ảnh minh chứng</label>
                                                    <div class="custom-file-dropzone p-2 rounded text-center position-relative d-flex align-items-center justify-content-center"
                                                         style="background: #f8fafc; border: 2px dashed #cbd5e1; height: 82px; transition: all 0.2s ease; cursor: pointer;"
                                                         t-attf-onclick="document.getElementById('file-input-pending-#{item.get('id')}').click()"
                                                         onmouseover="this.style.borderColor='var(--wj-pc-primary)'; this.style.background='#f0f9ff';"
                                                         onmouseout="this.style.borderColor='#cbd5e1'; this.style.background='#f8fafc';">
                                                        
                                                        <div class="d-flex align-items-center gap-2 text-start">
                                                            <div t-attf-id="file-preview-wrap-pending-#{item.get('id')}" class="d-none me-1">
                                                                <img t-attf-id="file-preview-img-pending-#{item.get('id')}" src="#" alt="Preview" 
                                                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #cbd5e1;"/>
                                                            </div>
                                                            
                                                            <div class="rounded-circle bg-primary-subtle p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px; flex-shrink: 0;">
                                                                <i class="feather icon-camera text-primary" style="font-size: 1.1rem;"/>
                                                            </div>
                                                            <div>
                                                                <span t-attf-id="file-label-pending-#{item.get('id')}" class="d-block font-weight-bold text-dark text-truncate" style="font-size: 12px; max-width: 180px;">
                                                                    Tải ảnh minh chứng...
                                                                </span>
                                                                <span class="d-block text-muted" style="font-size: 11px;">Bấm để chọn file ảnh</span>
                                                            </div>
                                                        </div>

                                                        <input type="file" t-attf-id="file-input-pending-#{item.get('id')}" name="remediation_image" accept="image/*" class="d-none"
                                                               t-attf-onchange="
                                                                   var file = this.files[0];
                                                                   if (file) {
                                                                       var label = document.getElementById('file-label-pending-#{item.get('id')}');
                                                                       var wrap = document.getElementById('file-preview-wrap-pending-#{item.get('id')}');
                                                                       var img = document.getElementById('file-preview-img-pending-#{item.get('id')}');
                                                                       label.innerText = file.name;
                                                                       label.classList.add('text-primary');
                                                                       var reader = new FileReader();
                                                                       reader.onload = function(e) {
                                                                           img.src = e.target.result;
                                                                           wrap.classList.remove('d-none');
                                                                       };
                                                                       reader.readAsDataURL(file);
                                                                   }
                                                               "/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Nút gửi báo cáo nằm bên phải -->
                                            <div class="d-flex justify-content-end align-items-center mt-3 pt-2 border-top" style="border-color: var(--wj-pc-border-soft) !important;">
                                                <button type="submit" class="wj-pc-btn wj-pc-btn--primary px-4">
                                                    <i class="feather icon-send me-1"/>Gửi báo cáo khắc phục
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- Tab 2: Đã phản hồi -->
                        <t t-if="active_tab == 'completed'">
                            <div t-if="not completed_items" class="wj-pc-empty">
                                <div class="wj-pc-empty__icon">
                                    <i class="feather icon-inbox" />
                                </div>
                                <p class="wj-pc-empty__title">Chưa có bản ghi đã phản hồi</p>
                            </div>

                            <div t-else="" class="p-3">
                                <t t-foreach="completed_items" t-as="item">
                                    <div class="border rounded p-3 mb-3 bg-white shadow-sm">
                                        <!-- Header row -->
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span t-if="item.get('code')" class="wj-pc-badge wj-pc-badge--done">[<t t-out="item.get('code')" />]</span>
                                                <span class="font-weight-bold text-dark"><t t-out="item.get('category')" /></span>
                                                <span class="wj-pc-badge wj-pc-badge--pending"><i class="feather icon-file-text me-1"/><t t-out="item.get('inspection_code')" /></span>
                                                <span class="wj-pc-badge wj-pc-badge--pending"><i class="feather icon-map-pin me-1"/><t t-out="item.get('franchise_name')" /></span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="wj-pc-badge wj-pc-badge--done"><i class="feather icon-check-circle me-1" />Đã phản hồi</span>
                                            </div>
                                        </div>

                                        <!-- Nội dung vi phạm Callout Box -->
                                        <div class="p-3 rounded mb-3" style="background-color: var(--wj-pc-bg); border: 1px solid var(--wj-pc-border-soft); border-left: 4px solid var(--wj-pc-muted);">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-file-text mt-1 text-secondary" style="font-size: 1.1rem;"/>
                                                <div class="w-100">
                                                    <span class="font-weight-bold text-uppercase d-block mb-1" style="font-size: 12px; color: var(--wj-pc-muted); letter-spacing: 0.5px;">Nội dung vi phạm ban đầu</span>
                                                    <p class="mb-0 font-weight-medium" style="font-size: 14px; line-height: 1.5; color: var(--wj-pc-text);">
                                                        <t t-out="item.get('content') or 'Chưa có nội dung mô tả'" />
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Ghi chú Admin (nếu có) -->
                                        <div t-if="item.get('note')" class="p-3 rounded mb-3" style="background-color: var(--wj-pc-red-soft); border: 1px solid var(--wj-pc-border-soft); border-left: 4px solid var(--wj-pc-red);">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-message-square mt-1 text-danger" style="font-size: 1.1rem;"/>
                                                <div>
                                                    <span class="font-weight-bold text-uppercase text-danger d-block mb-1" style="font-size: 12px; letter-spacing: 0.5px;">Ghi chú từ Giám sát viên (Admin)</span>
                                                    <p class="mb-0 text-dark font-weight-medium" style="font-size: 14px;">
                                                        <t t-out="item.get('note')"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Form Cập nhật đẹp -->
                                        <form action="/portal/remediation/submit_line" method="post" enctype="multipart/form-data" 
                                              class="p-3 rounded border bg-white" 
                                              style="border-color: var(--wj-pc-border-soft) !important;">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="line_id" t-att-value="item.get('id') or item.get('line_id')"/>
                                            <input type="hidden" name="redirect_tab" value="completed"/>
                                            
                                            <div class="d-flex justify-content-between align-items-center mb-3 pb-2 border-bottom" style="border-color: var(--wj-pc-border-soft) !important;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="feather icon-refresh-cw text-primary"/>
                                                    <span class="font-weight-bold text-dark text-uppercase" style="font-size: 13px; letter-spacing: 0.5px;">Cập nhật phản hồi đã gửi</span>
                                                </div>
                                                <a t-if="item.get('remediation_image_url')" t-att-href="item.get('remediation_image_url')" target="_blank"
                                                    class="wj-pc-btn wj-pc-btn--ghost py-0 px-2 font-weight-medium" style="height: 28px; font-size: 13px;">
                                                    <i class="feather icon-image me-1" />Xem ảnh đã nộp
                                                </a>
                                            </div>

                                            <div class="row g-3">
                                                <div class="col-md-7">
                                                    <label class="font-weight-bold text-dark mb-1 d-block" style="font-size: 13px;">Cập nhật ghi chú</label>
                                                    <textarea name="remediation_note" class="wj-pc-control" style="height: 82px; resize: vertical;" placeholder="Cập nhật ghi chú khắc phục..."><t t-out="item.get('remediation_note')"/></textarea>
                                                </div>

                                                <div class="col-md-5">
                                                    <label class="font-weight-bold text-dark mb-1 d-block" style="font-size: 13px;">Thay đổi ảnh minh chứng</label>
                                                    <div class="custom-file-dropzone p-2 rounded text-center position-relative d-flex align-items-center justify-content-center"
                                                         style="background: #f8fafc; border: 2px dashed #cbd5e1; height: 82px; transition: all 0.2s ease; cursor: pointer;"
                                                         t-attf-onclick="document.getElementById('file-input-comp-#{item.get('id')}').click()"
                                                         onmouseover="this.style.borderColor='var(--wj-pc-primary)'; this.style.background='#f0f9ff';"
                                                         onmouseout="this.style.borderColor='#cbd5e1'; this.style.background='#f8fafc';">
                                                        
                                                        <div class="d-flex align-items-center gap-2 text-start">
                                                            <div t-attf-id="file-preview-wrap-comp-#{item.get('id')}" t-attf-class="#{'d-none' if not item.get('remediation_image_url') else ''} me-1">
                                                                <img t-attf-id="file-preview-img-comp-#{item.get('id')}" t-att-src="item.get('remediation_image_url') or '#'" alt="Preview" 
                                                                     style="width: 50px; height: 50px; object-fit: cover; border-radius: 6px; border: 1px solid #cbd5e1;"/>
                                                            </div>
                                                            
                                                            <div class="rounded-circle bg-primary-subtle p-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px; flex-shrink: 0;">
                                                                <i class="feather icon-camera text-primary" style="font-size: 1.1rem;"/>
                                                            </div>
                                                            <div>
                                                                <span t-attf-id="file-label-comp-#{item.get('id')}" class="d-block font-weight-bold text-dark text-truncate" style="font-size: 12px; max-width: 180px;">
                                                                    <t t-out="'Thay đổi ảnh minh chứng...' if not item.get('remediation_image_url') else 'Bấm để đổi ảnh khác...'"/>
                                                                </span>
                                                                <span class="d-block text-muted" style="font-size: 11px;">Bấm để chọn file ảnh</span>
                                                            </div>
                                                        </div>

                                                        <input type="file" t-attf-id="file-input-comp-#{item.get('id')}" name="remediation_image" accept="image/*" class="d-none"
                                                               t-attf-onchange="
                                                                   var file = this.files[0];
                                                                   if (file) {
                                                                       var label = document.getElementById('file-label-comp-#{item.get('id')}');
                                                                       var wrap = document.getElementById('file-preview-wrap-comp-#{item.get('id')}');
                                                                       var img = document.getElementById('file-preview-img-comp-#{item.get('id')}');
                                                                       label.innerText = file.name;
                                                                       label.classList.add('text-primary');
                                                                       var reader = new FileReader();
                                                                       reader.onload = function(e) {
                                                                           img.src = e.target.result;
                                                                           wrap.classList.remove('d-none');
                                                                       };
                                                                       reader.readAsDataURL(file);
                                                                   }
                                                               "/>
                                                    </div>
                                                </div>
                                            </div>

                                            <!-- Nút cập nhật phản hồi nằm bên phải -->
                                            <div class="d-flex justify-content-end align-items-center mt-3 pt-2 border-top" style="border-color: var(--wj-pc-border-soft) !important;">
                                                <button type="submit" class="wj-pc-btn wj-pc-btn--primary px-4">
                                                    <i class="feather icon-refresh-cw me-1"/>Cập nhật phản hồi
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- ================= Mobile <992px ================= -->
            <div class="d-lg-none wujia-mpage wujia-mexam wujia-mremediation">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'" />
                    <t t-set="ph_variant" t-value="'title'" />
                    <t t-set="ph_title">Khắc phục</t>
                </t>

                <!-- Filter dates compact -->
                <div class="wj-filter-card">
                    <form method="get" action="/portal/remediation" class="wj-filter-dates wj-filter-dates--compact">
                        <input type="hidden" name="tab" t-att-value="active_tab" />
                        <label class="wj-filter-date">
                            <i class="feather icon-calendar" />
                            <input type="date" lang="vi-VN" name="date_from" t-att-value="date_from" />
                        </label>
                        <span class="wj-filter-date-sep">–</span>
                        <label class="wj-filter-date">
                            <i class="feather icon-calendar" />
                            <input type="date" lang="vi-VN" name="date_to" t-att-value="date_to" />
                        </label>
                        <button type="submit" class="wj-filter-search-btn">
                            <i class="feather icon-search" />
                        </button>
                    </form>
                </div>

                <!-- Mobile Tabs -->
                <div class="d-flex gap-2 mb-3">
                    <a t-attf-href="/portal/remediation?tab=pending&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                        t-attf-class="btn btn-sm flex-fill font-weight-bold #{'btn-primary' if active_tab == 'pending' else 'btn-light border'}">
                        Chờ phản hồi (<t t-out="pending_count" />)
                    </a>
                    <a t-attf-href="/portal/remediation?tab=completed&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                        t-attf-class="btn btn-sm flex-fill font-weight-bold #{'btn-primary' if active_tab == 'completed' else 'btn-light border'}">
                        Đã phản hồi (<t t-out="completed_count" />)
                    </a>
                </div>

                <!-- Mobile Tab 1: Chờ phản hồi -->
                <t t-if="active_tab == 'pending'">
                    <div t-if="not pending_items" class="wj-empty-state wj-empty-state--rich">
                        <span class="wj-empty-state-icon" />
                        <p class="wj-empty-state-title">Tuyệt vời! Không có hạng mục cần khắc phục</p>
                    </div>

                    <div t-else="" class="wujia-mexam-list">
                        <t t-foreach="pending_items" t-as="item">
                            <div class="wujia-mexam-card mb-3 p-3 bg-white rounded border shadow-sm">
                                <div class="wujia-mexam-card-top d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="wujia-mexam-card-title font-weight-bold mb-0" style="font-size: 15px;">
                                        <span t-if="item.get('code')" class="text-primary me-1">[<t t-out="item.get('code')" />] </span><t t-out="item.get('category')" />
                                    </h3>
                                    <span t-if="item.get('deduction')" class="wujia-badge wujia-badge-danger">-<t t-out="item.get('deduction')" />đ</span>
                                </div>
                                <p class="wujia-mexam-card-line small text-muted mb-2">
                                    <i class="feather icon-file-text me-1" />
                                    <span>Phiếu: <t t-out="item.get('inspection_code')" /> | <t t-out="item.get('franchise_name')" /></span>
                                </p>

                                <!-- Vi phạm box -->
                                <div class="p-2 rounded mb-2 small" style="background-color: var(--wujia-bg-page); border: 1px solid var(--wujia-border); border-left: 3px solid var(--wujia-warning);">
                                    <strong class="text-dark d-block mb-1">Vi phạm:</strong>
                                    <span class="text-secondary"><t t-out="item.get('content') or 'Chưa có nội dung mô tả'" /></span>
                                </div>

                                <p t-if="item.get('note')" class="p-2 rounded text-danger small mb-2" style="background-color: var(--wujia-danger-bg); border: 1px solid var(--wujia-border);">
                                    <i class="feather icon-alert-circle me-1" />
                                    <span><strong>Ghi chú Admin:</strong> <t t-out="item.get('note')" /></span>
                                </p>
                                <p class="text-danger small font-weight-bold mb-2">
                                    <i class="feather icon-clock me-1" />
                                    <span>Hạn khắc phục: <t t-out="item.get('due_date')" /></span>
                                </p>

                                <form action="/portal/remediation/submit_line" method="post" enctype="multipart/form-data" class="mt-2 pt-2 border-top">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="line_id" t-att-value="item.get('id') or item.get('line_id')"/>
                                    <input type="text" name="remediation_note" class="form-control form-control-sm mb-2" placeholder="Ghi chú khắc phục của cửa hàng..." t-att-value="item.get('remediation_note')"/>
                                    
                                    <!-- Mobile Dropzone Upload -->
                                    <div class="custom-file-dropzone p-2 rounded text-center position-relative mb-2 d-flex align-items-center justify-content-center"
                                         style="background: #f8fafc; border: 2px dashed #cbd5e1; min-height: 64px; cursor: pointer;"
                                         t-attf-onclick="document.getElementById('file-input-m-pending-#{item.get('id')}').click()">
                                        <div class="d-flex align-items-center gap-2 text-start">
                                            <div t-attf-id="file-preview-wrap-m-pending-#{item.get('id')}" class="d-none me-1">
                                                <img t-attf-id="file-preview-img-m-pending-#{item.get('id')}" src="#" alt="Preview" 
                                                     style="width: 44px; height: 44px; object-fit: cover; border-radius: 6px; border: 1px solid #cbd5e1;"/>
                                            </div>
                                            <i class="feather icon-camera text-primary" style="font-size: 1.2rem;"/>
                                            <div>
                                                <span t-attf-id="file-label-m-pending-#{item.get('id')}" class="d-block font-weight-bold text-dark text-truncate" style="font-size: 12px; max-width: 200px;">
                                                    Chọn ảnh minh chứng...
                                                </span>
                                                <span class="d-block text-muted" style="font-size: 10px;">Chạm để chọn ảnh</span>
                                            </div>
                                        </div>
                                        <input type="file" t-attf-id="file-input-m-pending-#{item.get('id')}" name="remediation_image" accept="image/*" class="d-none"
                                               t-attf-onchange="
                                                   var file = this.files[0];
                                                   if (file) {
                                                       var label = document.getElementById('file-label-m-pending-#{item.get('id')}');
                                                       var wrap = document.getElementById('file-preview-wrap-m-pending-#{item.get('id')}');
                                                       var img = document.getElementById('file-preview-img-m-pending-#{item.get('id')}');
                                                       label.innerText = file.name;
                                                       label.classList.add('text-primary');
                                                       var reader = new FileReader();
                                                       reader.onload = function(e) {
                                                           img.src = e.target.result;
                                                           wrap.classList.remove('d-none');
                                                       };
                                                       reader.readAsDataURL(file);
                                                   }
                                               "/>
                                    </div>

                                    <button type="submit" class="btn btn-primary btn-block font-weight-bold">
                                        <i class="feather icon-send me-1"/>Gửi báo cáo khắc phục
                                    </button>
                                </form>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Mobile Tab 2: Đã phản hồi -->
                <t t-if="active_tab == 'completed'">
                    <div t-if="not completed_items" class="wj-empty-state wj-empty-state--rich">
                        <span class="wj-empty-state-icon" />
                        <p class="wj-empty-state-title">Chưa có bản ghi đã phản hồi</p>
                    </div>

                    <div t-else="" class="wujia-mexam-list">
                        <t t-foreach="completed_items" t-as="item">
                            <div class="wujia-mexam-card mb-3 p-3 bg-white rounded border shadow-sm">
                                <div class="wujia-mexam-card-top d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="wujia-mexam-card-title font-weight-bold mb-0" style="font-size: 15px;">
                                        <span t-if="item.get('code')" class="text-success me-1">[<t t-out="item.get('code')" />] </span><t t-out="item.get('category')" />
                                    </h3>
                                    <span class="wujia-badge wujia-badge-success d-inline-flex align-items-center gap-1">
                                        <i class="feather icon-check-circle"/> Đã hoàn thành
                                    </span>
                                </div>
                                <p class="wujia-mexam-card-line small text-muted mb-2">
                                    <i class="feather icon-file-text me-1" />
                                    <span>Phiếu: <t t-out="item.get('inspection_code')" /> | <t t-out="item.get('franchise_name')" /></span>
                                </p>
                                <div class="p-2 rounded mb-2 small" style="background-color: var(--wujia-bg-page); border: 1px solid var(--wujia-border); border-left: 3px solid var(--wujia-text-muted);">
                                    <span class="text-secondary"><strong class="text-dark">Vi phạm:</strong> <t t-out="item.get('content') or 'N/A'" /></span>
                                </div>
                                <p t-if="item.get('note')" class="p-2 rounded text-danger small mb-2" style="background-color: var(--wujia-danger-bg); border: 1px solid var(--wujia-border);">
                                    <i class="feather icon-alert-circle me-1" />
                                    <span>Ghi chú Admin: <t t-out="item.get('note')" /></span>
                                </p>
                                
                                <!-- Mobile Status Finished Block -->
                                <div class="pt-2 border-top">
                                    <div class="d-flex align-items-center justify-content-between p-2 rounded" style="background-color: #f0fdf4; border: 1px solid #bbf7d0;">
                                        <span class="text-success font-weight-bold small d-flex align-items-center gap-1">
                                            <i class="feather icon-check-circle" style="font-size: 1.1rem;"/> Đã hoàn thành khắc phục
                                        </span>
                                        <a t-if="item.get('remediation_image_url')" t-att-href="item.get('remediation_image_url')" target="_blank"
                                            class="btn btn-xs btn-outline-success font-weight-bold" style="font-size: 11px; padding: 2px 8px;">
                                            <i class="feather icon-image me-1" />Xem ảnh
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>