<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_remediation_main" name="Wujia Portal — Khắc phục">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="title">Khắc phục</t>

            <!-- ================= PC ≥992px ================= -->
            <div class="content-wrapper d-none d-lg-block wj-exam-pc wj-remediation-pc">
                <!-- Page Header -->
                <div class="wj-pc-page-header">
                    <div>
                        <h1 class="wj-pc-page-header__title">Khắc phục</h1>
                        <p class="wj-pc-page-header__crumb">Portal / Giám sát &amp; Đánh giá / Khắc phục</p>
                    </div>
                </div>

                <div class="content-body">
                    <!-- Bộ lọc nhanh -->
                    <form method="get" action="/portal/remediation" class="wj-pc-filterbar">
                        <h2 class="wj-pc-filterbar__title">Bộ lọc nhanh</h2>
                        <div class="wj-pc-filterbar__row">
                            <input type="hidden" name="tab" t-att-value="active_tab" />
                            <span class="wj-pc-filter-search">
                                <i class="feather icon-search" />
                                <input type="text" name="search" t-att-value="search_q"
                                    placeholder="Tìm mã phiếu, cửa hàng..."
                                    class="wj-pc-filter-control" />
                            </span>
                            <input type="date" lang="vi-VN" name="date_from" t-att-value="date_from"
                                class="wj-pc-filter-control wj-pc-fc--date" />
                            <input type="date" lang="vi-VN" name="date_to" t-att-value="date_to"
                                class="wj-pc-filter-control wj-pc-fc--date" />
                            <span class="wj-pc-filterbar__actions">
                                <a t-attf-href="/portal/remediation?tab=#{active_tab}"
                                    class="wj-pc-btn wj-pc-btn--secondary">Đặt lại</a>
                                <button type="submit" class="wj-pc-btn wj-pc-btn--primary">Tìm kiếm</button>
                            </span>
                        </div>
                    </form>

                    <!-- Main Card & Tabs -->
                    <div class="wj-pc-card">
                        <div class="wj-pc-card__head d-flex justify-content-between align-items-center">
                            <div>
                                <h2 class="wj-pc-card__title">Danh sách tiêu chí vi phạm</h2>
                                <p class="wj-pc-card__subtitle">Theo dõi và cập nhật báo cáo khắc phục từng tiêu chí khảo sát</p>
                            </div>
                            <!-- PC Tabs -->
                            <div class="d-flex gap-2">
                                <a t-attf-href="/portal/remediation?tab=pending&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                                    t-attf-class="wj-pc-btn #{'wj-pc-btn--primary' if active_tab == 'pending' else 'wj-pc-btn--secondary'}">
                                    <i class="feather icon-alert-circle me-1" />Chờ phản hồi (<t t-out="pending_count" />)
                                </a>
                                <a t-attf-href="/portal/remediation?tab=completed&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                                    t-attf-class="wj-pc-btn #{'wj-pc-btn--primary' if active_tab == 'completed' else 'wj-pc-btn--secondary'}">
                                    <i class="feather icon-check-circle me-1" />Đã phản hồi (<t t-out="completed_count" />)
                                </a>
                            </div>
                        </div>

                        <!-- Tab 1: Chờ phản hồi -->
                        <t t-if="active_tab == 'pending'">
                            <div t-if="not pending_items" class="wj-pc-empty">
                                <div class="wj-pc-empty__icon">
                                    <i class="feather icon-check-circle text-success" />
                                </div>
                                <p class="wj-pc-empty__title">Không có tiêu chí nào cần khắc phục</p>
                                <p class="wj-pc-empty__sub">Tất cả tiêu chuẩn đánh giá cửa hàng đều đạt yêu cầu.</p>
                            </div>

                            <div t-else="" class="p-3">
                                <t t-foreach="pending_items" t-as="item">
                                    <div class="border rounded-3 p-3.5 mb-4 bg-white shadow-sm">
                                        <!-- Header row -->
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2.5 border-bottom">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span t-if="item.get('code')" class="badge bg-primary-subtle text-primary border border-primary-subtle fw-bold px-2 py-1 fs-7">[<t t-out="item.get('code')" />]</span>
                                                <span class="fw-bold text-dark fs-6"><t t-out="item.get('category')" /></span>
                                                <span class="badge bg-light text-secondary border fw-normal"><i class="feather icon-file-text me-1 text-muted"/><t t-out="item.get('inspection_code')" /></span>
                                                <span class="badge bg-light text-secondary border fw-normal"><i class="feather icon-map-pin me-1 text-muted"/><t t-out="item.get('franchise_name')" /></span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span t-if="item.get('deduction')" class="badge bg-danger-subtle text-danger border border-danger-subtle fw-bold px-2.5 py-1.5 fs-6">-<t t-out="item.get('deduction')" />đ</span>
                                                <span t-if="item.get('require_evidence')" class="badge bg-danger-subtle text-danger border border-danger-subtle">Bắt buộc ảnh</span>
                                                <span t-else="" class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Không bắt buộc ảnh</span>
                                                <span class="badge bg-warning-subtle text-warning-emphasis border border-warning-subtle fw-bold"><i class="feather icon-clock me-1" />Hạn: <t t-out="item.get('due_date')" /></span>
                                            </div>
                                        </div>

                                        <!-- Nội dung vi phạm Callout Box -->
                                        <div class="p-3 rounded-3 mb-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #f59e0b;">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-alert-triangle mt-1 fs-5" style="color: #d97706;"/>
                                                <div class="w-100">
                                                    <span class="fw-bold text-uppercase d-block mb-1" style="font-size: 0.75rem; color: #475569; letter-spacing: 0.5px;">Nội dung vi phạm</span>
                                                    <p class="mb-0 fw-medium" style="font-size: 0.93rem; line-height: 1.5; color: #1e293b;">
                                                        <t t-out="item.get('content') or 'Chưa có nội dung mô tả'" />
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Ghi chú từ Admin (nếu có) -->
                                        <div t-if="item.get('note')" class="p-3 rounded-3 mb-3" style="background-color: #fff1f2; border: 1px solid #fecdd3; border-left: 4px solid #f43f5e;">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-message-square mt-1 fs-5 text-danger"/>
                                                <div>
                                                    <span class="fw-bold text-uppercase text-danger d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Ghi chú từ Giám sát viên (Admin)</span>
                                                    <p class="mb-0 text-dark fw-medium" style="font-size: 0.9rem;">
                                                        <t t-out="item.get('note')"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Form nhập liệu đẹp -->
                                        <form action="/portal/remediation/submit_line" method="post" enctype="multipart/form-data" 
                                              class="p-3 rounded-3 border" 
                                              style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%); border-color: #cbd5e1 !important;">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="line_id" t-att-value="item.get('id') or item.get('line_id')"/>
                                            
                                            <div class="d-flex align-items-center gap-2 mb-2 pb-2 border-bottom" style="border-color: #f1f5f9 !important;">
                                                <i class="feather icon-edit-3 text-primary"/>
                                                <span class="fw-bold text-dark fs-7 text-uppercase tracking-wider">Cập nhật báo cáo khắc phục</span>
                                            </div>

                                            <div class="row g-2 align-items-center">
                                                <div class="col-md-5">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="feather icon-edit-2"/></span>
                                                        <input type="text" name="remediation_note" class="form-control form-control-sm border-start-0 ps-0" placeholder="Nhập ghi chú khắc phục của cửa hàng..." t-att-value="item.get('remediation_note')"/>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="custom-file-upload">
                                                        <label t-attf-for="file-input-pending-#{item.get('id')}" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-2 w-100 bg-white border text-truncate" style="height: 31px; border-style: dashed !important; border-width: 1.5px !important;">
                                                            <i class="feather icon-upload-cloud text-primary"/>
                                                            <span t-attf-id="file-label-pending-#{item.get('id')}" class="text-secondary small font-medium text-truncate">Chọn ảnh minh chứng...</span>
                                                        </label>
                                                        <input type="file" t-attf-id="file-input-pending-#{item.get('id')}" name="remediation_image" accept="image/*" class="d-none" t-attf-onchange="document.getElementById('file-label-pending-#{item.get('id')}').innerText = this.files[0] ? this.files[0].name : 'Chọn ảnh minh chứng...'"/>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 text-end">
                                                    <button type="submit" class="wj-pc-btn wj-pc-btn--primary w-100 py-1.5 fw-bold shadow-2xs d-flex align-items-center justify-content-center gap-1.5" style="border-radius: 6px;">
                                                        <i class="feather icon-send"/>Gửi báo cáo
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </t>

                        <!-- Tab 2: Đã phản hồi -->
                        <t t-if="active_tab == 'completed'">
                            <div t-if="not completed_items" class="wj-pc-empty">
                                <div class="wj-pc-empty__icon">
                                    <i class="feather icon-inbox" />
                                </div>
                                <p class="wj-pc-empty__title">Chưa có bản ghi đã phản hồi</p>
                            </div>

                            <div t-else="" class="p-3">
                                <t t-foreach="completed_items" t-as="item">
                                    <div class="border rounded-3 p-3.5 mb-4 bg-white shadow-sm">
                                        <!-- Header row -->
                                        <div class="d-flex justify-content-between align-items-center mb-3 pb-2.5 border-bottom">
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span t-if="item.get('code')" class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-2 py-1 fs-7">[<t t-out="item.get('code')" />]</span>
                                                <span class="fw-bold text-dark fs-6"><t t-out="item.get('category')" /></span>
                                                <span class="badge bg-light text-secondary border fw-normal"><i class="feather icon-file-text me-1 text-muted"/><t t-out="item.get('inspection_code')" /></span>
                                                <span class="badge bg-light text-secondary border fw-normal"><i class="feather icon-map-pin me-1 text-muted"/><t t-out="item.get('franchise_name')" /></span>
                                            </div>
                                            <div class="d-flex align-items-center gap-2 flex-wrap">
                                                <span class="badge bg-success-subtle text-success border border-success-subtle fw-bold px-2.5 py-1.5 fs-6"><i class="feather icon-check-circle me-1" />Đã phản hồi</span>
                                            </div>
                                        </div>

                                        <!-- Nội dung vi phạm Callout Box -->
                                        <div class="p-3 rounded-3 mb-3" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 4px solid #64748b;">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-file-text mt-1 fs-5 text-secondary"/>
                                                <div class="w-100">
                                                    <span class="fw-bold text-uppercase d-block mb-1" style="font-size: 0.75rem; color: #475569; letter-spacing: 0.5px;">Nội dung vi phạm ban đầu</span>
                                                    <p class="mb-0 fw-medium" style="font-size: 0.93rem; line-height: 1.5; color: #1e293b;">
                                                        <t t-out="item.get('content') or 'Chưa có nội dung mô tả'" />
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Ghi chú Admin (nếu có) -->
                                        <div t-if="item.get('note')" class="p-3 rounded-3 mb-3" style="background-color: #fff1f2; border: 1px solid #fecdd3; border-left: 4px solid #f43f5e;">
                                            <div class="d-flex align-items-start gap-2">
                                                <i class="feather icon-message-square mt-1 fs-5 text-danger"/>
                                                <div>
                                                    <span class="fw-bold text-uppercase text-danger d-block mb-1" style="font-size: 0.75rem; letter-spacing: 0.5px;">Ghi chú từ Giám sát viên (Admin)</span>
                                                    <p class="mb-0 text-dark fw-medium" style="font-size: 0.9rem;">
                                                        <t t-out="item.get('note')"/>
                                                    </p>
                                                </div>
                                            </div>
                                        </div>

                                        <!-- Form Cập nhật đẹp -->
                                        <form action="/portal/remediation/submit_line" method="post" enctype="multipart/form-data" 
                                              class="p-3 rounded-3 border" 
                                              style="background: linear-gradient(180deg, #f8fafc 0%, #ffffff 100%); border-color: #cbd5e1 !important;">
                                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                            <input type="hidden" name="line_id" t-att-value="item.get('id') or item.get('line_id')"/>
                                            <input type="hidden" name="redirect_tab" value="completed"/>
                                            
                                            <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom" style="border-color: #f1f5f9 !important;">
                                                <div class="d-flex align-items-center gap-2">
                                                    <i class="feather icon-refresh-cw text-primary"/>
                                                    <span class="fw-bold text-dark fs-7 text-uppercase tracking-wider">Cập nhật phản hồi đã gửi</span>
                                                </div>
                                                <a t-if="item.get('remediation_image_url')" t-att-href="item.get('remediation_image_url')" target="_blank"
                                                    class="btn btn-xs btn-outline-primary py-0.5 px-2 font-medium" style="font-size: 0.78rem;">
                                                    <i class="feather icon-image me-1" />Xem ảnh đã nộp
                                                </a>
                                            </div>

                                            <div class="row g-2 align-items-center">
                                                <div class="col-md-5">
                                                    <div class="input-group input-group-sm">
                                                        <span class="input-group-text bg-white border-end-0 text-muted"><i class="feather icon-edit-2"/></span>
                                                        <input type="text" name="remediation_note" class="form-control form-control-sm border-start-0 ps-0" placeholder="Cập nhật ghi chú khắc phục..." t-att-value="item.get('remediation_note')"/>
                                                    </div>
                                                </div>
                                                <div class="col-md-4">
                                                    <div class="custom-file-upload">
                                                        <label t-attf-for="file-input-comp-#{item.get('id')}" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-2 w-100 bg-white border text-truncate" style="height: 31px; border-style: dashed !important; border-width: 1.5px !important;">
                                                            <i class="feather icon-upload-cloud text-primary"/>
                                                            <span t-attf-id="file-label-comp-#{item.get('id')}" class="text-secondary small font-medium text-truncate">Thay đổi ảnh minh chứng...</span>
                                                        </label>
                                                        <input type="file" t-attf-id="file-input-comp-#{item.get('id')}" name="remediation_image" accept="image/*" class="d-none" t-attf-onchange="document.getElementById('file-label-comp-#{item.get('id')}').innerText = this.files[0] ? this.files[0].name : 'Thay đổi ảnh minh chứng...'"/>
                                                    </div>
                                                </div>
                                                <div class="col-md-3 text-end">
                                                    <button type="submit" class="wj-pc-btn wj-pc-btn--primary w-100 py-1.5 fw-bold shadow-2xs d-flex align-items-center justify-content-center gap-1.5" style="border-radius: 6px;">
                                                        <i class="feather icon-refresh-cw"/>Cập nhật
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                                </t>
                            </div>
                        </t>
                    </div>
                </div>
            </div>

            <!-- ================= Mobile <992px ================= -->
            <div class="d-lg-none wujia-mpage wujia-mexam wujia-mremediation">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'" />
                    <t t-set="ph_variant" t-value="'title'" />
                    <t t-set="ph_title">Khắc phục</t>
                </t>

                <!-- Filter dates compact -->
                <div class="wj-filter-card">
                    <form method="get" action="/portal/remediation" class="wj-filter-dates wj-filter-dates--compact">
                        <input type="hidden" name="tab" t-att-value="active_tab" />
                        <label class="wj-filter-date">
                            <i class="feather icon-calendar" />
                            <input type="date" lang="vi-VN" name="date_from" t-att-value="date_from" />
                        </label>
                        <span class="wj-filter-date-sep">–</span>
                        <label class="wj-filter-date">
                            <i class="feather icon-calendar" />
                            <input type="date" lang="vi-VN" name="date_to" t-att-value="date_to" />
                        </label>
                        <button type="submit" class="wj-filter-search-btn">
                            <i class="feather icon-search" />
                        </button>
                    </form>
                </div>

                <!-- Mobile Tabs -->
                <div class="d-flex gap-2 mb-3">
                    <a t-attf-href="/portal/remediation?tab=pending&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                        t-attf-class="btn btn-sm flex-fill fw-bold #{'btn-primary' if active_tab == 'pending' else 'btn-light border'}">
                        Chờ phản hồi (<t t-out="pending_count" />)
                    </a>
                    <a t-attf-href="/portal/remediation?tab=completed&amp;date_from=#{date_from}&amp;date_to=#{date_to}&amp;search=#{search_q}"
                        t-attf-class="btn btn-sm flex-fill fw-bold #{'btn-primary' if active_tab == 'completed' else 'btn-light border'}">
                        Đã phản hồi (<t t-out="completed_count" />)
                    </a>
                </div>

                <!-- Mobile Tab 1: Chờ phản hồi -->
                <t t-if="active_tab == 'pending'">
                    <div t-if="not pending_items" class="wj-empty-state wj-empty-state--rich">
                        <span class="wj-empty-state-icon" />
                        <p class="wj-empty-state-title">Tuyệt vời! Không có hạng mục cần khắc phục</p>
                    </div>

                    <div t-else="" class="wujia-mexam-list">
                        <t t-foreach="pending_items" t-as="item">
                            <div class="wujia-mexam-card mb-3 p-3 bg-white rounded-3 border shadow-2xs">
                                <div class="wujia-mexam-card-top d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="wujia-mexam-card-title fs-6 fw-bold mb-0">
                                        <span t-if="item.get('code')" class="text-primary me-1">[<t t-out="item.get('code')" />] </span><t t-out="item.get('category')" />
                                    </h3>
                                    <span t-if="item.get('deduction')" class="badge bg-danger-subtle text-danger fw-bold">-<t t-out="item.get('deduction')" />đ</span>
                                </div>
                                <p class="wujia-mexam-card-line small text-muted mb-2">
                                    <i class="feather icon-file-text me-1" />
                                    <span>Phiếu: <t t-out="item.get('inspection_code')" /> | <t t-out="item.get('franchise_name')" /></span>
                                </p>

                                <!-- Vi phạm box -->
                                <div class="p-2.5 rounded-2 mb-2 small" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 3px solid #f59e0b;">
                                    <strong class="text-dark d-block mb-0.5">Vi phạm:</strong>
                                    <span class="text-secondary"><t t-out="item.get('content') or 'Chưa có nội dung mô tả'" /></span>
                                </div>

                                <p t-if="item.get('note')" class="p-2 rounded-2 text-danger small mb-2" style="background-color: #fff1f2; border: 1px solid #fecdd3;">
                                    <i class="feather icon-alert-circle me-1" />
                                    <span><strong>Ghi chú Admin:</strong> <t t-out="item.get('note')" /></span>
                                </p>
                                <p class="text-danger small fw-bold mb-2">
                                    <i class="feather icon-clock me-1" />
                                    <span>Hạn khắc phục: <t t-out="item.get('due_date')" /></span>
                                </p>

                                <form action="/portal/remediation/submit_line" method="post" enctype="multipart/form-data" class="mt-2 pt-2 border-top">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="line_id" t-att-value="item.get('id') or item.get('line_id')"/>
                                    <input type="text" name="remediation_note" class="form-control form-control-sm mb-2" placeholder="Ghi chú khắc phục của cửa hàng..." t-att-value="item.get('remediation_note')"/>
                                    
                                    <div class="mb-2">
                                        <label t-attf-for="file-input-m-pending-#{item.get('id')}" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1.5 w-100 bg-white border text-truncate" style="border-style: dashed !important;">
                                            <i class="feather icon-upload-cloud text-primary"/>
                                            <span t-attf-id="file-label-m-pending-#{item.get('id')}" class="text-secondary small text-truncate">Chọn ảnh minh chứng...</span>
                                        </label>
                                        <input type="file" t-attf-id="file-input-m-pending-#{item.get('id')}" name="remediation_image" accept="image/*" class="d-none" t-attf-onchange="document.getElementById('file-label-m-pending-#{item.get('id')}').innerText = this.files[0] ? this.files[0].name : 'Chọn ảnh minh chứng...'"/>
                                    </div>

                                    <button type="submit" class="wujia-mexam-btn wujia-mexam-btn-primary w-100 fw-bold">
                                        <i class="feather icon-send me-1"/>Gửi báo cáo khắc phục
                                    </button>
                                </form>
                            </div>
                        </t>
                    </div>
                </t>

                <!-- Mobile Tab 2: Đã phản hồi -->
                <t t-if="active_tab == 'completed'">
                    <div t-if="not completed_items" class="wj-empty-state wj-empty-state--rich">
                        <span class="wj-empty-state-icon" />
                        <p class="wj-empty-state-title">Chưa có bản ghi đã phản hồi</p>
                    </div>

                    <div t-else="" class="wujia-mexam-list">
                        <t t-foreach="completed_items" t-as="item">
                            <div class="wujia-mexam-card mb-3 p-3 bg-white rounded-3 border shadow-2xs">
                                <div class="wujia-mexam-card-top d-flex justify-content-between align-items-start mb-2">
                                    <h3 class="wujia-mexam-card-title fs-6 fw-bold mb-0">
                                        <span t-if="item.get('code')" class="text-success me-1">[<t t-out="item.get('code')" />] </span><t t-out="item.get('category')" />
                                    </h3>
                                    <span class="badge bg-success-subtle text-success border border-success-subtle">Đã phản hồi</span>
                                </div>
                                <p class="wujia-mexam-card-line small text-muted mb-2">
                                    <i class="feather icon-file-text me-1" />
                                    <span>Phiếu: <t t-out="item.get('inspection_code')" /> | <t t-out="item.get('franchise_name')" /></span>
                                </p>
                                <div class="p-2.5 rounded-2 mb-2 small" style="background-color: #f8fafc; border: 1px solid #e2e8f0; border-left: 3px solid #64748b;">
                                    <span class="text-secondary"><strong class="text-dark">Vi phạm:</strong> <t t-out="item.get('content') or 'N/A'" /></span>
                                </div>
                                <p t-if="item.get('note')" class="p-2 rounded-2 text-danger small mb-2" style="background-color: #fff1f2; border: 1px solid #fecdd3;">
                                    <i class="feather icon-alert-circle me-1" />
                                    <span>Ghi chú Admin: <t t-out="item.get('note')" /></span>
                                </p>
                                <form action="/portal/remediation/submit_line" method="post" enctype="multipart/form-data" class="mt-2 pt-2 border-top">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <input type="hidden" name="line_id" t-att-value="item.get('id') or item.get('line_id')"/>
                                    <input type="hidden" name="redirect_tab" value="completed"/>
                                    <input type="text" name="remediation_note" class="form-control form-control-sm mb-2" placeholder="Cập nhật ghi chú khắc phục..." t-att-value="item.get('remediation_note')"/>
                                    
                                    <div class="mb-2">
                                        <label t-attf-for="file-input-m-comp-#{item.get('id')}" class="btn btn-sm btn-outline-secondary d-flex align-items-center justify-content-center gap-1.5 w-100 bg-white border text-truncate" style="border-style: dashed !important;">
                                            <i class="feather icon-upload-cloud text-primary"/>
                                            <span t-attf-id="file-label-m-comp-#{item.get('id')}" class="text-secondary small text-truncate">Thay đổi ảnh minh chứng...</span>
                                        </label>
                                        <input type="file" t-attf-id="file-input-m-comp-#{item.get('id')}" name="remediation_image" accept="image/*" class="d-none" t-attf-onchange="document.getElementById('file-label-m-comp-#{item.get('id')}').innerText = this.files[0] ? this.files[0].name : 'Thay đổi ảnh minh chứng...'"/>
                                    </div>

                                    <div class="d-flex gap-2">
                                        <a t-if="item.get('remediation_image_url')" t-att-href="item.get('remediation_image_url')" target="_blank"
                                            class="btn btn-sm btn-outline-primary flex-fill py-1 fw-medium" style="font-size: 0.75rem;">
                                            <i class="feather icon-image me-1" />Xem ảnh đã nộp
                                        </a>
                                        <button type="submit" class="wujia-mexam-btn wujia-mexam-btn-primary flex-fill fw-bold">
                                            <i class="feather icon-refresh-cw me-1"/>Cập nhật
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </t>
                    </div>
                </t>
            </div>
        </t>
    </template>

</odoo>