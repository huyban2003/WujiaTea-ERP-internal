<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_return_list" name="Wujia Portal — Return List">
        <t t-call="wujia_portal_layout.app_layout">
            <t t-set="title">Yêu cầu đổi trả</t>
            <!-- Câu chữ ở template, key ở controller (pattern C4/WJ-KNW-002). -->
            <t t-set="notice_text" t-value="{
                'no_store': 'Không xác định được cửa hàng hiện tại. Vui lòng chọn lại cửa hàng.',
                'not_found': 'Không tìm thấy yêu cầu hoặc bạn không có quyền truy cập.',
                'bad_filter': 'Bộ lọc không hợp lệ. Vui lòng kiểm tra lại.',
            }.get(notice)"/>
            <t t-call="wujia_portal_base.wj_ajax_list_config">
                <t t-set="wjl_path" t-value="'/portal/return'"/>
                <t t-set="wjl_slots" t-value="'wj-ret-pc,wj-ret-mbody'"/>
            </t>

            <!-- Desktop ≥992px — giữ nguyên, bọc d-none d-lg-block (S20) -->
            <div class="content-wrapper d-none d-lg-block">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'pc'"/>
                    <t t-set="ph_variant" t-value="'create'"/>
                    <t t-set="ph_title">Bù hàng</t>
                    <t t-set="ph_create_url" t-value="'/portal/return/new'"/>
                    <t t-set="ph_can_create" t-value="True"/>
                </t>

                <div t-if="no_franchise" class="alert alert-warning m-3">
                    Bạn chưa được gán vào cửa hàng nào.
                </div>

                <div t-if="notice_text" class="alert alert-warning m-3" t-out="notice_text"/>

                <div t-if="not no_franchise" class="content-body">
                    <!-- Filter -->
                    <div class="card mb-2">
                        <div class="card-body p-2">
                            <form method="get" action="/portal/return" class="row g-2 align-items-center">
                                <div class="col-md-3 col-12">
                                    <label for="wj-ret-state-pc" class="small text-muted mb-1">Trạng thái</label>
                                    <select id="wj-ret-state-pc" name="state" class="form-select form-select-sm">
                                        <option value="" t-out="filter_all_label"/>
                                        <t t-foreach="filter_options" t-as="opt">
                                            <option t-att-value="opt[0]"
                                                    t-att-selected="'selected' if state == opt[0] else None"
                                                    t-out="opt[1]"/>
                                        </t>
                                    </select>
                                </div>
                                <!-- UAT-BH-005: PC trước đây thiếu ô từ khoá dù controller đã nhận `q`. -->
                                <div class="col-md-3 col-12">
                                    <label for="wj-ret-q-pc" class="small text-muted mb-1">Từ khoá</label>
                                    <input id="wj-ret-q-pc" type="text" name="q"
                                           class="form-control form-control-sm"
                                           placeholder="Mã YC / mã đơn / sản phẩm"
                                           t-att-value="q or ''"/>
                                </div>
                                <div class="col-md-2 col-6">
                                    <label for="wj-ret-from-pc" class="small text-muted mb-1">Từ ngày</label>
                                    <input id="wj-ret-from-pc" type="date" name="date_from" class="form-control form-control-sm" t-att-value="date_from"/>
                                </div>
                                <div class="col-md-2 col-6">
                                    <label for="wj-ret-to-pc" class="small text-muted mb-1">Đến ngày</label>
                                    <input id="wj-ret-to-pc" type="date" name="date_to" class="form-control form-control-sm" t-att-value="date_to"/>
                                </div>
                                <div class="col-md-2 col-12 text-end">
                                    <label class="small text-muted mb-1 d-block">&#160;</label>
                                    <button type="submit" class="btn btn-primary btn-sm">
                                        <i class="fa fa-search"/> Lọc
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>

                    <!-- Vùng swap AJAX: bảng + pager (bộ lọc ngoài, JS đồng bộ theo URL). -->
                    <div id="wj-ret-pc">
                    <!-- Table (Sprint 9.13b 2026-05-27: MẪU 02 — wujia-content-card-table) -->
                    <t t-call="wujia_portal_layout.wj_surface_card">
                        <t t-set="sc_density" t-value="'regular'"/>
                        <t t-set="sc_class" t-value="'wujia-content-card'"/>
                    <!-- CMP-CH-001: count cố ý BỎ `t-if` — spec ghi rõ "Count 0 vẫn hiển thị". -->
                    <t t-call="wujia_portal_layout.wj_card_header">
                        <t t-set="ch_title">Danh sách yêu cầu đổi trả</t>
                        <t t-set="ch_level" t-value="4"/>
                        <t t-set="ch_platform" t-value="'pc'"/>
                        <t t-set="ch_icon" t-value="'refresh-cw'"/>
                        <t t-set="ch_meta">
                            <span class="wj-card-header__meta"><t t-out="len(returns)"/> kết quả</span>
                        </t>
                    </t>
                    <div t-if="not returns" class="wujia-empty-state">
                        <i class="feather icon-corner-up-left"/>
                        <p>Chưa có yêu cầu nào. <a href="/portal/return/new">Tạo yêu cầu đầu tiên</a>.</p>
                    </div>
                    <div t-else="" class="table-responsive">
                        <table class="wujia-content-card-table">
                            <thead>
                                <tr>
                                    <th>Mã</th>
                                    <th>Ngày yêu cầu</th>
                                    <th>Cửa hàng</th>
                                    <th>Loại lỗi</th>
                                    <th>Đơn gốc</th>
                                    <th class="text-center">Trạng thái</th>
                                    <th></th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr t-foreach="returns" t-as="rr">
                                    <td><a t-attf-href="/portal/return/#{rr.id}" t-out="rr.name"/></td>
                                    <td t-out="wj_dt(rr.request_date, '%d/%m/%Y %H:%M')"/>
                                    <td t-out="rr.franchise_id.name or '—'"/>
                                    <td t-out="rr.issue_type_id.name or '—'"/>
                                    <td t-out="rr.sale_order_id.name or '—'"/>
                                    <td class="text-center">
                                        <t t-set="lbl" t-value="wj_state_label(rr)"/>
                                        <span t-attf-class="wujia-badge #{lbl[1]}" t-out="lbl[0]"/>
                                        <t t-if="rr.resolution_type == 'compensation'">
                                            <t t-set="clbl" t-value="comp_status_labels.get(rr.compensation_status, ('', 'wujia-badge-muted'))"/>
                                            <span t-if="clbl[0]" t-attf-class="wujia-badge #{clbl[1]} d-block mt-1" t-out="clbl[0]"/>
                                        </t>
                                    </td>
                                    <td class="text-end">
                                        <a t-attf-href="/portal/return/#{rr.id}" class="btn btn-sm btn-outline-primary">
                                            <i class="fa fa-eye"/>
                                        </a>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                    </t>

                    <nav t-if="pager and pager.get('page_count', 0) &gt; 1" class="mt-2">
                        <ul class="pagination wujia-pagination justify-content-center mb-0">
                            <li class="page-item">
                                <a class="page-link"
                                   t-attf-href="/portal/return?page=#{pager['page_previous']['num']}&amp;#{pager.get('querystring','')}">«</a>
                            </li>
                            <li class="page-item active">
                                <span class="page-link">
                                    Trang <t t-out="pager['page']['num']"/> / <t t-out="pager['page_count']"/>
                                </span>
                            </li>
                            <li class="page-item">
                                <a class="page-link"
                                   t-attf-href="/portal/return?page=#{pager['page_next']['num']}&amp;#{pager.get('querystring','')}">»</a>
                            </li>
                        </ul>
                    </nav>
                    </div>
                </div>
            </div>

            <!-- Mobile <992px — Figma 4449:88, BA ListScreen (S20) -->
            <div class="d-lg-none wujia-mpage wujia-mreturn">
                <t t-call="wujia_portal_layout.wj_page_header">
                    <t t-set="ph_platform" t-value="'m'"/>
                    <t t-set="ph_variant" t-value="'create'"/>
                    <t t-set="ph_title">Bù hàng</t>
                    <t t-set="ph_create_url" t-value="'/portal/return/new'"/>
                    <t t-set="ph_can_create" t-value="True"/>
                </t>

                <div t-if="notice_text" class="wj-empty-state wj-empty-state--card">
                    <i class="feather icon-alert-circle"/>
                    <p t-out="notice_text"/>
                </div>

                <div t-if="no_franchise" class="wj-empty-state wj-empty-state--card">
                    <i class="feather icon-alert-circle"/>
                    <p>Bạn chưa được gán vào cửa hàng nào.</p>
                </div>

                <t t-else="">
                    <!-- Filter canonical 02-KeywordDateRange (Figma 4785:660) — q + dates wired sẵn -->
                    <form method="get" action="/portal/return" class="wj-surface-card wj-surface-card--summary wj-surface-card--compact wj-surface-card--padded wj-filter-card">
                        <div class="wj-filter-search">
                            <div class="wj-filter-search-field">
                                <i class="feather icon-search"/>
                                <input type="text" name="q" placeholder="Mã YC / mã đơn / sản phẩm" t-att-value="q or ''"/>
                            </div>
                            <button type="submit" class="wj-filter-search-btn"><i class="feather icon-search"/></button>
                        </div>
                        <!-- UAT-BH-005: mobile trước đây thiếu lọc trạng thái. -->
                        <select name="state" class="wj-filter-select"
                                aria-label="Lọc theo trạng thái"
                                onchange="this.form.submit()">
                            <option value="" t-out="filter_all_label"/>
                            <t t-foreach="filter_options" t-as="opt">
                                <option t-att-value="opt[0]"
                                        t-att-selected="'selected' if state == opt[0] else None"
                                        t-out="opt[1]"/>
                            </t>
                        </select>
                        <div class="wj-filter-dates">
                            <label class="wj-filter-date">
                                <i class="feather icon-calendar"/>
                                <input type="date" name="date_from" t-att-value="date_from or ''"/>
                            </label>
                            <span class="wj-filter-date-sep">–</span>
                            <label class="wj-filter-date">
                                <i class="feather icon-calendar"/>
                                <input type="date" name="date_to" t-att-value="date_to or ''"/>
                            </label>
                        </div>
                    </form>

                    <div id="wj-ret-mbody" class="wj-ajax-slot">
                    <!-- Empty: chưa có YC nào (no-data thật) -->
                    <t t-if="not returns and not q and not state and not date_from and not date_to">
                        <div class="wj-empty-state wj-empty-state--rich">
                            <span class="wj-empty-state-icon"/>
                            <p class="wj-empty-state-title">Không có yêu cầu</p>
                            <p class="wj-empty-state-sub">Cửa hàng chưa gửi yêu cầu đổi trả nào.</p>
                            <p class="wj-empty-state-sub">Yêu cầu mới sẽ xuất hiện tại đây khi được tạo.</p>
                            <a href="/portal/return/new" class="wj-empty-state-btn">
                                <i class="feather icon-plus"/> Tạo yêu cầu mới
                            </a>
                        </div>
                    </t>
                    <t t-else="">
                        <t t-call="wujia_portal_layout.wj_section_header">
                            <t t-set="sh_title">Lịch sử yêu cầu</t>
                            <t t-set="sh_level" t-value="3"/>
                            <t t-set="sh_platform" t-value="'m'"/>
                            <t t-set="sh_meta">
                                <span class="wj-section-header__meta"><t t-out="len(returns)"/> yêu cầu</span>
                            </t>
                        </t>

                        <!-- Empty: tìm không ra (lọc rỗng → Xóa lọc) -->
                        <div t-if="not returns" class="wj-empty-state wj-empty-state--rich">
                            <span class="wj-empty-state-icon"/>
                            <p class="wj-empty-state-title">Không tìm thấy kết quả</p>
                            <p class="wj-empty-state-sub">Không có yêu cầu khớp bộ lọc hiện tại.</p>
                            <p class="wj-empty-state-sub">Thử đổi từ khóa hoặc xóa điều kiện tìm kiếm.</p>
                            <a href="/portal/return" class="wj-empty-state-btn">Xóa lọc</a>
                        </div>

                        <!-- Danh sách yêu cầu (ReturnCard) -->
                        <div t-else="" class="wujia-mreturn-list">
                            <a t-foreach="returns" t-as="rr" t-attf-href="/portal/return/#{rr.id}"
                               class="wujia-mreturn-row">
                                <span class="wujia-mreturn-row-body">
                                    <span class="wujia-mreturn-row-head">
                                        <span class="wujia-mreturn-row-code" t-out="rr.name"/>
                                        <span class="wujia-mreturn-row-badges">
                                            <t t-if="rr.resolution_type == 'compensation'">
                                                <t t-set="clbl" t-value="comp_status_labels.get(rr.compensation_status, ('', 'wujia-badge-muted'))"/>
                                                <span t-if="clbl[0]" t-attf-class="wujia-badge #{clbl[1]}" t-out="clbl[0]"/>
                                            </t>
                                            <t t-set="lbl" t-value="wj_state_label(rr)"/>
                                            <span t-attf-class="wujia-badge #{lbl[1]}" t-out="lbl[0]"/>
                                        </span>
                                    </span>
                                    <span class="wujia-mreturn-row-product"
                                          t-out="rr.product_id.display_name or rr.issue_type_id.name or '—'"/>
                                    <span class="wujia-mreturn-row-divider"/>
                                    <span class="wujia-mreturn-row-meta">
                                        <span class="wujia-mreturn-row-metacell">
                                            <span class="lbl">Đơn gốc</span>
                                            <span class="val" t-out="rr.sale_order_id.name or '—'"/>
                                        </span>
                                        <span class="wujia-mreturn-row-metacell">
                                            <span class="lbl">Ngày YC</span>
                                            <span class="val"
                                                  t-out="wj_dt(rr.request_date, '%d/%m') or '—'"/>
                                        </span>
                                    </span>
                                </span>
                                <i class="feather icon-chevron-right wujia-mreturn-row-chevron"/>
                            </a>
                        </div>

                        <nav t-if="pager and pager.get('page_count', 0) &gt; 1" class="wujia-mhist-pager">
                            <a t-attf-href="/portal/return?page=#{pager['page_previous']['num']}&amp;#{pager.get('querystring','')}">«</a>
                            <span>Trang <t t-out="pager['page']['num']"/> / <t t-out="pager['page_count']"/></span>
                            <a t-attf-href="/portal/return?page=#{pager['page_next']['num']}&amp;#{pager.get('querystring','')}">»</a>
                        </nav>
                    </t>
                    </div>
                </t>
            </div>
            <!-- /mobile -->
        </t>
    </template>

</odoo>
