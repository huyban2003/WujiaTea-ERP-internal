#. module: wujia_portal_order_window
#: model:ir.model.fields,help:wujia_portal_order_window.field_res_config_settings__portal_order_time_to
msgid ""
"Default end hour (float 0.0–24.0). If To < From the window runs past "
"midnight."
msgstr "Giờ kết thúc mặc định (float 0.0–24.0). Nếu To < From thì khung giờ chạy qua nửa đêm."

#. module: wujia_portal_order_window
#: model:ir.model.fields,help:wujia_portal_order_window.field_res_config_settings__portal_order_time_from
msgid ""
"Default start hour (float 0.0–24.0) used when the area has no window of its "
"own."
msgstr "Giờ bắt đầu mặc định (float 0.0–24.0) khi khu vực chưa có khung giờ riêng."

#. module: wujia_portal_order_window
#: model_terms:ir.ui.view,arch_db:wujia_portal_order_window.res_config_settings_view_form_wujia_portal_window
msgid ""
"Default time window <em>applies only to areas without their own "
"configuration</em>. Configure it per area under <strong>Sales → "
"Configuration → Wujia Portal → Ordering time windows</strong>. If To &lt; "
"From, the window runs past midnight."
msgstr ""

