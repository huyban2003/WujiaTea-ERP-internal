<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_wujia_inspection_category" model="ir.sequence">
            <field name="name">Franchise Inspection Category Code</field>
            <field name="code">wujia.franchise.inspection.category</field>
            <field name="prefix">CAT-</field>
            <field name="padding">4</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_wujia_franchise_inspection" model="ir.sequence">
            <field name="name">Franchise Inspection Code</field>
            <field name="code">wujia.franchise.inspection</field>
            <field name="prefix">INS-</field>
            <field name="padding">5</field>
            <field name="number_next">1</field>
            <field name="number_increment">1</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>
