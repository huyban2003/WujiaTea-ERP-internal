<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="module_category_wujia" model="ir.module.category">
        <field name="name">Wujia</field>
        <field name="description">Wujia ERP customizations</field>
        <field name="sequence">20</field>
    </record>

    <record id="res_groups_privilege_franchise" model="res.groups.privilege">
        <field name="name">Wujia Franchise</field>
        <field name="category_id" ref="module_category_wujia"/>
        <field name="sequence">10</field>
    </record>

    <record id="group_franchise_user" model="res.groups">
        <field name="name">User</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_franchise"/>
        <field name="comment">View store and membership data.</field>
    </record>

    <record id="group_franchise_manager" model="res.groups">
        <field name="name">Administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_franchise"/>
        <field name="implied_ids" eval="[(4, ref('group_franchise_user'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Manage stores, create/delete memberships.</field>
    </record>

    <!-- Supervision Privilege & Groups -->
    <record id="res_groups_privilege_supervision" model="res.groups.privilege">
        <field name="name">Supervision</field>
        <field name="category_id" ref="module_category_wujia"/>
        <field name="sequence">15</field>
    </record>

    <record id="group_supervision_inspector" model="res.groups">
        <field name="name">Inspector</field>
        <field name="sequence">10</field>
        <field name="privilege_id" ref="res_groups_privilege_supervision"/>
        <field name="comment">Can create schedules and inspection sheets, and sees only their own. Can view but not modify templates, categories and template criterion lines. Can manage the question bank.</field>
    </record>

    <record id="group_supervision_admin" model="res.groups">
        <field name="name">Supervision administrator</field>
        <field name="sequence">20</field>
        <field name="privilege_id" ref="res_groups_privilege_supervision"/>
        <field name="implied_ids" eval="[(4, ref('group_supervision_inspector'))]"/>
        <field name="user_ids" eval="[(4, ref('base.user_admin'))]"/>
        <field name="comment">Supervision administrator - has every right.</field>
    </record>

</odoo>
