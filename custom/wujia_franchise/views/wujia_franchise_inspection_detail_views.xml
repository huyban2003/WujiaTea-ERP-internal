<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- FORM VIEW FOR INSPECTION DETAIL -->
    <record id="view_wujia_franchise_inspection_form" model="ir.ui.view">
        <field name="name">Phiếu giám sát - Form</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Bắt đầu" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_complete" type="object" string="Hoàn thành" invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Phê duyệt" invisible="state != 'submitted'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="code" readonly="1"/> - <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="franchise_id" string="Cửa hàng nhượng quyền"/>
                            <field name="inspector_user_id" string="Người giám sát"/>
                            <field name="template_id" string="Mẫu phiếu giám sát"/>
                            <field name="planned_date" string="Ngày lập kế hoạch"/>
                            <field name="started_at" string="Thời điểm bắt đầu"/>
                            <field name="submitted_at" string="Thời điểm nộp"/>
                        </group>
                        <group>
                            <field name="previous_inspection_id" string="Lần giám sát trước"/>
                            <field name="next_due_date" string="Hạn giám sát tiếp theo"/>
                            <field name="test_employee_name" string="Tên nhân viên làm bài test"/>
                            <field name="tenure" string="Thâm niên nhân viên (tháng)"/>
                            <field name="manual_revenue_snapshot" string="Doanh thu thực tế"/>
                            <field name="confirmed_user_id" string="Người xác nhận"/>
                            <field name="member_id" string="Thành viên"/>
                            <field name="confirmed_at" string="Thời điểm xác nhận"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Tiêu chí">
                            <group string="Vệ sinh" col="1">
                                <field name="line_vesinh_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="criterion_code_snapshot" string="Mã tiêu chí" readonly="1"/>
                                        <field name="content_snapshot" string="Nội dung tiêu chí" readonly="1"/>
                                        <field name="criterion_type_snapshot" string="Loại tiêu chí" readonly="1"/>
                                        <field name="deduction_score_snapshot" string="Điểm trừ mặc định" readonly="1"/>
                                        <field name="previous_result" string="Kết quả lần trước"/>
                                        <field name="previous_deduction_score" string="Điểm trừ lần trước"/>
                                        <field name="result" string="Kết quả"/>
                                        <field name="deduction_score_actual" string="Điểm trừ thực tế"/>
                                        <field name="note" string="Ghi chú"/>
                                        <field name="evidence_attachment_ids" widget="many2many_binary" string="Bằng chứng vi phạm"/>
                                        <field name="correction_state" string="Trạng thái khắc phục"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Thái độ" col="1">
                                <field name="line_thaido_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="criterion_code_snapshot" string="Mã tiêu chí" readonly="1"/>
                                        <field name="content_snapshot" string="Nội dung tiêu chí" readonly="1"/>
                                        <field name="criterion_type_snapshot" string="Loại tiêu chí" readonly="1"/>
                                        <field name="deduction_score_snapshot" string="Điểm trừ mặc định" readonly="1"/>
                                        <field name="previous_result" string="Kết quả lần trước"/>
                                        <field name="previous_deduction_score" string="Điểm trừ lần trước"/>
                                        <field name="result" string="Kết quả"/>
                                        <field name="deduction_score_actual" string="Điểm trừ thực tế"/>
                                        <field name="note" string="Ghi chú"/>
                                        <field name="evidence_attachment_ids" widget="many2many_binary" string="Bằng chứng vi phạm"/>
                                        <field name="correction_state" string="Trạng thái khắc phục"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Giữ gìn trang thiết bị" col="1">
                                <field name="line_thietbi_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="criterion_code_snapshot" string="Mã tiêu chí" readonly="1"/>
                                        <field name="content_snapshot" string="Nội dung tiêu chí" readonly="1"/>
                                        <field name="criterion_type_snapshot" string="Loại tiêu chí" readonly="1"/>
                                        <field name="deduction_score_snapshot" string="Điểm trừ mặc định" readonly="1"/>
                                        <field name="previous_result" string="Kết quả lần trước"/>
                                        <field name="previous_deduction_score" string="Điểm trừ lần trước"/>
                                        <field name="result" string="Kết quả"/>
                                        <field name="deduction_score_actual" string="Điểm trừ thực tế"/>
                                        <field name="note" string="Ghi chú"/>
                                        <field name="evidence_attachment_ids" widget="many2many_binary" string="Bằng chứng vi phạm"/>
                                        <field name="correction_state" string="Trạng thái khắc phục"/>
                                    </list>
                                </field>
                            </group>
                            <group string="Khác" col="1">
                                <field name="line_khac_ids" nolabel="1">
                                    <list editable="bottom" create="0" delete="0">
                                        <field name="criterion_code_snapshot" string="Mã tiêu chí" readonly="1"/>
                                        <field name="category_snapshot" string="Danh mục" readonly="1"/>
                                        <field name="content_snapshot" string="Nội dung tiêu chí" readonly="1"/>
                                        <field name="criterion_type_snapshot" string="Loại tiêu chí" readonly="1"/>
                                        <field name="deduction_score_snapshot" string="Điểm trừ mặc định" readonly="1"/>
                                        <field name="previous_result" string="Kết quả lần trước"/>
                                        <field name="previous_deduction_score" string="Điểm trừ lần trước"/>
                                        <field name="result" string="Kết quả"/>
                                        <field name="deduction_score_actual" string="Điểm trừ thực tế"/>
                                        <field name="note" string="Ghi chú"/>
                                        <field name="evidence_attachment_ids" widget="many2many_binary" string="Bằng chứng vi phạm"/>
                                        <field name="correction_state" string="Trạng thái khắc phục"/>
                                    </list>
                                </field>
                            </group>
                            <group>
                                <field name="checklist_score" string="Điểm checklist"/>
                            </group>
                        </page>

                        <page string="Danh sách câu hỏi">
                            <field name="exam_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_code_snapshot" string="Mã câu hỏi"/>
                                    <field name="question_text_snapshot" string="Nội dung câu hỏi"/>
                                    <field name="correct_answer_snapshot" string="Đáp án đúng"/>
                                    <field name="employee_answer" string="Đáp án của nhân viên"/>
                                    <field name="is_correct" string="Đúng"/>
                                    <field name="point" string="Điểm số"/>
                                </list>
                            </field>
                            <group>
                                <field name="exam_score" string="Điểm bài thi"/>
                            </group>
                        </page>

                        <page string="Xác nhận của nhân viên">
                            <group>
                                <group>
                                    <field name="total_score" string="Tổng điểm"/>
                                    <field name="grade" string="Xếp loại"/>
                                </group>
                            </group>
                        </page>

                        <page string="Kết quả">
                            <field name="notes" placeholder="Ghi chú bổ sung..."/>
                        </page>
                    </notebook>
                </sheet>

            </form>
        </field>
    </record>

</odoo>
