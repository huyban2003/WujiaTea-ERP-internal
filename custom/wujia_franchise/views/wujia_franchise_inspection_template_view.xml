<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Danh sách -->
    <record id="view_wujia_franchise_inspection_template_list" model="ir.ui.view">
        <field name="name">Mẫu phiếu giám sát - Danh sách</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
                <field name="version"/>
                <field name="state"/>
                <field name="effective_date"/>
                <field name="checklist_max_score"/>
                <field name="exam_max_score"/>
                <field name="total_max_score"/>
            </list>
        </field>
    </record>

    <!-- Form -->
    <record id="view_wujia_franchise_inspection_template_form" model="ir.ui.view">
        <field name="name">Mẫu phiếu giám sát - Biểu mẫu</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <form string="Mẫu phiếu giám sát">

                <sheet>

                    <group string="Thông tin chung">
                        <group>
                            <field name="name"/>
                            <field name="code"/>
                            <field name="version"/>
                        </group>

                        <group>
                            <field name="state"/>
                            <field name="effective_date"/>
                        </group>
                    </group>

                    <group string="Thông tin điểm số">
                        <group>
                            <field name="checklist_max_score"/>
                            <field name="exam_max_score"/>
                            <field name="total_max_score" readonly="1"/>
                        </group>
                    </group>

                    <notebook>

                        <page string="Danh sách tiêu chí">

                            <field name="line_ids">

                                <list editable="bottom">

                                    <field name="sequence" widget="handle"/>

                                    <!-- KHÔNG hiển thị template_id -->

                                    <field name="criterion_code"/>

                                    <field name="category_id"/>

                                    <field name="content"/>

                                    <field name="criterion_type"/>

                                    <field name="deduction_score"/>

                                    <field name="require_note_if_fail"/>

                                    <field name="require_evidence_if_fail"/>

                                    <field name="active"/>

                                </list>

                            </field>

                        </page>

                    </notebook>

                </sheet>

                <chatter/>

            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_inspection_template" model="ir.actions.act_window">
        <field name="name">Mẫu phiếu giám sát</field>
        <field name="res_model">wujia.franchise.inspection.template</field>
        <field name="view_mode">list,form</field>
    </record>

</odoo>