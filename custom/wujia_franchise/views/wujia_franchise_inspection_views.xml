<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- INSPECTION -->
    <record id="view_wujia_franchise_inspection_tree" model="ir.ui.view">
        <field name="name">Phiếu giám sát - Danh sách</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="code" string="Mã phiếu"/>
                <field name="name" string="Tên phiếu"/>
                <field name="franchise_id" string="Cửa hàng"/>
                <field name="inspector_user_id" string="Người giám sát"/>
                <field name="planned_date" string="Ngày lập kế hoạch"/>
                <field name="state" string="Trạng thái"/>
                <field name="checklist_score" string="Điểm checklist"/>
                <field name="exam_score" string="Điểm thi"/>
                <field name="total_score" string="Tổng điểm"/>
                <field name="grade" string="Xếp loại"/>
            </list>
        </field>
    </record>


    <record id="action_inspection" model="ir.actions.act_window">
        <field name="name">Phiếu giám sát</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phiếu giám sát đầu tiên
            </p>
        </field>
    </record>

    <!-- ACTION IDS REFERENCED IN MENU -->
    <record id="action_checklist" model="ir.actions.act_window">
        <field name="name">Phiếu giám sát</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'in_progress'])]</field>
    </record>

    <record id="action_score" model="ir.actions.act_window">
        <field name="name">Kết quả giám sát</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['submitted', 'approved'])]</field>
    </record>

</odoo>
