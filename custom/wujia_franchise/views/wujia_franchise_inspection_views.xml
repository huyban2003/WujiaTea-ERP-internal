<?xml version="1.0" encoding="utf-8"?>
<odoo>


    <!-- INSPECTION QUESTIONS -->
    <record id="view_wujia_franchise_inspection_question_tree" model="ir.ui.view">
        <field name="name">Thư viện câu hỏi kiểm tra - Danh sách</field>
        <field name="model">wujia.franchise.inspection.question</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="question_text"/>
                <field name="correct_answer"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_inspection_question_form" model="ir.ui.view">
        <field name="name">Thư viện câu hỏi kiểm tra - Form</field>
        <field name="model">wujia.franchise.inspection.question</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <field name="question_text" placeholder="Nội dung câu hỏi"/>
                    <field name="correct_answer" placeholder="Đáp án đúng"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inspection_question" model="ir.actions.act_window">
        <field name="name">Thư viện câu hỏi kiểm tra</field>
        <field name="res_model">wujia.franchise.inspection.question</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo câu hỏi đầu tiên
            </p>
        </field>
    </record>


   


    <!-- ========================================== -->
    <!-- INSPECTION TEMPLATE LINE (TIÊU CHÍ MẪU)    -->
    <!-- ========================================== -->

    <!-- Danh sách tiêu chí -->
    <record id="view_wujia_franchise_inspection_template_line_list" model="ir.ui.view">
        <field name="name">Thư viện tiêu chí kiểm tra - Danh sách</field>
        <field name="model">wujia.franchise.inspection.template.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="template_id" string="Mẫu phiếu"/>
                <field name="criterion_code" string="Mã tiêu chí"/>
                <field name="category_code" string="Mã danh mục"/>
                <field name="category_id" string="Danh mục"/>
                <field name="content" string="Nội dung tiêu chí"/>
                <field name="criterion_type" string="Loại tiêu chí" widget="badge"
                       decoration-danger="criterion_type == 'critical'"
                       decoration-info="criterion_type == 'normal'"/>
                <field name="deduction_score" string="Điểm trừ"/>
                <field name="require_note_if_fail" string="Bắt buộc ghi chú"/>
                <field name="require_evidence_if_fail" string="Bắt buộc hình/video"/>
                <field name="active" string="Hoạt động"/>
            </list>
        </field>
    </record>

    <!-- Biểu mẫu tiêu chí -->
    <record id="view_wujia_franchise_inspection_template_line_form" model="ir.ui.view">
        <field name="name">Thư viện tiêu chí kiểm tra - Biểu mẫu</field>
        <field name="model">wujia.franchise.inspection.template.line</field>
        <field name="arch" type="xml">
            <form string="Tiêu chí kiểm tra">
                <sheet>
                    <group string="Thông tin tiêu chí">
                        <group>
                            <field name="template_id" options="{'no_create': True}" string="Mẫu phiếu giám sát"/>
                            <field name="criterion_code" placeholder="Ví dụ: TC01"/>
                            <field name="category_code" placeholder="Mã danh mục (ví dụ: CAT-0001)"/>
                            <field name="category_id" options="{'no_create': True}" placeholder="Ví dụ: Vệ sinh quầy kệ"/>
                        </group>
                        <group>
                            <field name="criterion_type" string="Loại tiêu chí"/>
                            <field name="sequence"/>
                            <field name="active" string="Hoạt động"/>
                        </group>
                    </group>
                    <group string="Yêu cầu đánh giá &amp; Điểm số">
                        <field name="content" string="Nội dung tiêu chí" placeholder="Nhập nội dung mô tả chi tiết tiêu chí..."/>
                        <group>
                            <field name="deduction_score" string="Điểm trừ vi phạm"/>
                            <field name="require_note_if_fail" string="Yêu cầu ghi chú khi vi phạm (Fail)"/>
                            <field name="require_evidence_if_fail" string="Yêu cầu hình ảnh/video khi vi phạm (Fail)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tìm kiếm tiêu chí -->
    <record id="view_wujia_franchise_inspection_template_line_search" model="ir.ui.view">
        <field name="name">Thư viện tiêu chí kiểm tra - Tìm kiếm</field>
        <field name="model">wujia.franchise.inspection.template.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="criterion_code" string="Mã tiêu chí"/>
                <field name="category_code" string="Mã danh mục"/>
                <field name="category_id" string="Danh mục"/>
                <field name="content" string="Nội dung"/>
                <field name="template_id" string="Mẫu phiếu"/>
                <separator/>
                <filter string="Tiêu chí nghiêm trọng (Critical)" name="type_critical" domain="[('criterion_type', '=', 'critical')]"/>
                <filter string="Tiêu chí thông thường (Normal)" name="type_normal" domain="[('criterion_type', '=', 'normal')]"/>
                <filter string="Không hoạt động" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Mẫu phiếu" name="group_by_template" context="{'group_by': 'template_id'}"/>
                <filter string="Danh mục" name="group_by_category" context="{'group_by': 'category_id'}"/>
                <filter string="Loại tiêu chí" name="group_by_type" context="{'group_by': 'criterion_type'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_inspection_template_line" model="ir.actions.act_window">
        <field name="name">Thư viện tiêu chí kiểm tra</field>
        <field name="res_model">wujia.franchise.inspection.template.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_template_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo tiêu chí giám sát mới
            </p>
            <p>
                Tiêu chí kiểm tra chi tiết được cấu hình trong từng mẫu phiếu giám sát.
            </p>
        </field>
    </record>


    <!-- INSPECTION -->
    <record id="view_wujia_franchise_inspection_tree" model="ir.ui.view">
        <field name="name">Phiếu giám sát - Danh sách</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="franchise_id"/>
                <field name="inspector_user_id"/>
                <field name="planned_date"/>
                <field name="state"/>
                <field name="checklist_score"/>
                <field name="exam_score"/>
                <field name="total_score"/>
                <field name="grade"/>
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_inspection_form" model="ir.ui.view">
        <field name="name">Phiếu giám sát - Form</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="arch" type="xml">
            <form>
                <header>
                    <button name="action_start" type="object" string="Start" invisible="state != 'draft'" class="oe_highlight"/>
                    <button name="action_complete" type="object" string="Complete" invisible="state != 'in_progress'" class="oe_highlight"/>
                    <button name="action_approve" type="object" string="Approve" invisible="state != 'submitted'" class="oe_highlight"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,in_progress,submitted,approved"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" readonly="1"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="franchise_id"/>
                            <field name="inspector_user_id"/>
                            <field name="template_id"/>
                            <field name="planned_date"/>
                            <field name="started_at"/>
                            <field name="submitted_at"/>
                        </group>
                        <group>
                            <field name="previous_inspection_id"/>
                            <field name="next_due_date"/>
                            <field name="test_employee_name"/>
                            <field name="tenure"/>
                            <field name="manual_revenue_snapshot"/>
                            <field name="confirmed_user_id"/>
                            <field name="member_id"/>
                            <field name="confirmed_at"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Kết quả checklist">
                            <field name="line_ids">
                                <list editable="bottom">
                                    <field name="criterion_code_snapshot"/>
                                    <field name="category_snapshot"/>
                                    <field name="content_snapshot"/>
                                    <field name="criterion_type_snapshot"/>
                                    <field name="deduction_score_snapshot"/>
                                    <field name="result"/>
                                    <field name="deduction_score_actual"/>
                                    <field name="note"/>
                                    <field name="correction_state"/>
                                </list>
                            </field>
                            <group>
                                <field name="checklist_score"/>
                            </group>
                        </page>

                        <page string="Kết quả bài thi">
                            <field name="exam_line_ids">
                                <list editable="bottom">
                                    <field name="sequence" widget="handle"/>
                                    <field name="question_code_snapshot"/>
                                    <field name="question_text_snapshot"/>
                                    <field name="correct_answer_snapshot"/>
                                    <field name="employee_answer"/>
                                    <field name="is_correct"/>
                                    <field name="point"/>
                                </list>
                            </field>
                            <group>
                                <field name="exam_score"/>
                            </group>
                        </page>

                        <page string="Tổng hợp">
                            <group>
                                <group>
                                    <field name="total_score"/>
                                    <field name="grade"/>
                                </group>
                            </group>
                        </page>

                        <page string="Ghi chú">
                            <field name="notes" placeholder="Additional notes..."/>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_ids"/>
                    <field name="activity_ids"/>
                </div>
            </form>
        </field>
    </record>

    <record id="action_inspection" model="ir.actions.act_window">
        <field name="name">Phiếu giám sát</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo phiếu giám sát đầu tiên
            </p>
        </field>
    </record>

    <!-- ACTION IDS REFERENCED IN MENU -->
    <record id="action_checklist" model="ir.actions.act_window">
        <field name="name">Phiếu giám sát</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['draft', 'in_progress'])]</field>
    </record>

    <record id="action_score" model="ir.actions.act_window">
        <field name="name">Kết quả giám sát</field>
        <field name="res_model">wujia.franchise.inspection</field>
        <field name="view_mode">list,form</field>
        <field name="domain">[('state', 'in', ['submitted', 'approved'])]</field>
    </record>

</odoo>
