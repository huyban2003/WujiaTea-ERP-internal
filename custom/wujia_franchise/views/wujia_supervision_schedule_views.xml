<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- 1. LIST / TREE VIEW -->
    <record id="view_wujia_supervision_schedule_tree" model="ir.ui.view">
        <field name="name">wujia.supervision.schedule.tree</field>
        <field name="model">wujia.supervision.schedule</field>
        <field name="arch" type="xml">
            <list string="label:wujia.supervision.schedule:list_title">
                <field name="name" />
                <field name="store_id" />
                <field name="user_id" />
                <!-- Thay date_start thành date -->
                <field name="date" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-warning="state == 'in_progress'"
                    decoration-success="state == 'done'"
                    decoration-danger="state == 'cancel'" />
            </list>
        </field>
    </record>

    <!-- 2. CALENDAR VIEW -->
    <record id="view_wujia_supervision_schedule_calendar" model="ir.ui.view">
        <field name="name">wujia.supervision.schedule.calendar</field>
        <field name="model">wujia.supervision.schedule</field>
        <field name="arch" type="xml">
            <!-- Dùng date_start="date" (chỉ định trường date làm mốc lịch) -->
            <calendar string="label:wujia.supervision.schedule:calendar_title"
                date_start="date"
                mode="month"
                color="state"
                create="true"
                quick_create="false"
                event_limit="5">
                <field name="name" />
                <field name="store_id" />
                <field name="user_id" avatar_field="avatar_128" />
                <field name="state" filters="1" />
            </calendar>
        </field>
    </record>

    <!-- 3. FORM VIEW -->
    <record id="view_wujia_supervision_schedule_form" model="ir.ui.view">
        <field name="name">wujia.supervision.schedule.form</field>
        <field name="model">wujia.supervision.schedule</field>
        <field name="arch" type="xml">
            <form string="label:wujia.supervision.schedule:form_title">
                <header>
                    <field name="state" widget="statusbar"
                        statusbar_visible="draft,in_progress,done" />
                </header>
                <sheet>
                    <!-- SMART BUTTON HIỂN THỊ SỐ LƯỢNG PHIẾU KHẢO SÁT -->
                    <div class="oe_button_box" name="button_box">
                        <button name="action_view_inspections"
                            type="object"
                            class="oe_stat_button"
                            icon="fa-clipboard">
                            <field name="inspection_count" widget="statinfo" string="label:wujia.supervision.schedule:inspection_sheet" />
                        </button>
                    </div>

                    <div class="oe_title">
                        <label for="name" string="label:wujia.supervision.schedule:job_title" />
                        <h1>
                            <field name="name" readonly="1" force_save="1"
                                placeholder="label:wujia.supervision.schedule:placeholder_name" />
                        </h1>
                    </div>
                    <group>
                        <group string="label:wujia.supervision.schedule:store_information">
                            <field name="user_id" options="{'no_create': True, 'no_open': True}" />
                            <field name="store_id"
                                domain="[('effective_supervision_user_id', '=', user_id)]"
                                options="{'no_create': True, 'no_open': True}" />
                            <!-- cần thêm địa chị, sĐt, định vị cửa hàng -->
                            <group name="store_info" string="label:wujia.supervision.schedule:address_and_phone">
                                <field name="address" readonly="1" />
                                <field name="phone" readonly="1" />
                            </group>
                            <group name="google_map_url" string="label:wujia.supervision.schedule:location">
                                <field name="google_map_url" invisible="1" />
                                <button name="action_open_google_map"
                                    string="label:wujia.supervision.schedule:open_google_maps"
                                    type="object"
                                    icon="fa-map-marker"
                                    class="btn-secondary"
                                    invisible="not google_map_url" />
                            </group>
                        </group>
                        <group string="label:wujia.supervision.schedule:latest_evaluation_time_and_result">
                            <field name="date" string="label:wujia.supervision.schedule:supervision_time" />
                            <field name="latest_total_score"
                                string="label:wujia.supervision.schedule:latest_score"
                                readonly="1" />
                            <field name="latest_grade_id"
                                string="label:wujia.supervision.schedule:latest_grade"
                                widget="badge"
                                readonly="1" />
                        </group>
                    </group>
                    <field name="note" placeholder="label:wujia.supervision.schedule:add_detailed_note" />
                </sheet>
            </form>
        </field>
    </record>

    <!-- 4. SEARCH VIEW -->
    <record id="view_wujia_supervision_schedule_search" model="ir.ui.view">
        <field name="name">wujia.supervision.schedule.search</field>
        <field name="model">wujia.supervision.schedule</field>
        <field name="arch" type="xml">
            <search string="label:wujia.supervision.schedule:search_title">
                <field name="name" />
                <field name="store_id" />
                <field name="user_id" />
                <filter string="label:wujia.supervision.schedule:filter_my_schedule" name="my_schedule" domain="[('user_id', '=', uid)]" />
            </search>
        </field>
    </record>

    <!-- 5. ACTION -->
    <record id="action_wujia_supervision_schedule" model="ir.actions.act_window">
        <field name="name">Lịch giám sát cửa hàng</field>
        <field name="res_model">wujia.supervision.schedule</field>
        <field name="view_mode">calendar,list,form</field>
        <field name="search_view_id" ref="view_wujia_supervision_schedule_search" />
        <field name="context">{'search_default_my_schedule': 1}</field>
    </record>

</odoo>