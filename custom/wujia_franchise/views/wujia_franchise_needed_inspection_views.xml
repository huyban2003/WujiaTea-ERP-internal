<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Action Cửa hàng cần giám sát -->
    <record id="action_franchise_needed_inspection" model="ir.actions.act_window">
        <field name="name">Cửa hàng cần giám sát</field>
        <field name="res_model">wujia.franchise.management</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_franchise_management_search" />
        <field name="context">{
            'search_default_filter_my_inspection': 1,
            'search_default_filter_active': 1,
        }</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Các cửa hàng cần được giám sát định kỳ!
            </p>
        </field>
    </record>

</odoo>