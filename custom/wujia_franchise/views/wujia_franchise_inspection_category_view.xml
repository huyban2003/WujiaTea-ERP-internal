<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_inspection_category_list" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.category.list</field>
        <field name="model">wujia.franchise.inspection.category</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="name"/>
                <field name="sequence"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_inspection_category_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.category.form</field>
        <field name="model">wujia.franchise.inspection.category</field>
        <field name="arch" type="xml">
            <form string="Danh mục tiêu chí">
                <sheet>
                    <group>
                        <field name="code" readonly="1"/>
                        <field name="name"/>
                        <field name="sequence"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inspection_category" model="ir.actions.act_window">
        <field name="name">Danh mục tiêu chí</field>
        <field name="res_model">wujia.franchise.inspection.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p>Quản lý danh mục tiêu chí giám sát cửa hàng.</p>
        </field>
    </record>
</odoo>