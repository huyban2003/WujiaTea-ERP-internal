<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Danh sách tiêu chí -->
    <record id="view_wujia_franchise_inspection_template_line_list" model="ir.ui.view">
        <field name="name">Thư viện tiêu chí kiểm tra - Danh sách</field>
        <field name="model">wujia.franchise.inspection.template.line</field>
        <field name="arch" type="xml">
            <list editable="bottom">
                <field name="sequence" widget="handle"/>
                <field name="template_id" string="Mẫu phiếu"/>
                <field name="criterion_code" string="Mã tiêu chí"/>
                <field name="category" string="Danh mục"/>
                <field name="content" string="Nội dung tiêu chí"/>
                <field name="criterion_type" string="Loại tiêu chí" widget="badge"
                       decoration-danger="criterion_type == 'critical'"
                       decoration-info="criterion_type == 'normal'"/>
                <field name="deduction_score" string="Điểm trừ"/>
                <field name="require_note_if_fail" string="Bắt buộc ghi chú"/>
                <field name="require_evidence_if_fail" string="Bắt buộc hình/video"/>
                <field name="active" string="Hoạt động"/>
            </list>
        </field>
    </record>

    <!-- Biểu mẫu tiêu chí -->
    <record id="view_wujia_franchise_inspection_template_line_form" model="ir.ui.view">
        <field name="name">Thư viện tiêu chí kiểm tra - Biểu mẫu</field>
        <field name="model">wujia.franchise.inspection.template.line</field>
        <field name="arch" type="xml">
            <form string="Tiêu chí kiểm tra">
                <sheet>
                    <group string="Thông tin tiêu chí">
                        <group>
                            <field name="template_id" options="{'no_create': True}" string="Mẫu phiếu giám sát"/>
                            <field name="criterion_code" placeholder="Ví dụ: TC01"/>
                            <field name="category" placeholder="Ví dụ: Vệ sinh quầy kệ"/>
                        </group>
                        <group>
                            <field name="criterion_type" string="Loại tiêu chí"/>
                            <field name="sequence"/>
                            <field name="active" string="Hoạt động"/>
                        </group>
                    </group>
                    <group string="Yêu cầu đánh giá &amp; Điểm số">
                        <field name="content" string="Nội dung tiêu chí" placeholder="Nhập nội dung mô tả chi tiết tiêu chí..."/>
                        <group>
                            <field name="deduction_score" string="Điểm trừ vi phạm"/>
                            <field name="require_note_if_fail" string="Yêu cầu ghi chú khi vi phạm (Fail)"/>
                            <field name="require_evidence_if_fail" string="Yêu cầu hình ảnh/video khi vi phạm (Fail)"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Tìm kiếm tiêu chí -->
    <record id="view_wujia_franchise_inspection_template_line_search" model="ir.ui.view">
        <field name="name">Thư viện tiêu chí kiểm tra - Tìm kiếm</field>
        <field name="model">wujia.franchise.inspection.template.line</field>
        <field name="arch" type="xml">
            <search>
                <field name="criterion_code" string="Mã tiêu chí"/>
                <field name="category" string="Danh mục"/>
                <field name="content" string="Nội dung"/>
                <field name="template_id" string="Mẫu phiếu"/>
                <separator/>
                <filter string="Tiêu chí nghiêm trọng (Critical)" name="type_critical" domain="[('criterion_type', '=', 'critical')]"/>
                <filter string="Tiêu chí thông thường (Normal)" name="type_normal" domain="[('criterion_type', '=', 'normal')]"/>
                <filter string="Không hoạt động" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
                <filter string="Mẫu phiếu" name="group_by_template" context="{'group_by': 'template_id'}"/>
                <filter string="Danh mục" name="group_by_category" context="{'group_by': 'category'}"/>
                <filter string="Loại tiêu chí" name="group_by_type" context="{'group_by': 'criterion_type'}"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_inspection_template_line" model="ir.actions.act_window">
        <field name="name">Thư viện tiêu chí kiểm tra</field>
        <field name="res_model">wujia.franchise.inspection.template.line</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_template_line_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo tiêu chí giám sát mới
            </p>
            <p>
                Tiêu chí kiểm tra chi tiết được cấu hình trong từng mẫu phiếu giám sát.
            </p>
        </field>
    </record>

</odoo>