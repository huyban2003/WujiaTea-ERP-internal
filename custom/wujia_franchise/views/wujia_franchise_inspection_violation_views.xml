<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Search View cho Phân tích tiêu chí vi phạm -->
    <record id="view_wujia_franchise_inspection_line_search" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.line.search</field>
        <field name="model">wujia.franchise.inspection.line</field>
        <field name="arch" type="xml">
            <search string="Search inspection criteria">
                <field name="template_id" string="Inspection template" />
                <field name="template_line_id" string="Template criterion" />
                <field name="content_snapshot" string="Criterion content" />
                <field name="franchise_id" string="Store" />
                <field name="category_id" string="Criterion categories" />
                <field name="planned_date" string="Inspection date" />
                <separator />
                <filter string="Passed criteria" name="pass_only"
                    domain="[('is_pass', '=', True)]" />
                <separator />
                <filter string="Inspection time" name="filter_planned_date" date="planned_date" />
                <separator />
                <filter string="Inspection template" name="group_template"
                    context="{'group_by': 'template_id'}" />
                <filter string="Template criterion line" name="group_template_line"
                    context="{'group_by': 'template_line_id'}" />
                <filter string="Criterion content" name="group_content"
                    context="{'group_by': 'content_snapshot'}" />
                <filter string="Result (pass / fail)" name="group_result"
                    context="{'group_by': 'result'}" />
                <filter string="Criterion categories" name="group_category"
                    context="{'group_by': 'category_id'}" />
                <filter string="Store" name="group_franchise"
                    context="{'group_by': 'franchise_id'}" />
            </search>
        </field>
    </record>

    <!-- Graph View: Biểu đồ đường xếp chồng (Stacked line chart) - Phân tích tiêu chí vi phạm -->
    <record id="view_wujia_franchise_inspection_line_violation_graph" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.line.violation.graph</field>
        <field name="model">wujia.franchise.inspection.line</field>
        <field name="arch" type="xml">
            <graph string="Violated criteria analysis" type="line" stacked="1" sample="1">
                <field name="template_line_id" type="row" />
                <field name="result" type="col" />
            </graph>
        </field>
    </record>

    <!-- Pivot View: Bảng tổng hợp Pivot phân tích theo Mẫu khảo sát và Tiêu chí mẫu -->
    <record id="view_wujia_franchise_inspection_line_violation_pivot" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.line.violation.pivot</field>
        <field name="model">wujia.franchise.inspection.line</field>
        <field name="arch" type="xml">
            <pivot string="Violated criteria analysis" sample="1">
                <field name="template_id" type="row" />
                <field name="template_line_id" type="row" />
                <field name="result" type="col" />
            </pivot>
        </field>
    </record>

    <!-- List View: Danh sách chi tiết các line tiêu chí từ phiếu hoàn thành -->
    <record id="view_wujia_franchise_inspection_line_violation_tree" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.line.violation.list</field>
        <field name="model">wujia.franchise.inspection.line</field>
        <field name="arch" type="xml">
            <list string="Violated criteria analysis" create="false" edit="false" delete="false">
                <field name="template_id" />
                <field name="template_line_id" />
                <field name="inspection_id" />
                <field name="franchise_id" />
                <field name="category_id" />
                <field name="content_snapshot" />
                <field name="result" widget="badge" decoration-success="result == 'pass'"
                    decoration-danger="result == 'fail'" />
                <field name="note" string="Violation note (admin)" optional="show" />
                <field name="remediation_note" string="Remediation note (store)" optional="show" />
                <field name="evidence_image" widget="image" options="{'size': [40, 40]}"
                    optional="show" />
                <field name="remediation_image" widget="image" options="{'size': [40, 40]}"
                    optional="show" />
                <field name="pass_count" />
                <field name="fail_count" />
            </list>
        </field>
    </record>

    <!-- Form View Popup xem chi tiết 1 dòng tiêu chí đợt trước (Readonly) -->
    <record id="view_wujia_franchise_inspection_line_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.line.form</field>
        <field name="model">wujia.franchise.inspection.line</field>
        <field name="arch" type="xml">
            <form string="Previous round criterion details" create="false" edit="false" delete="false">
                <sheet>
                    <group>
                        <group string="CRITERION INFORMATION">
                            <field name="inspection_id" readonly="1" options="{'no_open': True}" />
                            <field name="franchise_id" readonly="1" options="{'no_open': True}" />
                            <field name="planned_date" readonly="1" />
                            <field name="category_id" readonly="1" options="{'no_open': True}" />
                            <field name="content_snapshot" readonly="1" />
                        </group>
                        <group string="RESULT &amp; EVIDENCE">
                            <field name="criterion_type_snapshot" readonly="1" widget="badge"
                                decoration-danger="criterion_type_snapshot == 'critical'"
                                decoration-info="criterion_type_snapshot == 'normal'" />
                            <field name="deduction_score_snapshot" readonly="1" />
                            <field name="result" readonly="1" widget="badge"
                                decoration-success="result == 'pass'"
                                decoration-danger="result == 'fail'" />
                            <field name="note" readonly="1" />
                        </group>
                    </group>
                    <group string="EVIDENCE &amp; REMEDIATION">
                        <group string="Violation evidence at inspection time">
                            <field name="evidence_image" widget="image"
                                options="{'size': [200, 200]}" readonly="1" nolabel="1" />
                        </group>
                        <group string="Photo after remediation">
                            <field name="remediation_image" widget="image"
                                options="{'size': [200, 200]}" readonly="1" nolabel="1" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action Phân tích tiêu chí vi phạm (Chỉ tổng hợp dữ liệu từ các Phiếu khảo sát ở trạng thái
    'Hoàn thành') -->
    <record id="action_wujia_franchise_inspection_report_violation" model="ir.actions.act_window">
        <field name="name">Violated criteria analysis</field>
        <field name="res_model">wujia.franchise.inspection.line</field>
        <field name="domain">[('display_type', '=', 'line'), ('inspection_id.state', 'in', ('done', 'need_remediation'))]</field>
        <field name="view_mode">graph,pivot,list</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_line_search" />
        <field name="context">{}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Analysis of pass / violation counts per template criterion across completed sheets!
            </p>
        </field>
    </record>

</odoo>