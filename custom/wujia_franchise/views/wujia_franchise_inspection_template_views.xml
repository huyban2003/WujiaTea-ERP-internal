<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Category Views -->
    <record id="view_wujia_franchise_inspection_category_tree" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.category.tree</field>
        <field name="model">wujia.franchise.inspection.category</field>
        <field name="arch" type="xml">
            <list string="Danh mục tiêu chí" editable="bottom">
                <field name="sequence" widget="handle" />
                <field name="name" />
                <field name="active" widget="boolean_toggle" />
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_inspection_category_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.category.form</field>
        <field name="model">wujia.franchise.inspection.category</field>
        <field name="arch" type="xml">
            <form string="Danh mục tiêu chí">
                <sheet>
                    <group>
                        <group>
                            <field name="name" />
                        </group>
                        <group>
                            <field name="sequence" />
                            <field name="active" widget="boolean_toggle" />
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_wujia_franchise_inspection_category" model="ir.actions.act_window">
        <field name="name">Danh mục tiêu chí</field>
        <field name="res_model">wujia.franchise.inspection.category</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo danh mục / nhóm tiêu chí khảo sát mới!
            </p>
        </field>
    </record>

    <!-- Template Tree / List View -->
    <record id="view_wujia_franchise_inspection_template_tree" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.template.tree</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <list string="Mẫu khảo sát">
                <field name="code" />
                <field name="name" />
                <field name="version" />
                <field name="effective_date" />
                <field name="checklist_max_score" />
                <field name="exam_max_score" />
                <field name="total_max_score" />
                <field name="state" widget="badge"
                    decoration-info="state == 'draft'"
                    decoration-success="state == 'active'"
                    decoration-muted="state == 'archived'" />
            </list>
        </field>
    </record>

    <!-- Template Form View -->
    <record id="view_wujia_franchise_inspection_template_form" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.template.form</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <form string="Mẫu khảo sát">
                <header>
                    <button name="action_activate" string="Kích hoạt (Active)" type="object"
                        class="btn-primary" invisible="state == 'active'" />
                    <button name="action_create_new_version" string="Tạo phiên bản mới"
                        type="object" class="btn-success" invisible="state == 'draft'" />
                    <button name="action_reset_draft" string="Đặt về Draft" type="object"
                        invisible="state == 'draft'" />
                    <button name="action_archive" string="Lưu trữ (Archive)" type="object"
                        invisible="state == 'archived'" />
                    <field name="state" widget="statusbar" statusbar_visible="draft,active,archived" />
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Tên mẫu khảo sát" />
                        <h1>
                            <field name="name"
                                placeholder="Ví dụ: Mẫu khảo sát vệ sinh &amp; chất lượng cửa hàng 2026"
                                readonly="state in ('active', 'archived')" />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="code" placeholder="MẪU-KS-01"
                                readonly="state in ('active', 'archived')" />
                            <field name="version" readonly="state in ('active', 'archived')" />
                            <field name="effective_date" readonly="state in ('active', 'archived')" />
                        </group>
                        <group string="Cấu hình thang điểm">
                            <field name="checklist_max_score"
                                readonly="state in ('active', 'archived')" />
                            <field name="exam_max_score" readonly="state in ('active', 'archived')" />
                            <field name="total_max_score" class="fw-bold" />
                        </group>
                    </group>
                    <notebook>
                        <page string="Danh sách tiêu chí" name="lines">
                            <field name="line_ids" readonly="state in ('active', 'archived')">
                                <list editable="bottom" limit="100" decoration-bf="display_type == 'section'" decoration-info="display_type == 'section'">
                                    <control>
                                        <create name="add_line_control" string="Thêm dòng tiêu chí" context="{'default_display_type': 'line'}"/>
                                        <create name="add_section_control" string="Thêm Section" context="{'default_display_type': 'section'}"/>
                                    </control>
                                    <field name="sequence" widget="handle" />
                                    <field name="display_type" column_invisible="True" />
                                    <field name="criterion_code" />
                                    <field name="category_id" />
                                    <field name="content" invisible="display_type == 'section'" required="display_type == 'line'" />
                                    <field name="criterion_type" invisible="display_type == 'section'" />
                                    <field name="deduction_score" invisible="display_type == 'section'" />
                                    <field name="require_note_if_fail" invisible="display_type == 'section'" />
                                    <field name="require_evidence_if_fail" invisible="display_type == 'section'" />
                                    <field name="active" widget="boolean_toggle" invisible="display_type == 'section'" />
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <!-- Template Search View -->
    <record id="view_wujia_franchise_inspection_template_search" model="ir.ui.view">
        <field name="name">wujia.franchise.inspection.template.search</field>
        <field name="model">wujia.franchise.inspection.template</field>
        <field name="arch" type="xml">
            <search string="Tìm kiếm Mẫu khảo sát">
                <field name="name" />
                <field name="code" />
                <field name="version" />
                <separator />
                <filter string="Draft" name="draft" domain="[('state', '=', 'draft')]" />
                <filter string="Active" name="active" domain="[('state', '=', 'active')]" />
                <filter string="Archived" name="archived" domain="[('state', '=', 'archived')]" />
                <separator />
                <filter string="Trạng thái" name="group_state" context="{'group_by': 'state'}" />
                <filter string="Ngày áp dụng" name="group_date"
                    context="{'group_by': 'effective_date'}" />
            </search>
        </field>
    </record>

    <!-- Template Action -->
    <record id="action_wujia_franchise_inspection_template" model="ir.actions.act_window">
        <field name="name">Mẫu khảo sát</field>
        <field name="res_model">wujia.franchise.inspection.template</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_wujia_franchise_inspection_template_search" />
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo mẫu khảo sát mới cho hệ thống cửa hàng nhượng quyền!
            </p>
        </field>
    </record>

</odoo>