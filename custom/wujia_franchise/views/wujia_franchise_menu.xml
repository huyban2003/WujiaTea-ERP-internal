<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Cấu trúc Menu theo bản vẽ thiết kế:
        QUẢN LÝ NHƯỢNG QUYỀN
          ├─ Operation
          │   ├─ Franchise Management   (wujia.franchise.management)
          │   └─ Franchise Member       (wujia.franchise.member)
          ├─ Giám sát cửa hàng
          │   ├─ Phiếu giám sát
          │   ├─ Lịch giám sát
          │   ├─ Cửa hàng cần giám sát
          │   ├─ Chờ xử lý khắc phục
          │   ├─ Lịch sử giám sát
          │   ├─ Cấu hình giám sát
          │   │   ├─ Mẫu phiếu giám sát         (action_wujia_franchise_inspection_template)
          │   │   ├─ Danh mục tiêu chí           (action_wujia_franchise_inspection_category)
          │   │   ├─ Thư viện câu hỏi kiểm tra
          │   │   └─ Xếp hạng giám sát
          │   └─ Báo cáo
          │       ├─ Phân tích kết quả giám sát
          │       └─ Phân tích tiêu chí vi phạm
          └─ Configuration / Cấu hình
              └─ Area Management
                  ├─ Area
                  ├─ Province / City
                  └─ Ward
    -->

    <menuitem id="menu_wujia_root"
        name="Franchise Management"
        web_icon="wujia_franchise,static/description/icon.png"
        sequence="20"
        groups="group_franchise_user" />

    <!-- 1. Vận hành / Operation -->
    <menuitem id="menu_wujia_operation_root"
        name="Operation"
        parent="menu_wujia_root"
        sequence="10" />

    <menuitem id="menu_wujia_franchise_management"
        name="Franchise Management"
        parent="menu_wujia_operation_root"
        action="action_franchise_management"
        sequence="10" />

    <menuitem id="menu_wujia_franchise_member"
        name="Franchise Member"
        parent="menu_wujia_operation_root"
        action="action_wujia_franchise_member"
        sequence="20" />

    <!-- 2. Giám sát cửa hàng -->
    <menuitem id="menu_wujia_inspection_supervision_root"
        name="Giám sát cửa hàng"
        parent="menu_wujia_root"
        sequence="30" />

    <menuitem id="menu_wujia_inspection_sheet"
        name="Phiếu giám sát"
        parent="menu_wujia_inspection_supervision_root"
        action="action_wujia_franchise_inspection"
        sequence="10" />

    <menuitem id="menu_wujia_inspection_schedule"
        name="Lịch giám sát"
        parent="menu_wujia_inspection_supervision_root"
        action="action_wujia_supervision_schedule"
        sequence="20" />

    <menuitem id="menu_wujia_inspection_pending_store"
        name="Cửa hàng cần giám sát"
        parent="menu_wujia_inspection_supervision_root"
        action="action_franchise_needed_inspection"
        sequence="30" />

    <menuitem id="menu_wujia_inspection_remediation"
        name="Chờ xử lý khắc phục"
        parent="menu_wujia_inspection_supervision_root"
        action="action_wujia_franchise_inspection_remediation"
        sequence="40" />

    <menuitem id="menu_wujia_inspection_history"
        name="Lịch sử giám sát"
        parent="menu_wujia_inspection_supervision_root"
        action="action_wujia_franchise_inspection_history"
        sequence="50" />

    <menuitem id="menu_wujia_inspection_config_root"
        name="Cấu hình giám sát"
        parent="menu_wujia_inspection_supervision_root"
        sequence="60" />

    <menuitem id="menu_wujia_inspection_template"
        name="Mẫu phiếu giám sát"
        parent="menu_wujia_inspection_config_root"
        action="action_wujia_franchise_inspection_template"
        sequence="10" />

    <menuitem id="menu_wujia_inspection_category"
        name="Danh mục tiêu chí"
        parent="menu_wujia_inspection_config_root"
        action="action_wujia_franchise_inspection_category"
        sequence="20" />

    <menuitem id="menu_wujia_inspection_question_bank"
        name="Thư viện câu hỏi kiểm tra"
        parent="menu_wujia_inspection_config_root"
        action="action_wujia_franchise_inspection_question"
        sequence="30" />

    <menuitem id="menu_wujia_inspection_ranking"
        name="Xếp hạng giám sát"
        parent="menu_wujia_inspection_config_root"
        action="action_wujia_franchise_inspection_grade"
        sequence="40" />
    <!-- 3. Báo cáo (Con của Giám sát cửa hàng) -->
    <menuitem id="menu_wujia_inspection_report_root"
        name="Báo cáo"
        parent="menu_wujia_inspection_supervision_root"
        sequence="70" />

    <menuitem id="menu_wujia_inspection_report_result"
        name="Phân tích kết quả giám sát"
        parent="menu_wujia_inspection_report_root"
        action="action_wujia_franchise_inspection_report_result"
        sequence="10" />

    <menuitem id="menu_wujia_inspection_report_violation"
        name="Phân tích tiêu chí vi phạm"
        parent="menu_wujia_inspection_report_root"
        action="action_wujia_franchise_inspection_report_violation"
        sequence="20" />

    <!-- 4. Cấu hình -->
    <menuitem id="menu_wujia_config_root"
        name="Configuration"
        parent="menu_wujia_root"
        sequence="90"
        groups="group_franchise_manager" />


    <!-- Area Management -->
    <menuitem id="menu_wujia_config_area_root"
        name="Area Management"
        parent="menu_wujia_config_root"
        sequence="10" />

    <menuitem id="menu_wujia_config_area"
        name="Area"
        parent="menu_wujia_config_area_root"
        action="wujia_core.action_res_area"
        sequence="10" />

    <menuitem id="menu_wujia_config_state"
        name="Province / City"
        parent="menu_wujia_config_area_root"
        action="base.action_country_state"
        sequence="20" />

    <menuitem id="menu_wujia_config_ward"
        name="Ward"
        parent="menu_wujia_config_area_root"
        action="wujia_core.action_res_ward"
        sequence="30" />

</odoo>