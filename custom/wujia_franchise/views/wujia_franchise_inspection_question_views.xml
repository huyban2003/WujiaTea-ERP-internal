

<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- INSPECTION QUESTIONS -->
    <record id="view_wujia_franchise_inspection_question_tree" model="ir.ui.view">
        <field name="name">Thư viện câu hỏi kiểm tra - Danh sách</field>
        <field name="model">wujia.franchise.inspection.question</field>
        <field name="arch" type="xml">
            <list>
                <field name="code"/>
                <field name="question_text"/>
                <field name="correct_answer"/>
                <field name="category"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_wujia_franchise_inspection_question_form" model="ir.ui.view">
        <field name="name">Thư viện câu hỏi kiểm tra - Form</field>
        <field name="model">wujia.franchise.inspection.question</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="code"/>
                        <field name="category"/>
                        <field name="active"/>
                    </group>
                    <field name="question_text" placeholder="Nội dung câu hỏi"/>
                    <field name="correct_answer" placeholder="Đáp án đúng"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_inspection_question" model="ir.actions.act_window">
        <field name="name">Thư viện câu hỏi kiểm tra</field>
        <field name="res_model">wujia.franchise.inspection.question</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Tạo câu hỏi đầu tiên
            </p>
        </field>
    </record>

</odoo>
