<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Template Printable PDF Report (Fully Internationalized) -->
    <template id="report_inspection_document">
        <t t-set="doc_store_name"
            t-value="docs[0].franchise_id.name if (docs and docs[0].franchise_id) else ''" />
        <t t-set="doc_plan_date"
            t-value="docs[0].planned_date.strftime('%d-%m-%Y') if (docs and docs[0].planned_date) else ''" />
        <t t-set="title"
            t-value="'Báo cáo Khảo sát Giám sát [%s] [%s]' % (doc_store_name, doc_plan_date)" />
        <t t-call="web.html_container">
            <script type="text/javascript">
                (function() {
                    var title = "Báo cáo Khảo sát Giám sát [<t t-esc="doc_store_name" />] [<t t-esc="doc_plan_date" />]";
                    document.title = title;
                    try {
                        if (window.parent &amp;&amp; window.parent.document) {
                            window.parent.document.title = title;
                        }
                    } catch(e) {}
                })();
            </script>
            <link rel="preconnect" href="https://fonts.googleapis.com" />
            <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
            <link
                href="https://fonts.googleapis.com/css2?family=Roboto:ital,wght@0,400;0,500;0,700;0,900;1,400;1,700&amp;family=Noto+Sans+Vietnamese:wght@400;500;600;700;800&amp;display=swap"
                rel="stylesheet" />
            <link rel="stylesheet"
                href="/wujia_franchise/static/src/css/inspection_report.css?v=1787738921" />
            <script type="text/javascript"
                src="/wujia_franchise/static/src/js/inspection_report.js?v=1787738921"></script>
            <t t-foreach="docs" t-as="doc">
                <t t-set="t" t-value="doc.get_report_translations(doc.env.context.get('lang'))" />
                <div class="report-article article">
                    <!-- Top Action Bar (hidden on print) -->
                    <div class="report-action-bar no-print">
                        <div>
                            <div class="action-bar-title">
                                <i class="fa fa-file-pdf"></i>
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:bar_title', 'Xem trước Báo cáo Khảo sát Giám sát')" />
                            </div>
                            <div class="action-bar-sub">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:bar_sub', 'Bấm nút in bên dưới để lưu file PDF hoặc in trực tiếp ra máy in.')" />
                            </div>
                            <div style="font-size: 11px; color: #64748b; margin-top: 4px;">
                                <i class="fa fa-circle-info text-primary me-1"></i>
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:print_tip', 'Mẹo: Bỏ tích ô Headers and footers (Tiêu đề và chân trang) trong hộp thoại in của trình duyệt để ẩn hoàn toàn link URL và ngày giờ.')" />
                            </div>
                        </div>
                        <button type="button" id="btnPrintReport" class="btn-print-action">
                            <i class="fa fa-print"></i>
                            <t
                                t-out="t.get('label:wujia.franchise.inspection_report:btn_print', 'In / Xuất PDF')" />
                        </button>
                    </div>

                    <!-- Report Header -->
                    <div class="report-header">
                        <div>
                            <h1 class="report-title">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:report_title', 'PHIẾU KHẢO SÁT GIÁM SÁT CỬA HÀNG')" />
                            </h1>
                            <div class="store-name-sub">
                                <t t-esc="doc.franchise_id.name" /> (<t
                                    t-esc="doc.franchise_id.code or '---'" />) </div>
                        </div>
                        <div style="text-align: right;">
                            <div class="report-code-badge">
                                <t t-esc="doc.name" />
                            </div>
                            <div class="report-date-text">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_planned_date', 'Ngày khảo sát:')" />
                                <strong>
                                    <t t-esc="doc.planned_date"
                                        t-options='{"widget": "date", "format": "dd/MM/yyyy"}' />
                                </strong>
                            </div>
                        </div>
                    </div>

                    <!-- General Info Grid -->
                    <table class="info-grid">
                        <tr>
                            <td class="label-cell">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_store', 'Cửa hàng:')" />
                            </td>
                            <td>
                                <strong style="color: #0f172a;">
                                    <t t-esc="doc.franchise_id.name" />
                                </strong>
                            </td>
                            <td class="label-cell">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_inspector', 'Người kiểm tra:')" />
                            </td>
                            <td>
                                <t t-esc="doc.inspector_user_id.name" />
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_address', 'Địa chỉ:')" />
                            </td>
                            <td>
                                <t t-esc="doc.franchise_id.address or '---'" />
                            </td>
                            <td class="label-cell">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_store_rep', 'Đại diện cửa hàng:')" />
                            </td>
                            <td>
                                <t
                                    t-esc="doc.confirmed_member_id.display_name if doc.confirmed_member_id else '---'" />
                            </td>
                        </tr>
                        <tr>
                            <td class="label-cell">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_state', 'Trạng thái:')" />
                            </td>
                            <td>
                                <span
                                    t-att-class="'badge-rep-pass' if doc.state == 'done' else 'badge-rep-fail'">
                                    <t t-if="doc.state == 'done'">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:state_done', 'Đã hoàn thành')" />
                                    </t>
                                    <t t-elif="doc.state == 'need_remediation'">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:state_remediation', 'Cần khắc phục')" />
                                    </t>
                                    <t t-elif="doc.state == 'in_progress'">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:state_in_progress', 'Đang thực hiện')" />
                                    </t>
                                    <t t-else="">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:state_draft', 'Bản nháp')" />
                                    </t>
                                </span>
                            </td>
                            <td class="label-cell">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_test_employee', 'Nhân viên làm test:')" />
                            </td>
                            <td><t t-esc="doc.test_employee_name or '---'" /> (<t
                                    t-out="t.get('label:wujia.franchise.inspection_report:label_tenure', 'Thâm niên:')" /> <t
                                    t-esc="doc.tenure or '---'" />)</td>
                        </tr>
                    </table>

                    <!-- Summary Score Cards -->
                    <div class="score-container">
                        <div class="score-box">
                            <div class="s-label">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:card_checklist_score', 'Điểm Checklist')" />
                            </div>
                            <div class="s-val"><t t-esc="doc.checklist_score" /> / 95</div>
                        </div>
                        <div class="score-box">
                            <div class="s-label">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:card_exam_score', 'Kiểm tra NV')" />
                            </div>
                            <div class="s-val"><t t-esc="doc.exam_score" /> / 5</div>
                        </div>
                        <div class="score-box highlight-total">
                            <div class="s-label">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:card_total_score', 'Tổng Điểm Đạt')" />
                            </div>
                            <div class="s-val"><t t-esc="doc.total_score" /> / 100</div>
                        </div>
                        <div class="score-box">
                            <div class="s-label">
                                <t
                                    t-out="t.get('label:wujia.franchise.inspection_report:card_grade', 'Xếp Loại')" />
                            </div>
                            <div class="s-val s-val-grade">
                                <t t-esc="doc.grade_id.name if doc.grade_id else '---'" />
                            </div>
                        </div>
                    </div>

                    <!-- Section I: Checklist Criteria -->
                    <h3 class="section-heading">
                        <t
                            t-out="t.get('label:wujia.franchise.inspection_report:sec_checklist_title', 'I. Bảng Đánh Giá Tiêu Chí Checklist')" />
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 5%; text-align: center;">
                                    <t
                                        t-out="t.get('label:wujia.franchise.inspection_report:th_stt', 'STT')" />
                                </th>
                                <th style="width: 50%;">
                                    <t
                                        t-out="t.get('label:wujia.franchise.inspection_report:th_content', 'Nội dung Tiêu chí')" />
                                </th>
                                <th style="width: 12%; text-align: center;">
                                    <t
                                        t-out="t.get('label:wujia.franchise.inspection_report:th_eval', 'Đánh giá')" />
                                </th>
                                <th style="width: 18%;">
                                    <t
                                        t-out="t.get('label:wujia.franchise.inspection_report:th_note', 'Ghi chú vi phạm')" />
                                </th>
                                <th style="width: 15%; text-align: center;">
                                    <t
                                        t-out="t.get('label:wujia.franchise.inspection_report:th_evidence', 'Ảnh bằng chứng')" />
                                </th>
                            </tr>
                        </thead>
                        <tbody>
                            <t t-set="seq_idx" t-value="0" />
                            <t t-foreach="doc.line_ids" t-as="l">
                                <t t-if="l.display_type == 'section'">
                                    <tr class="sec-row">
                                        <td colspan="5" style="padding: 8px 12px;">
                                            <i class="fa fa-folder-open text-primary me-1"></i>
                                            <strong style="color: #0f172a;">
                                                <t t-esc="l.content_snapshot or l.name" />
                                            </strong>
                                        </td>
                                    </tr>
                                </t>
                                <t t-else="">
                                    <t t-set="seq_idx" t-value="seq_idx + 1" />
                                    <tr
                                        t-attf-class="#{'important-rep-row' if (l.criterion_type_snapshot == 'critical' or (l.deduction_score_snapshot and l.deduction_score_snapshot >= 5.0)) else ''}">
                                        <td style="text-align: center; font-weight: 600;">
                                            <t t-esc="seq_idx" />
                                        </td>
                                        <td>
                                            <t t-esc="l.content_snapshot" />
                                        </td>
                                        <td style="text-align: center; white-space: nowrap;">
                                            <t t-if="l.is_pass">
                                                <span class="badge-rep-pass">✓</span>
                                            </t>
                                            <t t-else="">
                                                <span class="badge-rep-fail">✗</span>
                                            </t>
                                        </td>
                                        <td style="font-size: 11px; color: #475569;">
                                            <t t-esc="l.note or '---'" />
                                        </td>
                                        <td style="text-align: center;">
                                            <t t-if="l.evidence_image">
                                                <img class="photo-thumb"
                                                    t-attf-src="/web/image/wujia.franchise.inspection.line/#{l.id}/evidence_image" />
                                            </t>
                                            <t t-else="">
                                                <span style="color: #cbd5e1; font-size: 11px;">
                                                    <t
                                                        t-out="t.get('label:wujia.franchise.inspection_report:label_no_photo', 'Không')" />
                                                </span>
                                            </t>
                                        </td>
                                    </tr>
                                </t>
                            </t>
                        </tbody>
                    </table>

                    <!-- Section II: Staff Exam Questions -->
                    <t t-if="doc.exam_line_ids">
                        <h3 class="section-heading">
                            <t
                                t-out="t.get('label:wujia.franchise.inspection_report:sec_exam_title', 'II. Kết Quả Kiểm Tra Kiến Thức Nhân Viên')" />
                            (<t t-esc="doc.test_employee_name or 'Nhân viên'" />) </h3>
                        <table class="rep-table">
                            <thead>
                                <tr>
                                    <th style="width: 8%; text-align: center;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:th_exam_code', 'Mã')" />
                                    </th>
                                    <th style="width: 42%;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:th_exam_question', 'Câu hỏi')" />
                                    </th>
                                    <th style="width: 35%;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:th_exam_answer', 'Câu trả lời của nhân viên')" />
                                    </th>
                                    <th style="width: 15%; text-align: center;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:th_exam_score', 'Điểm đạt')" />
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.exam_line_ids" t-as="el">
                                    <tr>
                                        <td
                                            style="text-align: center; font-weight: 700; color: #2563eb;">
                                            <t t-esc="el.quest_code_snapshot" />
                                        </td>
                                        <td>
                                            <t t-esc="el.quest_content_snapshot" />
                                        </td>
                                        <td style="color: #334155;">
                                            <t t-esc="el.answer or '---'" />
                                        </td>
                                        <td
                                            style="text-align: center; font-weight: 700; white-space: nowrap;">
                                            <span
                                                t-att-style="'color: #15803d;' if el.is_correct else 'color: #b91c1c;'">
                                                <t t-if="el.is_correct">✓</t><t t-else="">✗</t> <t
                                                    t-esc="el.point" /> / <t
                                                    t-esc="el.quest_id.score if el.quest_id else 1.0" />
                                            </span>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Section III: Attendance & Store Appearance -->
                    <h3 class="section-heading">
                        <t
                            t-out="t.get('label:wujia.franchise.inspection_report:sec_attendance_title', 'III. Điểm Danh Nhân Viên &amp; Ghi Nhận Khắc Phục')" />
                    </h3>
                    <table class="rep-table">
                        <thead>
                            <tr>
                                <th style="width: 50%;">
                                    <t
                                        t-out="t.get('label:wujia.franchise.inspection_report:th_issues_header', 'Ghi nhận ngoại quan kém &amp; Lỗi trọng điểm đợt này')" />
                                </th>
                                <th style="width: 50%;"><t
                                        t-out="t.get('label:wujia.franchise.inspection_report:th_attendance_header', 'Danh sách nhân viên có mặt tại buổi khảo sát')" />
                                    (<t t-esc="doc.present_count" /> <t
                                        t-out="t.get('label:wujia.franchise.inspection_report:word_person', 'người')" />
                                    )</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr>
                                <td class="remediation-box">
                                    <div class="remediation-box-label">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:label_remediation_content', 'Nội dung cần khắc phục:')" />
                                    </div>
                                    <div class="remediation-box-content">
                                        <t
                                            t-esc="doc.store_appearance_issues or t.get('label:wujia.franchise.inspection_report:empty_issues', 'Không có ghi nhận lỗi ngoại quan trọng điểm.')" />
                                    </div>
                                </td>
                                <td class="attendance-list-cell">
                                    <t t-if="doc.attendance_line_ids">
                                        <ul class="attendance-ul">
                                            <t t-foreach="doc.attendance_line_ids" t-as="att">
                                                <li class="attendance-li">
                                                    <t t-if="att.is_present">
                                                        <strong style="color: #0f172a;">
                                                            <t t-esc="att.employee_name" />
                                                        </strong>
                                                        <span
                                                            style="color: #475569; font-size: 11px;">
                                                            (<t t-if="att.role == 'owner'">
                                                                <t
                                                                    t-out="t.get('label:wujia.franchise.inspection_report:role_owner', 'Chủ cửa hàng')" />
                                                            </t><t
                                                                t-elif="att.role == 'manager'">
                                                                <t
                                                                    t-out="t.get('label:wujia.franchise.inspection_report:role_manager', 'Quản lý')" />
                                                            </t><t
                                                                t-else="">
                                                                <t
                                                                    t-out="t.get('label:wujia.franchise.inspection_report:role_staff', 'Nhân viên')" />
                                                            </t>
                                                            ) </span>
                                                        <span
                                                            style="color: #15803d; font-size: 11px; font-weight: 600; margin-left: 4px;">
                                                            <t
                                                                t-out="t.get('label:wujia.franchise.inspection_report:badge_present', '[Có mặt]')" />
                                                        </span>
                                                    </t>
                                                    <t t-else="">
                                                        <s style="color: #94a3b8; font-weight: 500;">
                                                            <t t-esc="att.employee_name" />
                                                        </s>
                                                        <span
                                                            style="color: #94a3b8; font-size: 11px;">
                                                            (<t t-if="att.role == 'owner'">
                                                                <t
                                                                    t-out="t.get('label:wujia.franchise.inspection_report:role_owner', 'Chủ cửa hàng')" />
                                                            </t><t
                                                                t-elif="att.role == 'manager'">
                                                                <t
                                                                    t-out="t.get('label:wujia.franchise.inspection_report:role_manager', 'Quản lý')" />
                                                            </t><t
                                                                t-else="">
                                                                <t
                                                                    t-out="t.get('label:wujia.franchise.inspection_report:role_staff', 'Nhân viên')" />
                                                            </t>
                                                            ) </span>
                                                        <span
                                                            style="color: #ef4444; font-size: 11px; font-weight: 600; margin-left: 4px;">
                                                            <t
                                                                t-out="t.get('label:wujia.franchise.inspection_report:badge_absent', '[Vắng]')" />
                                                        </span>
                                                    </t>
                                                </li>
                                            </t>
                                        </ul>
                                    </t>
                                    <t t-else="">
                                        <span style="color: #94a3b8; font-style: italic;">
                                            <t
                                                t-out="t.get('label:wujia.franchise.inspection_report:empty_attendance', 'Chưa có danh sách điểm danh')" />
                                        </span>
                                    </t>
                                </td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Section IV: 3-Month Revenue Report -->
                    <t t-if="doc.report_line_ids">
                        <h3 class="section-heading">
                            <t
                                t-out="t.get('label:wujia.franchise.inspection_report:sec_revenue_title', 'IV. Báo Cáo Chi Tiết Doanh Thu 3 Tháng')" />
                        </h3>
                        <table class="rep-table">
                            <thead>
                                <tr>
                                    <th style="width: 18%; text-align: center; white-space: nowrap;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_survey:th_month', 'Tháng')" />
                                    </th>
                                    <th style="width: 22%; text-align: right; white-space: nowrap;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_survey:th_revenue', 'Doanh thu')" />
                                    </th>
                                    <th style="width: 22%; text-align: right; white-space: nowrap;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_survey:th_revenue_avg', 'Doanh thu/ngày')" />
                                    </th>
                                    <th style="width: 20%; text-align: right; white-space: nowrap;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_survey:th_total_app_sale', 'Tổng đơn App')" />
                                    </th>
                                    <th style="width: 18%; text-align: right; white-space: nowrap;">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_survey:th_percent_app_sale', '% Đơn App')" />
                                    </th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="doc.report_line_ids" t-as="rl">
                                    <tr>
                                        <td
                                            style="text-align: center; font-weight: 700; color: #1e293b;">
                                            <t
                                                t-esc="rl.date_month.strftime('%m/%Y') if rl.date_month else '---'" />
                                        </td>
                                        <td style="text-align: right; font-weight: 600;">
                                            <t
                                                t-esc="'{:,.0f}'.format(rl.revenue) if rl.revenue else '0'" />
                                        </td>
                                        <td
                                            style="text-align: right; font-weight: 600; color: #475569;">
                                            <t
                                                t-esc="'{:,.0f}'.format(rl.revenue_avg) if rl.revenue_avg else '0'" />
                                        </td>
                                        <td style="text-align: right; font-weight: 600;">
                                            <t
                                                t-esc="'{:,}'.format(rl.total_app_sale) if rl.total_app_sale else '0'" />
                                        </td>
                                        <td
                                            style="text-align: right; font-weight: 700; color: #2563eb;">
                                            <t t-esc="rl.percent_app_sale" /> % </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </t>

                    <!-- Signatures Block (Never split across pages) -->
                    <div class="sig-block-wrap">
                        <table class="sig-grid">
                            <tr>
                                <td>
                                    <div class="sig-title">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:sig_store_rep_title', 'ĐẠI DIỆN CỬA HÀNG XÁC NHẬN')" />
                                    </div>
                                    <div class="sig-subtitle">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:sig_sub_instruction', '(Ký và ghi rõ họ tên)')" />
                                    </div>
                                    <div class="sig-img-box">
                                        <t t-if="doc.signature_image">
                                            <span t-field="doc.signature_image"
                                                t-options='{"widget": "image", "style": "max-height: 70px; max-width: 220px; object-fit: contain;"}' />
                                        </t>
                                    </div>
                                    <div class="sig-name">
                                        <t
                                            t-esc="doc.confirmed_member_id.display_name if doc.confirmed_member_id else '....................................'" />
                                    </div>
                                </td>
                                <td>
                                    <div class="sig-title">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:sig_inspector_title', 'NGƯỜI KIỂM TRA / GIÁM SÁT VIÊN')" />
                                    </div>
                                    <div class="sig-subtitle">
                                        <t
                                            t-out="t.get('label:wujia.franchise.inspection_report:sig_sub_instruction', '(Ký và ghi rõ họ tên)')" />
                                    </div>
                                    <div class="sig-img-box">
                                        <t t-if="doc.inspector_signature_image">
                                            <span t-field="doc.inspector_signature_image"
                                                t-options='{"widget": "image", "style": "max-height: 70px; max-width: 220px; object-fit: contain;"}' />
                                        </t>
                                    </div>
                                    <div class="sig-name">
                                        <t
                                            t-esc="doc.inspector_user_id.name if doc.inspector_user_id else '....................................'" />
                                    </div>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <!-- Built-in Clean Printable Footer -->
                    <div class="report-print-footer">
                        <div>WujiaTea ERP — <t t-esc="doc.name" /> (<t t-esc="doc.franchise_id.name" />
                            )</div>
                        <div>Ngày khảo sát: <t t-esc="doc.planned_date"
                                t-options='{"widget": "date", "format": "dd/MM/yyyy"}' /></div>
                    </div>

                </div>
            </t>
        </t>
    </template>

    <!-- Report Action -->
    <record id="action_report_franchise_inspection" model="ir.actions.report">
        <field name="name">Báo cáo Khảo sát Giám sát</field>
        <field name="model">wujia.franchise.inspection</field>
        <field name="report_type">qweb-html</field>
        <field name="report_name">wujia_franchise.report_inspection_document</field>
        <field name="report_file">wujia_franchise.report_inspection_document</field>
        <field name="print_report_name">'Báo cáo Khảo sát Giám sát [%s] [%s]' %
            (object.franchise_id.name or '', (object.planned_date or
            datetime.date.today()).strftime('%d-%m-%Y'))</field>
        <field name="binding_model_id" ref="model_wujia_franchise_inspection" />
        <field name="binding_type">report</field>
    </record>
</odoo>