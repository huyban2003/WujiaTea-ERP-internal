<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Template Modal Popup Thông báo Gửi phản hồi thành công (Độc lập trong portal_inspection_success_templates.xml) -->
    <template id="portal_inspection_success_popup" name="Wujia Portal — Success Modal Popup">
        <style>
            .wj-success-overlay {
                position: fixed;
                top: 0;
                left: 0;
                right: 0;
                bottom: 0;
                background: rgba(15, 23, 42, 0.65);
                backdrop-filter: blur(4px);
                z-index: 2050;
                display: flex;
                align-items: center;
                justify-content: center;
                padding: 20px;
                opacity: 0;
                visibility: hidden;
                transition: opacity 0.25s ease, visibility 0.25s ease;
            }
            .wj-success-overlay.show-modal {
                opacity: 1;
                visibility: visible;
            }
            .wj-success-card {
                background: #ffffff;
                border-radius: 24px;
                max-width: 440px;
                width: 100%;
                padding: 28px 24px;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.2);
                transform: scale(0.9);
                transition: transform 0.25s cubic-bezier(0.34, 1.56, 0.64, 1);
            }
            .wj-success-overlay.show-modal .wj-success-card {
                transform: scale(1);
            }
            .wj-info-box-bg {
                background-color: #ffffff;
                border: 1px solid #f1f5f9;
                border-radius: 16px;
                padding: 16px;
            }
            .wj-chip-code {
                background-color: #e0f2fe;
                color: #0284c7;
                font-weight: 700;
                font-size: 0.8rem;
                padding: 4px 10px;
                border-radius: 6px;
            }
            .btn-action-primary {
                background-color: #38bdf8;
                border-color: #38bdf8;
                color: #ffffff;
                font-weight: 700;
                border-radius: 14px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                text-decoration: none;
                transition: all 0.2s;
            }
            .btn-action-primary:hover {
                background-color: #0284c7;
                border-color: #0284c7;
                color: #ffffff;
            }
            .btn-action-outline {
                background-color: #ffffff;
                border: 1.5px solid #cbd5e1;
                color: #334155;
                font-weight: 700;
                border-radius: 14px;
                height: 48px;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 8px;
                text-decoration: none;
                transition: all 0.2s;
            }
            .btn-action-outline:hover {
                background-color: #f8fafc;
                color: #0f172a;
            }
        </style>

        <!-- Modal Overlay Element -->
        <div id="remediation_success_modal" class="wj-success-overlay">
            <div class="wj-success-card text-center">

                <!-- Title & Message -->
                <h2 class="font-weight-bold text-dark mb-2" style="font-size: 1.6rem; letter-spacing: -0.5px;">
                    Gửi phản hồi thành công!
                </h2>
                <p class="text-muted small mb-4 px-2" style="font-size: 0.9rem; line-height: 1.45;">
                    Cảm ơn bạn đã gửi phản hồi. Chúng tôi đã ghi nhận thông tin và sẽ phản hồi kết quả sớm nhất.
                </p>

                <!-- Feedback Info Box -->
                <div class="wj-info-box-bg mb-4 text-start">
                    <div class="d-flex align-items-center gap-2 mb-3 pb-2 border-bottom">
                        <i class="feather icon-file-text text-secondary" style="font-size: 1.2rem;"/>
                        <span class="font-weight-bold text-dark small" style="font-size: 0.95rem;">Thông tin phản hồi</span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Mã tiệm:</span>
                        <span id="modal_franchise_code" class="wj-chip-code">
                            <t t-out="modal_data.get('franchise_code') if modal_data else 'HN_ST042'"/>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-2">
                        <span class="text-muted small">Hạng mục:</span>
                        <span id="modal_category_name" class="font-weight-bold text-dark small">
                            <t t-out="modal_data.get('category_name') if modal_data else 'Kiểm tra vệ sinh'"/>
                        </span>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <span class="text-muted small">Thời gian:</span>
                        <span id="modal_submit_time" class="text-muted small font-weight-bold">
                            <t t-out="modal_data.get('submit_time') if modal_data else '24/10/2023 - 14:30'"/>
                        </span>
                    </div>
                </div>

                <!-- 2 Action Buttons -->
                <div class="d-flex flex-column gap-2">
                    <a href="/portal/inspection" class="btn-action-primary w-100">
                        <i class="feather icon-list" style="font-size: 1.1rem;"/>
                        <span>Về danh sách phiếu</span>
                    </a>
                    <a id="modal_detail_url" t-att-href="modal_data.get('detail_url') if modal_data else '/portal/inspection'" class="btn-action-outline w-100">
                        <i class="feather icon-eye" style="font-size: 1.1rem;"/>
                        <span>Xem lại phản hồi</span>
                    </a>
                </div>

            </div>
        </div>
    </template>

</odoo>
