<odoo>
    <data>
        <!-- ==================================================================
             Wujia Auth — Figma WJ_Auth_*_v3
             Login_PC 4886:831 · Login_Mobile 4886:789
             ForgotPassword_PC 4886:742 · ForgotPassword_Mobile 4886:705
             CSS: static/assets/css/_auth.css (chỉ nạp qua asset_css_authentication).
             Contract controller không đổi: error / message / login / name / token.
             ================================================================== -->

        <template id="wujia_portal_layout.login_form">
            <div class="wj-auth-card">
                <h1 class="wj-auth-card__title">Đăng nhập tài khoản</h1>
                <p class="wj-auth-card__sub">Sử dụng tài khoản Ngô Gia đã cấp để truy cập hệ thống.</p>

                <p class="wj-auth-alert wj-auth-alert--error" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <p class="wj-auth-alert wj-auth-alert--success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>

                <form class="wj-auth-form" action="login" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="redirect" t-if="request.params.get('redirect')"
                           t-att-value="request.params.get('redirect')"/>

                    <div class="wj-auth-field">
                        <label class="wj-auth-field__label" for="wj-auth-login">Email / Tên đăng nhập</label>
                        <span class="wj-auth-input">
                            <i class="wj-auth-input__icon feather icon-mail"/>
                            <input class="wj-auth-control" type="text" id="wj-auth-login" name="login"
                                   placeholder="Nhập email hoặc tên đăng nhập" required="required"
                                   autofocus="autofocus" autocapitalize="off" autocomplete="username"
                                   t-att-value="login"/>
                        </span>
                    </div>

                    <div class="wj-auth-field">
                        <label class="wj-auth-field__label" for="wj-auth-password">Mật khẩu</label>
                        <span class="wj-auth-input wj-auth-pwd">
                            <i class="wj-auth-input__icon feather icon-lock"/>
                            <input class="wj-auth-control" type="password" id="wj-auth-password"
                                   name="password" placeholder="Nhập mật khẩu" required="required"
                                   autocomplete="current-password"/>
                            <button class="wj-auth-eye" type="button" data-wujia-pwd-toggle=""
                                    aria-label="Hiện mật khẩu">
                                <i class="feather icon-eye"/>
                            </button>
                        </span>
                    </div>

                    <div class="wj-auth-helper">
                        <a class="wj-auth-link" href="/portal/forgot-pass">Quên mật khẩu?</a>
                    </div>

                    <button class="wj-auth-submit" type="submit">Đăng nhập</button>
                </form>

                <div class="wj-auth-note">
                    <i class="wj-auth-note__icon feather icon-shield"/>
                    <div>
                        <p class="wj-auth-note__title">Bảo mật tài khoản</p>
                        <p class="wj-auth-note__text">Không chia sẻ thông tin đăng nhập cho người khác.</p>
                    </div>
                </div>

                <div class="wj-auth-foot">Cần hỗ trợ? Liên hệ quản trị hệ thống</div>
            </div>
        </template>

        <template id="wujia_portal_layout.login_2fa_form">
            <div class="wj-auth-card wj-auth-card--forgot">
                <h1 class="wj-auth-card__title">Xác thực hai lớp</h1>
                <p class="wj-auth-card__sub">Mở ứng dụng xác thực trên thiết bị của bạn để lấy mã và xác minh danh tính.</p>

                <p class="wj-auth-alert wj-auth-alert--error" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <p class="wj-auth-alert wj-auth-alert--success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>

                <form class="wj-auth-form" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="wj-auth-field">
                        <label class="wj-auth-field__label" for="wj-auth-totp">Mã xác thực (6 chữ số)</label>
                        <span class="wj-auth-input">
                            <i class="wj-auth-input__icon feather icon-shield"/>
                            <input class="wj-auth-control" type="text" id="wj-auth-totp" name="totp_token"
                                   placeholder="Nhập 6 chữ số" required="required"
                                   inputmode="numeric" autocomplete="one-time-code" autofocus="autofocus"/>
                        </span>
                    </div>

                    <button class="wj-auth-submit" type="submit">Xác nhận</button>
                </form>

                <a class="wj-auth-back" href="/portal/login">← Quay lại đăng nhập</a>

                <div class="wj-auth-note">
                    <i class="wj-auth-note__icon wj-auth-note__icon--chip">i</i>
                    <div>
                        <p class="wj-auth-note__title">Bảo vệ thông tin tài khoản</p>
                        <p class="wj-auth-note__text">Mã xác thực chỉ có hiệu lực trong thời gian ngắn.<br/>Không chia sẻ mã cho người khác.</p>
                    </div>
                </div>

                <div class="wj-auth-foot">Cần hỗ trợ? Liên hệ quản trị hệ thống</div>
            </div>
        </template>

        <template id="wujia_portal_layout.forgot_pass_form">
            <div class="wj-auth-card wj-auth-card--forgot">
                <h1 class="wj-auth-card__title">Quên mật khẩu</h1>
                <p class="wj-auth-card__sub">Nhập email đăng nhập. Nếu thông tin phù hợp, hệ thống sẽ gửi hướng dẫn đặt lại mật khẩu đến email của bạn.</p>

                <p class="wj-auth-alert wj-auth-alert--error" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>
                <p class="wj-auth-alert wj-auth-alert--success" t-if="message" role="status">
                    <t t-esc="message"/>
                </p>

                <form class="wj-auth-form" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>

                    <div class="wj-auth-field">
                        <label class="wj-auth-field__label" for="wj-auth-email">Email đăng nhập</label>
                        <span class="wj-auth-input">
                            <i class="wj-auth-input__icon feather icon-mail"/>
                            <input class="wj-auth-control" type="email" id="wj-auth-email" name="login"
                                   placeholder="Nhập email đã được cấp" required="required"
                                   autofocus="autofocus" autocapitalize="off" autocomplete="email"
                                   t-att-value="login"/>
                        </span>
                    </div>

                    <button class="wj-auth-submit" type="submit">Gửi hướng dẫn</button>
                </form>

                <a class="wj-auth-back" href="/portal/login">← Quay lại đăng nhập</a>

                <div class="wj-auth-note">
                    <i class="wj-auth-note__icon wj-auth-note__icon--chip">i</i>
                    <div>
                        <p class="wj-auth-note__title">Bảo vệ thông tin tài khoản</p>
                        <p class="wj-auth-note__text">Hệ thống không xác nhận email có tồn tại hay không.<br/>Vui lòng kiểm tra hộp thư và thư rác sau khi gửi.</p>
                    </div>
                </div>

                <div class="wj-auth-foot">Cần hỗ trợ? Liên hệ quản trị hệ thống</div>
            </div>
        </template>

        <template id="wujia_portal_layout.reset_pass_form">
            <div class="wj-auth-card wj-auth-card--forgot">
                <h1 class="wj-auth-card__title">Đặt lại mật khẩu</h1>
                <p class="wj-auth-card__sub">Tạo mật khẩu mới cho tài khoản <t t-esc="login"/>.</p>

                <p class="wj-auth-alert wj-auth-alert--error" t-if="error" role="alert">
                    <t t-esc="error"/>
                </p>

                <form class="wj-auth-form" method="POST">
                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                    <input type="hidden" name="token" t-att-value="token"/>
                    <input type="hidden" name="login" t-att-value="login"/>
                    <input type="hidden" name="name" t-att-value="name"/>

                    <div class="wj-auth-field">
                        <label class="wj-auth-field__label" for="wj-auth-newpass">Mật khẩu mới</label>
                        <span class="wj-auth-input wj-auth-pwd">
                            <i class="wj-auth-input__icon feather icon-lock"/>
                            <input class="wj-auth-control" type="password" id="wj-auth-newpass"
                                   name="password" placeholder="Tối thiểu 8 ký tự" required="required"
                                   minlength="8" autocomplete="new-password" autofocus="autofocus"/>
                            <button class="wj-auth-eye" type="button" data-wujia-pwd-toggle=""
                                    aria-label="Hiện mật khẩu">
                                <i class="feather icon-eye"/>
                            </button>
                        </span>
                    </div>

                    <div class="wj-auth-field">
                        <label class="wj-auth-field__label" for="wj-auth-confirmpass">Xác nhận mật khẩu</label>
                        <span class="wj-auth-input wj-auth-pwd">
                            <i class="wj-auth-input__icon feather icon-lock"/>
                            <input class="wj-auth-control" type="password" id="wj-auth-confirmpass"
                                   name="confirm_password" placeholder="Nhập lại mật khẩu mới"
                                   required="required" minlength="8" autocomplete="new-password"/>
                            <button class="wj-auth-eye" type="button" data-wujia-pwd-toggle=""
                                    aria-label="Hiện mật khẩu">
                                <i class="feather icon-eye"/>
                            </button>
                        </span>
                    </div>

                    <button class="wj-auth-submit" type="submit">Đặt lại mật khẩu</button>
                </form>

                <a class="wj-auth-back" href="/portal/login">← Quay lại đăng nhập</a>

                <div class="wj-auth-note">
                    <i class="wj-auth-note__icon feather icon-shield"/>
                    <div>
                        <p class="wj-auth-note__title">Bảo mật tài khoản</p>
                        <p class="wj-auth-note__text">Mật khẩu tối thiểu 8 ký tự.<br/>Không chia sẻ thông tin đăng nhập cho người khác.</p>
                    </div>
                </div>

                <div class="wj-auth-foot">Cần hỗ trợ? Liên hệ quản trị hệ thống</div>
            </div>
        </template>

        <template id="wujia_portal_layout.login_container">
            <t t-call="wujia_portal_layout.login_layout">
                <div class="wj-auth">
                    <!-- Pill ngôn ngữ — WJ-LANG-001: danh sách theo ngôn ngữ đang bật,
                         đổi được ngay ở màn đăng nhập (route set-lang nhận cả khách). -->
                    <t t-set="wj_langs" t-value="request.env['ir.http']._wj_portal_langs()"/>
                    <div class="dropdown wj-auth__langwrap">
                        <a class="wj-auth__lang dropdown-toggle" href="#" id="wj-auth-lang"
                           data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                            <t t-foreach="[l for l in wj_langs if l['current']][:1]" t-as="l">
                                <span t-attf-class="wj-auth__flag flag-icon {{l['flag']}}"/>
                                <span class="wj-auth__lang-text" t-out="l['label']"/>
                            </t>
                            <i class="feather icon-chevron-down"/>
                        </a>
                        <div class="dropdown-menu dropdown-menu-right" aria-labelledby="wj-auth-lang">
                            <a t-foreach="wj_langs" t-as="l" class="dropdown-item"
                               t-attf-href="/portal/set-lang/{{l['code']}}"
                               t-att-data-url_code="l['url_code']">
                                <i t-attf-class="flag-icon {{l['flag']}}"/>
                                <t t-out="l['label']"/>
                            </a>
                        </div>
                    </div>

                    <div class="wj-auth__brand">
                        <span class="wj-auth__decor wj-auth__decor--1"/>
                        <span class="wj-auth__decor wj-auth__decor--2"/>

                        <div class="wj-auth__logo">
                            <img t-attf-src="data:image/png;base64,{{env.company.logo_web}}"
                                 alt="Ngô Gia"/>
                        </div>

                        <div class="wj-auth__pitch">
                            <div class="wj-auth__eyebrow">CỔNG THÔNG TIN NHƯỢNG QUYỀN</div>
                            <h1 class="wj-auth__headline">Vận hành cửa hàng<br/>trên một nền tảng</h1>
                            <p class="wj-auth__lead">Theo dõi nghiệp vụ dành cho hệ thống cửa hàng nhượng quyền Ngô Gia trong cùng một cổng thông tin.</p>
                            <hr class="wj-auth__rule"/>
                            <div class="wj-auth__features">
                                <span>Đơn hàng</span>
                                <i/>
                                <span>Giao nhận</span>
                                <i/>
                                <span>Công nợ</span>
                                <i/>
                                <span>Thông báo</span>
                            </div>
                        </div>
                    </div>

                    <div class="wj-auth__main">
                        <t t-out="0"/>
                    </div>
                </div>
            </t>
        </template>

        <!-- Signup giữ nguyên Vuexy (route portal không dùng; Figma chưa có màn này). -->
        <template id="wujia_portal_layout.signup_form">
            <div class="card rounded-0 mb-0 px-2 py-1">
                <div class="card-header pb-1">
                    <div class="card-title d-flex flex-column align-items-center w-100 text-center">
                        <img t-attf-src="data:image/png;base64,{{env.company.logo_web}}" alt="" width="200" height="100" style="object-fit: contain"/>
                    </div>

                </div>
                <div class="card-content">
                    <div class="card-body">
                        <form method="POST">
                            <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                            <input type="hidden" name="token" t-att-value="token"/>
                            <div class="form-label-group">
                                <input type="email" name="login" id="login" class="form-control" placeholder="Email"/>
                                <label for="inputEmail">Your Email</label>
                            </div>
                            <div class="form-label-group">
                                <input type="text" name="name" id="name" class="form-control" placeholder="Name"/>
                                <label for="inputEmail">Your Name</label>
                            </div>
                            <div class="form-label-group">
                                <input type="password" name="password" id="password" class="form-control" placeholder="Password"/>
                                <label for="inputEmail">Password</label>
                            </div>
                            <div class="form-label-group">
                                <input type="password" name="confirm_password" id="confirm_password" class="form-control" placeholder="Confirm password"/>
                                <label for="inputEmail">Confirm Password</label>
                            </div>
                            <p class="alert alert-danger" t-if="error" role="alert">
                                <t t-esc="error"/>
                            </p>
                            <div class="float-md-left d-block mb-1">
                                <a href="login" class="btn btn-outline-primary btn-block px-75">Back to Login</a>
                            </div>
                            <div class="float-md-right d-block mb-1">
                                <button type="submit" class="btn btn-primary btn-block px-75">Confirm</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </template>

        <template id="wujia_portal_layout.login">
            <t t-call="wujia_portal_layout.login_container">
                <t t-call="wujia_portal_layout.login_form"/>
            </t>
        </template>
        <template id="wujia_portal_layout.login_totp">
            <t t-call="wujia_portal_layout.login_container">
                <t t-call="wujia_portal_layout.login_2fa_form"/>
            </t>
        </template>
        <template id="wujia_portal_layout.forgot_pass">
            <t t-call="wujia_portal_layout.login_container">
                <t t-call="wujia_portal_layout.forgot_pass_form"/>
            </t>
        </template>
        <template id="wujia_portal_layout.reset_pass">
            <t t-call="wujia_portal_layout.login_container">
                <t t-call="wujia_portal_layout.reset_pass_form"/>
            </t>
        </template>
        <template id="wujia_portal_layout.signup">
            <t t-call="wujia_portal_layout.login_container">
                <t t-call="wujia_portal_layout.signup_form"/>
            </t>
        </template>
    </data>
</odoo>
