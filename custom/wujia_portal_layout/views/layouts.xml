<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <template id="layout" name="Basic layout">
            <html class="no-js" t-att-lang="request.env['ir.http']._wj_html_lang()">
                <head>
                    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
                    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui"/>
                    <meta t-if="description" name="description" t-att-content="description"/>
                    <meta t-if="keywords" name="keywords" t-att-content="keywords"/>
                    <meta name="author" content="Cloudmedia"/>
                    <title>
                        <t t-esc="title or 'Portal'"/>
                    </title>
                    <link rel="apple-touch-icon" t-attf-href="data:image/png;base64,{{env.company.logo or ''}}"/>
                    <link rel="shortcut icon" type="image/x-icon"
                          t-attf-href="data:image/png;base64,{{env.company.logo or ''}}"/>                    <t t-call="wujia_portal_layout.asset_frontend"/>
                    <t t-call-assets="web.assets_frontend" t-js="false" t-css="true"/>
                </head>
                <body class="vertical-layout  navbar-floating  vertical-menu-modern footer-static" data-open="click"
                      data-menu="vertical-menu-modern">
                    <t t-out="0"/>
                    <!-- WJ-ORD-002: shell này tự dựng <head> nên thiếu khối session info
                         chuẩn của Odoo. Không có nó `session.websocket_worker_version` =
                         undefined ⇒ bus worker nối /websocket?version=undefined và bị
                         server đóng ngay ("OUTDATED_VERSION", websocket.py:1119) ⇒ realtime
                         chết câm trên MỌI trang portal. Phải đặt TRƯỚC bundle JS. -->
                    <script type="text/javascript">
                        var odoo = odoo || {};
                        odoo.__session_info__ = <t t-out="json.dumps(request.env['ir.http'].get_frontend_session_info())"/>;
                    </script>
                    <t t-call="wujia_portal_layout.asset_frontend_js"/>
                    <t t-call-assets="web.assets_frontend" t-js="true" t-css="false"/>
                </body>
            </html>
        </template>

        <template id="layout_top_navbar">
            <nav class="header-navbar navbar-expand-lg navbar navbar-with-menu floating-nav navbar-light navbar-shadow wujia-navbar">
                <div class="navbar-wrapper">
                    <div class="navbar-container content">
                        <div class="navbar-collapse" id="navbar-mobile">
                            <div class="mr-auto float-left bookmark-wrapper d-flex align-items-center">
                                <ul class="nav navbar-nav">
                                    <!-- Sprint 10: logo Wujia trên navbar mobile (Figma) — sidebar
                                         (kèm logo) bị off-canvas <1200px nên thêm logo ở đây cho khớp.
                                         d-xl-none = chỉ mobile/tablet, desktop dùng logo sidebar. -->
                                    <li class="nav-item d-xl-none wujia-navbar-logo">
                                        <a class="navbar-brand p-0 m-0" href="/portal">
                                            <img t-attf-src="data:image/png;base64,{{env.company.logo_web}}"
                                                 alt="Wujia" class="wujia-navbar-logo-img"/>
                                        </a>
                                    </li>
                                    <li class="nav-item mobile-menu d-xl-none mr-auto">
                                        <button type="button" class="nav-link nav-menu-main menu-toggle hidden-xs wj-menu-toggle"
                                                aria-label="Mở menu" aria-controls="wj-main-menu" aria-expanded="false">
                                            <i class="ficon feather icon-menu" aria-hidden="true"/>
                                        </button>
                                    </li>
                                </ul>
                            </div>
                            <!-- wj-pc-navactions: neo cho khối CSS cụm B (_pc_account.css). Cart/bell
                                 do wujia_portal_sale + wujia_portal_notification chèn vào ul này. -->
                            <ul class="nav navbar-nav float-right wj-pc-navactions">
                                <li class="dropdown dropdown-language nav-item">
                                    <t t-set="wj_langs" t-value="request.env['ir.http']._wj_portal_langs()"/>
                                    <t t-set="wj_lang_cur" t-value="[l for l in wj_langs if l['current']][:1]"/>
                                    <a class="dropdown-toggle nav-link text-white" id="dropdown-flag" href="#"
                                       data-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                        <t t-foreach="wj_lang_cur" t-as="l">
                                            <i t-attf-class="flag-icon {{l['flag']}}"/>
                                            <span class="selected-language" t-out="l['label']"/>
                                        </t>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right" aria-labelledby="dropdown-flag">
                                        <a t-foreach="wj_langs" t-as="l" class="dropdown-item"
                                           t-attf-href="/portal/set-lang/{{l['code']}}"
                                           t-att-data-url_code="l['url_code']">
                                            <i t-attf-class="flag-icon {{l['flag']}}"/>
                                            <t t-out="l['label']"/>
                                        </a>
                                    </div>
                                </li>
                                <!-- Avatar dropdown — Figma wujia_pc_09_avatar_dropdown_v3.
                                     Active item suy từ request.httprequest.path. -->
                                <li class="dropdown dropdown-user nav-item">
                                    <a class="dropdown-toggle nav-link dropdown-user-link" href="#"
                                       data-toggle="dropdown" role="button" aria-label="Tài khoản"
                                       aria-haspopup="true" aria-expanded="false">
                                        <!-- UI-03 (cụm B): avatar đứng TRƯỚC tên theo source v1.5.
                                             Đảo DOM chứ không dùng `order` để thứ tự đọc màn hình
                                             khớp thứ tự nhìn thấy. -->
                                        <span>
                                            <img class="round" t-att-src="'/web/image/res.users/'+ str(request.env.user.id) +'/avatar_128'"
                                                 alt="avatar" height="36" width="36"/>
                                        </span>
                                        <div class="wj-pc-user-nav d-sm-flex d-none">
                                            <span class="wj-pc-user-nav__name" t-out="request.env.user.name"/>
                                            <!-- UI-03 (Sprint 34): role subtitle dưới tên. Role đã sẵn trong
                                                 scope (_wujia_active_role set bởi store-picker inherit trước
                                                 t-call navbar); CSS .wj-pc-user-nav__role có sẵn, chỉ thiếu HTML. -->
                                            <span class="wj-pc-user-nav__role" t-if="_wujia_active_role">
                                                <t t-if="_wujia_active_role == 'manager'">Manager</t>
                                                <t t-elif="_wujia_active_role == 'owner'">Owner</t>
                                                <t t-elif="_wujia_active_role == 'staff'">Staff</t>
                                            </span>
                                        </div>
                                        <i class="feather icon-chevron-down wj-pc-user-nav__chev"/>
                                    </a>
                                    <div class="dropdown-menu dropdown-menu-right wj-pc-acct-menu">
                                        <div class="wj-pc-acct-menu__head">
                                            <img class="wj-pc-acct-menu__avatar" alt="avatar"
                                                 t-att-src="'/web/image/res.users/'+ str(request.env.user.id) +'/avatar_128'"/>
                                            <div>
                                                <span class="wj-pc-acct-menu__name" t-out="request.env.user.name"/>
                                                <span class="wj-pc-acct-menu__sub"
                                                      t-out="request.env.user.partner_id.email or request.env.user.login"/>
                                            </div>
                                        </div>
                                        <div class="dropdown-divider"/>
                                        <t t-call="wujia_portal_layout.wj_acct_menu_items"/>
                                    </div>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
            </nav>
        </template>

        <template id="layout_sidenav">
            <!-- CMP-SN-001 (E8b): sidebar PC 264. ≥1200 cố định; 992–1199 drawer đóng mặc định
                 (wujia_sidebar.js); <992 không hiển thị (mobile dùng bottom-nav). -->
            <div class="main-menu menu-fixed menu-light menu-accordion menu-shadow wj-sidebar"
                 id="wj-main-menu" role="navigation" aria-label="Điều hướng chính"
                 data-scroll-to-active="true">
                <div class="navbar-header wj-sidebar__brand">
                    <a class="navbar-brand wj-sidebar__logo" href="/portal">
                        <img t-attf-src="data:image/png;base64,{{env.company.logo_web}}" alt="Wujia"/>
                    </a>
                    <button type="button" class="wj-sidebar__close" aria-label="Đóng menu">
                        <i class="feather icon-x" aria-hidden="true"/>
                    </button>
                </div>

                <div class="main-menu-content">
                    <!-- Khung chỉ giữ 3 tiêu đề nhóm + neo cuối `nav_end`; mục do module sở hữu
                         route chèn `before` neo của nhóm sau, thứ tự trong nhóm theo priority.
                         `_p` đặt một lần để mọi mục tự khai điều kiện sáng theo route của mình. -->
                    <t t-set="_p" t-value="request.httprequest.path or ''"/>
                    <ul class="navigation navigation-main" id="main-menu-navigation"
                        data-menu="menu-navigation">
                        <li class="navigation-header wujia-nav-header" id="nav_header_main"><span>Chức năng chính</span></li>
                        <li class="navigation-header wujia-nav-header" id="nav_header_finance"><span>Tài chính &amp; xử lý</span></li>
                        <li class="navigation-header wujia-nav-header" id="nav_header_ops"><span>Hỗ trợ vận hành</span></li>
                        <li class="wj-sidebar__end" id="nav_end" aria-hidden="true"/>
                        <t t-out="0"/>
                    </ul>
                </div>
            </div>
        </template>


        <template id="wujia_portal_layout.app_layout">
            <t t-call="wujia_portal_layout.layout">
                <t t-set="asset_menu" t-value="True"/>
                <t t-set="asset_menu" t-value="True"/>
                <t t-call="wujia_portal_layout.layout_top_navbar"/>
                <t t-call="wujia_portal_layout.layout_sidenav"/>
                <div class="app-content content">
                    <!-- Sprint 12: mobile shell header (BA FINAL v1) — first static block
                         at top of content on mobile (<992px). Vuexy floating navbar is
                         hidden <992px (_wujia_theme.css). Store strip is injected right
                         after header-navbar-shadow by wujia_portal_base → stacks below
                         this header. Desktop renders this hidden (d-lg-none). -->
                    <t t-call="wujia_portal_layout.mobile_header"/>
                    <div class="content-overlay"/>
                    <div class="header-navbar-shadow"/>
                    <!-- CMP-PC-001: một PageContainer cho mọi route. Route đặt công tắc bằng
                         t-set trong thân t-call:
                           pc_gutter='list'                  lề mobile 12 (LC-08)
                           pc_width='standard' | 'narrow'    bề rộng trong 1440 | 960 (mặc định fluid)
                           pc_bottom='sticky'                chừa đáy cho thanh hành động cố định -->
                    <main t-attf-class="wj-page-container #{'wj-page-container--list' if pc_gutter == 'list' else ''} #{'wj-page-container--' + pc_width if pc_width in ('standard', 'narrow') else ''} #{'wj-page-container--sticky' if pc_bottom == 'sticky' else ''}">
                        <t t-out="0"/>
                    </main>
                </div>
                <!-- Sprint 11 (item 10.1): shared bottom-nav portal-wide (mobile only). -->
                <t t-call="wujia_portal_layout.mobile_bottomnav"/>
                <div class="sidenav-overlay"/>
                <div class="drag-target"/>
                <!--                <t t-call="wujia_portal_layout.layout_footer"/>-->
            </t>
        </template>


        <template id="login_layout" name="Login layout">
            <html class="no-js" t-att-lang="request.env['ir.http']._wj_html_lang()">
                <head>
                    <meta http-equiv="Content-Type" content="text/html; charset=UTF-8"/>
                    <meta http-equiv="X-UA-Compatible" content="IE=edge"/>
                    <meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=0, minimal-ui"/>
                    <meta name="description"
                          content=""/>
                    <meta name="keywords"
                          content=""/>
                    <meta name="author" content="Cloudmedia"/>
                    <title>
                        <t t-esc="title or 'Portal'"/>
                    </title>
                    <link rel="apple-touch-icon" t-attf-src="data:image/png;base64,{{env.company.logo_web}}"/>
                    <link rel="shortcut icon" type="image/x-icon"
                          t-attf-src="data:image/png;base64,{{env.company.logo_web}}"/>                    <t t-call="wujia_portal_layout.asset_frontend"/>
                    <t t-call="wujia_portal_layout.asset_css_authentication"/>
                </head>
                <body class="vertical-layout vertical-menu-modern 1-column  navbar-floating footer-static bg-full-login  blank-page blank-page wj-auth-body"
                      data-open="click" data-menu="vertical-menu-modern" data-col="1-column">
                    <t t-out="0"/>
                    <t t-call="wujia_portal_layout.asset_frontend_js"/>
                </body>
            </html>
        </template>

        <template id="dashboard">
            <t t-call="wujia_portal_layout.layout">
                <t t-out="0"/>
            </t>
        </template>


    </data>
</odoo>