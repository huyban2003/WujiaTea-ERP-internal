<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- F5a — mục sidebar của màn do CHÍNH module sở hữu route khai; khung
         (wujia_portal_layout) chỉ giữ tiêu đề nhóm làm neo. Gỡ module này ⇒ mục biến mất. -->
    <template id="layout_sidenav_knowledge"
              inherit_id="wujia_portal_layout.layout_sidenav"
              priority="55"
              name="Wujia Sidenav — Kiến thức">
        <xpath expr="//li[@id='nav_header_utils']" position="before">
            <li t-attf-class="nav-item #{_p.startswith('/portal/knowledge') and 'active' or ''}" id="nav_item_knowledge">
                <t t-call="wujia_portal_layout.wj_nav_item">
                    <t t-set="ni_href" t-value="'/portal/knowledge'"/>
                    <t t-set="ni_icon" t-value="'feather icon-book'"/>
                    <t t-set="ni_label">Kiến thức</t>
                </t>
            </li>
        </xpath>
    </template>

</odoo>
